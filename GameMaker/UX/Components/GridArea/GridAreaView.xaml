<UserControl x:Class="GameMaker.UX.Components.GridArea.GridAreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:areas="using:GameLibrary.Models.Areas"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased">
        <ItemsControl ItemsSource="{x:Bind Hitboxes, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="{StaticResource DarkGreyBrush}"
                            Width="300" Height="300" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="areas:Hitbox">
                    <Rectangle Fill="Red"
                               Opacity="0.5"
                               Stroke="White"
                               StrokeThickness="1"
                               Width="{x:Bind Width, Mode=OneWay}"
                               Height="{x:Bind Height, Mode=OneWay}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="{x:Bind X, Mode=OneWay}"
                                                Y="{x:Bind Y, Mode=OneWay}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Preview Rectangle while drawing -->
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="PreviewRectangle"
                       Fill="LightBlue"
                       Opacity="0.3"
                       Stroke="White"
                       StrokeDashArray="2,2"
                       Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</UserControl>
