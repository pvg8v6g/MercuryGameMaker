<UserControl x:Class="GameMaker.UX.Components.GridArea.AreaCreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:spriteImage="using:GameMaker.UX.Components.SpriteImage"
             mc:Ignorable="d">
  <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <StackPanel Spacing="20">
      <engineTextBox:EngineTextBox Header="Grid Boxes"
                                   Text="{x:Bind GridSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   InputType="Integer" />

      <engineTextBox:EngineTextBox Header="Box Size"
                                   Text="{x:Bind BoxSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   InputType="Integer" />

      <CheckBox Content="Show Grid"
                IsChecked="{x:Bind ShowGrid, Mode=TwoWay}" />

      <Button Content="Clear All"
              HorizontalAlignment="Stretch"
              Click="OnClearAllClick" />
    </StackPanel>

    <Grid x:Name="RootGrid"
          Grid.Column="1"
          Background="{StaticResource DarkPinkBrush}"
          Width="{x:Bind InternalGridSize, Mode=OneWay}"
          Height="{x:Bind InternalGridSize, Mode=OneWay}"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased">
      <spriteImage:SpriteImage CharacterImage="{x:Bind CharacterImage}" />
    </Grid>
  </Grid>
</UserControl>
