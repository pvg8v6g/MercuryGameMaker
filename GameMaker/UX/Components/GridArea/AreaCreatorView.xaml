<UserControl x:Class="GameMaker.UX.Components.GridArea.AreaCreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:spriteImage="using:GameMaker.UX.Components.SpriteImage"
             xmlns:gridArea="using:GameMaker.UX.Components.GridArea"
             xmlns:areas="using:GameLibrary.Models.Areas"
             mc:Ignorable="d"
             Loaded="OnLoaded">
  <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <StackPanel Spacing="20" VerticalAlignment="Center">
      <engineTextBox:EngineTextBox Header="Grid Boxes"
                                   Text="{x:Bind State.GridSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   InputType="Integer" />

      <engineTextBox:EngineTextBox Header="Box Size"
                                   Text="{x:Bind State.BoxSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   InputType="Integer" />

      <CheckBox Content="Show Grid"
                IsChecked="{x:Bind State.ShowGrid, Mode=TwoWay}" />

      <Button Content="Clear All"
              HorizontalAlignment="Stretch"
              Click="OnClearAllClicked" />
    </StackPanel>

    <Grid x:Name="RootGrid"
          Grid.Column="1"
          Background="{StaticResource DarkGreyBrush}"
          Width="{x:Bind State.InternalGridSize, Mode=OneWay}"
          Height="{x:Bind State.InternalGridSize, Mode=OneWay}"
          PointerPressed="OnRootGridPointerPressed"
          PointerMoved="OnRootGridPointerMoved"
          PointerReleased="OnRootGridPointerReleased">

      <!-- Sprite -->
      <Canvas Width="{Binding ElementName=RootGrid, Path=Width}"
              Height="{Binding ElementName=RootGrid, Path=Height}"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
        <spriteImage:SpriteImage CharacterImage="{x:Bind CharacterImage, Mode=OneWay}"
                                 Canvas.Left="{x:Bind State.AnchorPosition.X, FallbackValue='0', Mode=OneWay}"
                                 Canvas.Top="{x:Bind State.AnchorPosition.Y, FallbackValue='0', Mode=OneWay}" />
      </Canvas>

      <!-- Hitboxes -->
      <ItemsControl ItemsSource="{x:Bind Hitboxes, Mode=OneWay}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{x:Bind OffsetX}" />
            <Setter Property="Canvas.Top" Value="{x:Bind OffsetY}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas Width="{Binding ElementName=RootGrid, Path=Width}"
                    Height="{Binding ElementName=RootGrid, Path=Height}"
                    Background="Green" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="areas:Area">
            <Rectangle Fill="Red"
                       Opacity="0.5"
                       Stroke="White"
                       StrokeThickness="1"
                       Width="{x:Bind Width, Mode=OneWay}"
                       Height="{x:Bind Height, Mode=OneWay}"
                       PointerPressed="OnHitboxPointerPressed" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Grid Overlay -->
      <ItemsControl ItemsSource="{x:Bind State.GridLines, Mode=OneWay}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind State.ShowGrid, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas Width="{Binding ElementName=RootGrid, Path=Width}"
                    Height="{Binding ElementName=RootGrid, Path=Height}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="gridArea:GridLine">
            <Line X1="{x:Bind X1}"
                  Y1="{x:Bind Y1}"
                  X2="{x:Bind X2}"
                  Y2="{x:Bind Y2}"
                  Stroke="{StaticResource MediumGreyBrush}"
                  StrokeThickness="0.5" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Canvas IsHitTestVisible="False">
        <Rectangle Fill="LightBlue"
                   Opacity="0.3"
                   Stroke="White"
                   StrokeDashArray="2,2"
                   Visibility="{x:Bind State.ShowPreview, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Canvas.Left="{x:Bind State.PreviewPosition.X, FallbackValue='0', Mode=OneWay}"
                   Canvas.Top="{x:Bind State.PreviewPosition.Y, FallbackValue='0', Mode=OneWay}"
                   Width="{x:Bind State.PreviewPosition.Width, FallbackValue='0', Mode=OneWay}"
                   Height="{x:Bind State.PreviewPosition.Height, FallbackValue='0', Mode=OneWay}" />
      </Canvas>
    </Grid>
  </Grid>
</UserControl>
