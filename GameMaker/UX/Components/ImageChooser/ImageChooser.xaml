<UserControl x:Class="GameMaker.UX.Components.ImageChooser.ImageChooser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="using:GameLibrary.Behaviors"
             xmlns:imageChooser="using:GameMaker.UX.Components.ImageChooser"
             mc:Ignorable="d"
             behaviors:PointerCursorBehavior.CursorType="Hand"
             MinWidth="{x:Bind ChooserWidth, Mode=OneWay}"
             MaxWidth="{x:Bind ChooserWidth, Mode=OneWay}"
             MinHeight="{x:Bind ChooserHeight, Mode=OneWay}"
             MaxHeight="{x:Bind ChooserHeight, Mode=OneWay}">
    <Grid x:Name="RootGrid" Tapped="OnTapped" Background="Transparent" DataContext="{x:Bind CroppedImage}">
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="ImageFlyout">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MaxWidth" Value="1000" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <Grid ColumnDefinitions="200, Auto, *">
                    <!-- Left: File List -->
                    <ListView x:Name="FileListView"
                              Grid.Column="0"
                              SelectionChanged="FileListView_OnSelectionChanged"
                              MaxHeight="500">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" VerticalAlignment="Center" Margin="5" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <AppBarSeparator Grid.Column="1" Margin="5,0" />

                    <!-- Right: Image Grid -->
                    <ScrollViewer x:Name="ImageScrollViewer"
                                  Grid.Column="2"
                                  MaxHeight="500"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,16,0">
                        <Grid x:Name="ImageContainer"
                              PointerMoved="ImageContainer_OnPointerMoved"
                              PointerExited="ImageContainer_OnPointerExited"
                              Tapped="FullImage_OnTapped"
                              behaviors:PointerCursorBehavior.CursorType="Hand">
                            <Image x:Name="FullImage" Stretch="None" />
                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                                <Border x:Name="HoverBorder"
                                        BorderBrush="{StaticResource LightYellowBrush}"
                                        BorderThickness="2"
                                        Visibility="Collapsed" />
                                <Border x:Name="SelectedBorder"
                                        BorderBrush="{StaticResource MediumPinkBrush}"
                                        BorderThickness="2"
                                        Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Flyout>
        </FlyoutBase.AttachedFlyout>

        <Border Background="{StaticResource MediumGreenBrush}"
                BorderBrush="{StaticResource DarkBlueBrush}"
                BorderThickness="2"
                CornerRadius="4"
                Width="{x:Bind ChooserWidth, Mode=OneWay}"
                Height="{x:Bind ChooserHeight, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Canvas Width="{Binding Rect, Converter={StaticResource RectWidthConverter}}"
                    Height="{Binding Rect, Converter={StaticResource RectHeightConverter}}"
                    Visibility="{Binding Rect, Converter={StaticResource NullToCollapsedConverter}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Canvas.Clip>
                    <RectangleGeometry Rect="{Binding Rect, Converter={StaticResource RectNormalizedConverter}}" />
                </Canvas.Clip>
                <Image Source="{Binding ImageSource}"
                       Canvas.Left="{Binding Rect, Converter={StaticResource RectNegativeXConverter}}"
                       Canvas.Top="{Binding Rect, Converter={StaticResource RectNegativeYConverter}}" />
            </Canvas>
        </Border>
    </Grid>
</UserControl>
