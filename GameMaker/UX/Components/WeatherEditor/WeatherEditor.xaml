<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GameMaker.UX.Components.WeatherEditor.WeatherEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <!-- rain, snow or ash: how much falls and how, the sky under it, its color and its sound -->
  <StackPanel Spacing="10">
    <ComboBox Header="Weather"
              HorizontalAlignment="Stretch"
              ItemsSource="{x:Bind Model.Types, Mode=OneWay}"
              SelectedItem="{x:Bind Model.Type, Mode=TwoWay}"
              ToolTipService.ToolTip="Rain and snow don't show on interior maps (their sound carries on, muffled). Ash drifts in anywhere." />
    <StackPanel Spacing="10"
                Visibility="{x:Bind Model.HasWeather, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
      <Grid ColumnSpacing="10"
            RowSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <NumberBox Header="Amount"
                   Minimum="0"
                   SmallChange="1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Amount, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="How many particles in every 100 x 100 pixels. Light rain is about 4, a downpour 15." />
        <NumberBox Grid.Column="1"
                   Header="Speed"
                   Minimum="0"
                   SmallChange="0.1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Speed, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="How fast it falls, 1 is normal." />
        <NumberBox Grid.Row="1"
                   Header="Wind"
                   SmallChange="10"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Wind, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="Pixels a second it's blown sideways, negative blows it left." />
        <NumberBox Grid.Row="1"
                   Grid.Column="1"
                   Header="Size"
                   Minimum="0.1"
                   SmallChange="0.1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Size, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="How big the particles are, 1 is normal." />
        <NumberBox Grid.Row="2"
                   Header="Opacity"
                   Minimum="0"
                   Maximum="1"
                   SmallChange="0.05"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Opacity, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="How solid the particles are at most, 0 to 1." />
        <NumberBox Grid.Row="2"
                   Grid.Column="1"
                   Header="Overcast"
                   Minimum="0"
                   Maximum="1"
                   SmallChange="0.05"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Overcast, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="How much the sky darkens under it, 0 to 1. A storm is about 0.4." />
      </Grid>
      <CheckBox Content="Splashes"
                IsChecked="{x:Bind Model.Settings.Splashes, Mode=TwoWay, FallbackValue=False}"
                Visibility="{x:Bind Model.IsRain, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                ToolTipService.ToolTip="Rain splashes on the ground." />
      <!-- rain's lightning: a flash now and then, thunder following -->
      <StackPanel Spacing="10"
                  Visibility="{x:Bind Model.IsRain, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
        <CheckBox Content="Lightning"
                  IsChecked="{x:Bind Model.Lightning, Mode=TwoWay, FallbackValue=False}"
                  ToolTipService.ToolTip="The sky flashes now and then, thunder following a moment later. Indoors there's no flash, the thunder is muffled." />
        <StackPanel Spacing="10"
                    Visibility="{x:Bind Model.Lightning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox Header="Every (seconds)"
                       Minimum="1"
                       SmallChange="1"
                       SpinButtonPlacementMode="Inline"
                       Value="{x:Bind Model.Settings.LightningInterval, Mode=TwoWay, FallbackValue=10}"
                       ToolTipService.ToolTip="About how long between strikes. Each one comes a little sooner or later." />
            <NumberBox Grid.Column="1"
                       Header="Brightness"
                       Minimum="0"
                       Maximum="1"
                       SmallChange="0.05"
                       SpinButtonPlacementMode="Inline"
                       Value="{x:Bind Model.Settings.LightningBrightness, Mode=TwoWay, FallbackValue=0.7}"
                       ToolTipService.ToolTip="How bright a flash is, 0 to 1." />
          </Grid>
          <ComboBox Header="Thunder"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind Model.ThunderFiles, Mode=OneWay}"
                    SelectedItem="{x:Bind Model.SelectedThunder, Mode=TwoWay}"
                    ToolTipService.ToolTip="Plays after each flash, from the SFX folder. It comes a quarter of a second to two seconds behind, a far one quieter." />
          <Grid ColumnSpacing="10"
                Visibility="{x:Bind Model.HasThunder, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox Header="Thunder Volume"
                       Minimum="0"
                       Maximum="1"
                       SmallChange="0.1"
                       SpinButtonPlacementMode="Inline"
                       Value="{x:Bind Model.Settings.Thunder.Volume, Mode=TwoWay, FallbackValue=1}" />
            <NumberBox Grid.Column="1"
                       Header="Thunder Pitch"
                       Minimum="0.1"
                       SmallChange="0.1"
                       SpinButtonPlacementMode="Inline"
                       Value="{x:Bind Model.Settings.Thunder.Pitch, Mode=TwoWay, FallbackValue=1}" />
          </Grid>
        </StackPanel>
      </StackPanel>
      <NumberBox Header="Embers"
                 Minimum="0"
                 Maximum="1"
                 SmallChange="0.05"
                 SpinButtonPlacementMode="Inline"
                 Visibility="{x:Bind Model.IsAsh, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                 Value="{x:Bind Model.Settings.Embers, Mode=TwoWay, FallbackValue=0}"
                 ToolTipService.ToolTip="The share of the ash that's glowing embers rising, 0 to 1." />
      <StackPanel Orientation="Horizontal"
                  Spacing="10">
        <DropDownButton Content="Color"
                        ToolTipService.ToolTip="The particles' color. Default is the weather's own.">
          <DropDownButton.Flyout>
            <Flyout Placement="Bottom">
              <ColorPicker IsAlphaEnabled="False"
                           IsMoreButtonVisible="True"
                           IsColorSliderVisible="True"
                           IsHexInputVisible="True"
                           Color="{x:Bind Model.PickerColor, Mode=TwoWay}" />
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Content="Default Color"
                Command="{x:Bind Model.DefaultColorCommand, Mode=OneWay}" />
      </StackPanel>
      <ComboBox Header="Sound"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind Model.SoundFiles, Mode=OneWay}"
                SelectedItem="{x:Bind Model.SelectedSound, Mode=TwoWay}"
                ToolTipService.ToolTip="Loops while the weather lasts, from the BGS folder. It plays next to the map's ambience, muffled when heard from indoors." />
      <Grid ColumnSpacing="10"
            Visibility="{x:Bind Model.HasSound, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <NumberBox Header="Volume"
                   Minimum="0"
                   Maximum="1"
                   SmallChange="0.1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Sound.Volume, Mode=TwoWay, FallbackValue=1}" />
        <NumberBox Grid.Column="1"
                   Header="Pitch"
                   Minimum="0.1"
                   SmallChange="0.1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind Model.Settings.Sound.Pitch, Mode=TwoWay, FallbackValue=1}" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
