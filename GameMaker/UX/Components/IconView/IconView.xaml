<UserControl x:Class="GameMaker.UX.Components.IconView.IconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:componentModels="using:GameLibrary.Utilities.ComponentModels"
             mc:Ignorable="d"
             MinWidth="48"
             MaxWidth="48"
             MinHeight="48"
             MaxHeight="48"
             d:DataContext="{d:DesignInstance componentModels:CroppedImage}">
  <Grid>
    <Border Background="{StaticResource MediumGreenBrush}"
            BorderBrush="{StaticResource DarkBlueBrush}"
            BorderThickness="2"
            CornerRadius="4">
      <Canvas Width="{Binding Rect, Converter={StaticResource RectWidthConverter}}"
              Height="{Binding Rect, Converter={StaticResource RectHeightConverter}}"
              Visibility="{Binding Rect, Converter={StaticResource NullToCollapsedConverter}}">
        <Canvas.Clip>
          <RectangleGeometry Rect="{Binding Rect, Converter={StaticResource RectNormalizedConverter}}" />
        </Canvas.Clip>
        <Image Source="{Binding ImageSource}"
               Canvas.Left="{Binding Rect, Converter={StaticResource RectNegativeXConverter}}"
               Canvas.Top="{Binding Rect, Converter={StaticResource RectNegativeYConverter}}" />
      </Canvas>
    </Border>
  </Grid>
</UserControl>
