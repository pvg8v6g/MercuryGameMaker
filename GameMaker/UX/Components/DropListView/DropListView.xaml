<UserControl x:Class="GameMaker.UX.Components.DropListView.DropListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="using:GameLibrary.Behaviors"
             xmlns:dropListView="using:GameMaker.UX.Components.DropListView"
             xmlns:engineIcon="using:GameMaker.UX.Components.EngineIcon"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:items="using:GameLibrary.Models.Items"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <UserControl.Resources>
    <Flyout x:Name="EditorFlyout">
      <StackPanel x:Name="EditorRoot"
                  Width="240"
                  Spacing="12">
        <!-- No dropdown here: a ComboBox opens a popup inside this flyout, and WinUI crashed on that popup while it
             was scrolled or closed ("Child collection must not be modified during measure or arrange"). The items
             sit in a plain list with a search box instead, all at a fixed size, so nothing pops up or resizes. -->
        <StackPanel Spacing="8">
          <TextBlock Text="Item" />
          <TextBox PlaceholderText="Search items"
                   MinWidth="0"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <ListView ItemsSource="{Binding FilteredItems, Mode=OneWay}"
                    SelectedItem="{Binding PickedItem, Mode=TwoWay}"
                    SelectionMode="Single"
                    Height="240"
                    Background="{StaticResource MediumGreyBrush}">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="items:Item">
                <StackPanel Orientation="Horizontal" Spacing="10" Height="36">
                  <engineIcon:EngineIcon Icon="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <!-- the picked item stays shown here even when a search hides it from the list -->
          <StackPanel Orientation="Horizontal" Spacing="10" Height="36">
            <TextBlock Text="Picked:" VerticalAlignment="Center" />
            <engineIcon:EngineIcon Icon="{Binding PickedItem.Icon, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PickedItem.Name, Mode=OneWay, FallbackValue=None, TargetNullValue=None}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <engineTextBox:EngineTextBox Header="Chance %"
                                     InputType="Integer"
                                     Text="{Binding PercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="The percent chance this item drops." />

        <Button Content="Save"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanSave, Mode=OneWay}"
                behaviors:PointerCursorBehavior.CursorType="Hand"
                HorizontalAlignment="Right" />
      </StackPanel>
    </Flyout>
  </UserControl.Resources>

  <ListView x:Name="ListView"
            ItemsSource="{x:Bind Rows, Mode=OneWay}"
            SelectionMode="Single"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource MediumGreyBrush}">
    <ListView.ItemTemplate>
      <DataTemplate x:DataType="dropListView:DropRowModel">
        <Grid ColumnSpacing="10" Padding="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <engineIcon:EngineIcon Grid.Column="0"
                                 Icon="{x:Bind Icon, Mode=OneWay}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

          <TextBlock Grid.Column="1"
                     Text="{x:Bind Name, Mode=OneWay}"
                     VerticalAlignment="Center"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />

          <TextBlock Grid.Column="2"
                     Text="{x:Bind PercentDisplay, Mode=OneWay}"
                     VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>
    </ListView.ItemTemplate>
    <ListView.ContextFlyout>
      <MenuFlyout>
        <MenuFlyoutItem Text="New" Command="{x:Bind NewCommand}">
          <MenuFlyoutItem.Icon>
            <SymbolIcon Symbol="Add" />
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Edit" Command="{x:Bind EditCommand}"
                        behaviors:ListViewBehaviors.RequireSelectionForMenuFlyoutItem="True">
          <MenuFlyoutItem.Icon>
            <SymbolIcon Symbol="Edit" />
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Delete" Command="{x:Bind DeleteCommand}"
                        behaviors:ListViewBehaviors.RequireSelectionForMenuFlyoutItem="True">
          <MenuFlyoutItem.Icon>
            <SymbolIcon Symbol="Delete" />
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
      </MenuFlyout>
    </ListView.ContextFlyout>
  </ListView>
</UserControl>
