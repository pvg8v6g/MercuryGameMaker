<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:GameLibrary.Converters">
  <!-- Converters -->
  <converters:NullToVisibilityConverter x:Key="NullToCollapsedConverter" Invert="False" />
  <converters:NullToVisibilityConverter x:Key="NullToVisibleConverter" Invert="True" />
  <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" Invert="False" />
  <converters:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />

  <!-- the column on each data page that holds the description box: wider than the other star columns.
       Change it here and every page follows -->
  <GridLength x:Key="DescriptionColumnWidth">1.8*</GridLength>

  <!-- the widest a description box grows (it wraps inside this; the panels scroll sideways, so it needs a limit) -->
  <x:Double x:Key="DescriptionMaxWidth">640</x:Double>

  <!-- the small arrow that folds a side panel away and brings it back -->
  <Style x:Key="PanelFoldButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- a tool on the map editor's tool rail: a radio button drawn as an icon button, the picked tool is highlighted
       with a bar down its left side. It's as wide as its content, so the rail narrows when the names are hidden -->
  <Style x:Key="ToolRailButtonStyle" TargetType="RadioButton">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root"
                Background="Transparent"
                CornerRadius="6">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="0.6" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Picked.Opacity" Value="1" />
                    <Setter Target="Indicator.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Picked"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6"
                    Opacity="0" />
            <Border x:Name="Hover"
                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                    CornerRadius="6"
                    Opacity="0" />
            <Rectangle x:Name="Indicator"
                       Width="3"
                       Height="24"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       RadiusX="1.5"
                       RadiusY="1.5"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}"
                       Opacity="0" />
            <ContentPresenter Margin="10,6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a drop down item that shows an enum value by its Display name -->
  <DataTemplate x:Key="EnumDisplayNameTemplate">
    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
  </DataTemplate>
  <converters:NullToBooleanConverter x:Key="NullToFalseConverter" Invert="False" />
  <converters:NullToBooleanConverter x:Key="NullToTrueConverter" Invert="True" />
  <converters:RectPropertyConverter x:Key="RectWidthConverter" PropertyToExtract="Width" />
  <converters:RectPropertyConverter x:Key="RectHeightConverter" PropertyToExtract="Height" />
  <converters:RectPropertyConverter x:Key="RectValueConverter" PropertyToExtract="Rect" />
  <converters:RectPropertyConverter x:Key="RectXConverter" PropertyToExtract="X" />
  <converters:RectPropertyConverter x:Key="RectYConverter" PropertyToExtract="Y" />
  <converters:RectPropertyConverter x:Key="RectNegativeXConverter" PropertyToExtract="NegativeX" />
  <converters:RectPropertyConverter x:Key="RectNegativeYConverter" PropertyToExtract="NegativeY" />
  <converters:RectPropertyConverter x:Key="RectNormalizedConverter" PropertyToExtract="NormalizedRect" />
  <converters:NegateConverter x:Key="NegateConverter" />
  <converters:InputTypeToInputScopeConverter x:Key="InputTypeToInputScopeConverter" />
  <converters:GuidToNoneConverter x:Key="GuidToNoneConverter" />
  <converters:NullToInvalidIndexConverter x:Key="NullToInvalidIndexConverter" />
  <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
  <converters:NullableGuidToStringConverter x:Key="NullableGuidToStringConverter" />

  <Color x:Key="WhiteColor">#FBFBFB</Color>
  <Color x:Key="BlackColor">#050505</Color>
  <Color x:Key="DarkGreyColor">#464646</Color>
  <Color x:Key="MediumGreyColor">#868686</Color>
  <Color x:Key="LightGreyColor">#DADADA</Color>
  <Color x:Key="RedColor">#AB0908</Color>
  <Color x:Key="LightBlueColor">#57DCF1</Color>
  <Color x:Key="LightYellowColor">#FBEDAF</Color>
  <Color x:Key="DarkBlueColor">#4b2f92</Color>
  <Color x:Key="MediumGreenColor">#288830</Color>

  <Color x:Key="PrimaryColor">#373737</Color>
  <Color x:Key="SecondaryColor">#5E5E5E</Color>
  <Color x:Key="TertiaryColor">#CBCBCB</Color>

  <Color x:Key="DarkPinkColor">#630322</Color>
  <Color x:Key="MediumPinkColor">#e70756</Color>
  <Color x:Key="MediumPinkHoverColor">#d60761</Color>
  <Color x:Key="MediumPinkPressedColor">#c10760</Color>
  <Color x:Key="LightPinkColor">#f18eaf</Color>

  <SolidColorBrush x:Key="WhiteBrush"
                   Color="{StaticResource WhiteColor}" />
  <SolidColorBrush x:Key="BlackBrush"
                   Color="{StaticResource BlackColor}" />
  <SolidColorBrush x:Key="DarkGreyBrush"
                   Color="{StaticResource DarkGreyColor}" />
  <SolidColorBrush x:Key="MediumGreyBrush"
                   Color="{StaticResource MediumGreyColor}" />
  <SolidColorBrush x:Key="LightGreyBrush"
                   Color="{StaticResource LightGreyColor}" />
  <SolidColorBrush x:Key="LightBlueBrush"
                   Color="{StaticResource LightBlueColor}" />
  <SolidColorBrush x:Key="LightYellowBrush"
                   Color="{StaticResource LightYellowColor}" />
  <SolidColorBrush x:Key="DarkBlueBrush"
                   Color="{StaticResource DarkBlueColor}" />
  <SolidColorBrush x:Key="MediumGreenBrush"
                   Color="{StaticResource MediumGreenColor}" />
  <SolidColorBrush x:Key="RedBrush"
                   Color="{StaticResource RedColor}" />
  <SolidColorBrush x:Key="DarkPinkBrush"
                   Color="{StaticResource DarkPinkColor}" />
  <SolidColorBrush x:Key="MediumPinkBrush"
                   Color="{StaticResource MediumPinkColor}" />
  <SolidColorBrush x:Key="MediumPinkHoverBrush"
                   Color="{StaticResource MediumPinkHoverColor}" />
  <SolidColorBrush x:Key="MediumPinkPressedBrush"
                   Color="{StaticResource MediumPinkPressedColor}" />
  <SolidColorBrush x:Key="LightPinkBrush"
                   Color="{StaticResource LightPinkColor}" />
  <SolidColorBrush x:Key="PrimaryBrush"
                   Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="SecondaryBrush"
                   Color="{StaticResource SecondaryColor}" />
  <SolidColorBrush x:Key="TertiaryBrush"
                   Color="{StaticResource TertiaryColor}" />
  <FontFamily x:Key="PrimaryFont">Calibri</FontFamily>
  <FontFamily x:Key="TitleFont">Forte</FontFamily>
  <x:Double x:Key="PrimaryFontSize">16</x:Double>
  <x:Double x:Key="TitleFontSize">26</x:Double>
  <x:Double x:Key="SmallIconSize">16</x:Double>
  <x:Double x:Key="IconSize">20</x:Double>
</ResourceDictionary>
