<Page x:Class="GameMaker.UX.Views.TermsPage.TermsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:termsPage="using:GameMaker.UX.ViewModels.TermsPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:enums="using:GameLibrary.Enumerations"
      xmlns:extensions="using:GameLibrary.MarkupExtensions"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:iconView="using:GameMaker.UX.Components.IconView"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance termsPage:TermsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10"
        RowSpacing="10"
        Padding="5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- what the game calls Life, Mana and money, and the icon shown for each -->
    <enginePanel:EnginePanel Grid.Row="0"
                             Grid.Column="0"
                             Grid.RowSpan="2"
                             Title="Terms">
      <Grid ColumnSpacing="20"
            RowSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Spacing="5"
                    VerticalAlignment="Bottom">
          <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
          <iconView:IconView Icon="{x:Bind ViewModel.Settings.LifeIcon, Mode=TwoWay}"
                             HorizontalAlignment="Center" />
        </StackPanel>
        <engineTextBox:EngineTextBox Grid.Row="0"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Header="Life"
                                     Text="{x:Bind ViewModel.Settings.LifeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="What the game calls Life, for example HP or Health." />

        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Spacing="5"
                    VerticalAlignment="Bottom">
          <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
          <iconView:IconView Icon="{x:Bind ViewModel.Settings.ManaIcon, Mode=TwoWay}"
                             HorizontalAlignment="Center" />
        </StackPanel>
        <engineTextBox:EngineTextBox Grid.Row="1"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Header="Mana"
                                     Text="{x:Bind ViewModel.Settings.ManaName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="What the game calls Mana, for example MP or Magic." />

        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Spacing="5"
                    VerticalAlignment="Bottom">
          <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
          <iconView:IconView Icon="{x:Bind ViewModel.Settings.MoneyIcon, Mode=TwoWay}"
                             HorizontalAlignment="Center" />
        </StackPanel>
        <engineTextBox:EngineTextBox Grid.Row="2"
                                     Grid.Column="1"
                                     VerticalAlignment="Bottom"
                                     Header="Money"
                                     Text="{x:Bind ViewModel.Settings.MoneyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="What the game calls money, for example Gold or Crowns. Its icon shows on money an enemy drops." />
      </Grid>
    </enginePanel:EnginePanel>

    <!-- the sound effect the victory screen plays when it opens -->
    <enginePanel:EnginePanel Grid.Row="0"
                             Grid.Column="1"
                             Title="Victory">
      <StackPanel Spacing="10"
                  Width="300">
        <ComboBox Header="Victory SFX"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.SfxFiles, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedVictorySfx, Mode=TwoWay}"
                  ToolTipService.ToolTip="The short sound effect (a file in Media\SFX) that plays when the victory screen opens after a won battle. The screen goes away when it ends." />

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox Grid.Column="0"
                     Header="Volume"
                     Minimum="0"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline"
                     IsEnabled="{x:Bind ViewModel.IsVictorySfxSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.VictorySfxVolume, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Header="Pitch"
                     Minimum="0"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline"
                     IsEnabled="{x:Bind ViewModel.IsVictorySfxSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.VictorySfxPitch, Mode=TwoWay}" />
        </Grid>

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Content="Play"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.PlayVictorySfxCommand}" />
          <Button Grid.Column="1"
                  Content="Stop"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.StopSfxCommand}" />
        </Grid>
      </StackPanel>
    </enginePanel:EnginePanel>

    <!-- what losing a battle does, and the sound effect the game over screen plays when it opens -->
    <enginePanel:EnginePanel Grid.Row="1"
                             Grid.Column="1"
                             Title="Defeat">
      <StackPanel Spacing="10"
                  Width="300">
        <ComboBox Header="When the Party Is Defeated"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{extensions:EnumValues EnumType=enums:DefeatOutcome}"
                  SelectedItem="{x:Bind ViewModel.Defeat, Mode=TwoWay}"
                  ToolTipService.ToolTip="Game Over: the game is over and goes back to the title or the last save. Retry: the same battle is fought again from the start. A battle whose troop is marked Can Lose is never a game over, the story just carries on." />

        <ComboBox Header="Defeat SFX"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.SfxFiles, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedDefeatSfx, Mode=TwoWay}"
                  ToolTipService.ToolTip="The short sound effect (a file in Media\SFX) that plays when the Game Over screen opens after a lost battle." />

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox Grid.Column="0"
                     Header="Volume"
                     Minimum="0"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline"
                     IsEnabled="{x:Bind ViewModel.IsDefeatSfxSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.DefeatSfxVolume, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Header="Pitch"
                     Minimum="0"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline"
                     IsEnabled="{x:Bind ViewModel.IsDefeatSfxSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.DefeatSfxPitch, Mode=TwoWay}" />
        </Grid>

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Content="Play"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.PlayDefeatSfxCommand}" />
          <Button Grid.Column="1"
                  Content="Stop"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.StopSfxCommand}" />
        </Grid>
      </StackPanel>
    </enginePanel:EnginePanel>

    <!-- the volume and pitch a new sound starts with -->
    <enginePanel:EnginePanel Grid.Row="0"
                             Grid.Column="2"
                             Title="Sound">
      <StackPanel Spacing="10"
                  Width="200">
        <NumberBox Header="Default Volume"
                   Minimum="0"
                   Maximum="1"
                   SmallChange="0.1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind ViewModel.Settings.DefaultVolume, Mode=TwoWay}"
                   ToolTipService.ToolTip="The volume a new sound starts with, from 0 to 1. Every sound effect, music track and the like that you add starts here. Sounds already set keep their own." />
        <NumberBox Header="Default Pitch"
                   Minimum="0.1"
                   Maximum="4"
                   SmallChange="0.1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind ViewModel.Settings.DefaultPitch, Mode=TwoWay}"
                   ToolTipService.ToolTip="The pitch a new sound starts with, 1 is normal. Sounds already set keep their own." />
      </StackPanel>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
