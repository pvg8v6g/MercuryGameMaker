<Page x:Class="GameMaker.UX.Views.TroopsPage.TroopsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:troopsPage="using:GameMaker.UX.ViewModels.TroopsPage"
      xmlns:troopsPageModels="using:GameMaker.UX.Models.TroopsPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:troopArena="using:GameMaker.UX.Components.TroopArena"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance troopsPage:TroopsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" RowSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="350" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <engineListView:EngineListView Grid.RowSpan="2"
                                   ItemsSource="{x:Bind ViewModel.GameDataService.Troops}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Troop"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />

    <!-- Troop Settings -->
    <enginePanel:EnginePanel Grid.Row="0"
                             Grid.Column="1"
                             Title="Troop Settings"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Spacing="15">
        <TextBox Header="Name"
                 Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                 ToolTipService.ToolTip="What is this troop called?" />

        <CheckBox IsChecked="{x:Bind ViewModel.SelectedEntity.CanLose, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  ToolTipService.ToolTip="Can the party lose this battle without a game over?">
          Can Lose
        </CheckBox>

        <CheckBox IsChecked="{x:Bind ViewModel.SelectedEntity.CanRun, Mode=TwoWay, FallbackValue='True', UpdateSourceTrigger=PropertyChanged}"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  ToolTipService.ToolTip="Can the party run from this battle? Turn off for bosses and scripted fights.">
          Can Run
        </CheckBox>

        <ComboBox Header="Battle Music"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.BgmFiles, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedBgm, Mode=TwoWay}"
                  ToolTipService.ToolTip="Optional music that plays during this battle." />

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox Grid.Column="0"
                     Header="Volume"
                     Minimum="0"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline"
                     IsEnabled="{x:Bind ViewModel.IsBgmSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.BgmVolume, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Header="Pitch"
                     Minimum="0"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline"
                     IsEnabled="{x:Bind ViewModel.IsBgmSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.BgmPitch, Mode=TwoWay}" />
        </Grid>

        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Content="Play"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.PlayBgmCommand}" />
          <Button Grid.Column="1"
                  Content="Stop"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.StopBgmCommand}" />
        </Grid>
      </StackPanel>
    </enginePanel:EnginePanel>

    <!-- Troop Enemies -->
    <enginePanel:EnginePanel x:Name="EnemiesPanel"
                             Grid.Row="1"
                             Grid.Column="1"
                             Title="Enemies"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.TroopEnemies}"
                                     SelectedIndex="{x:Bind ViewModel.SelectedTroopEnemyIndex, Mode=TwoWay}"
                                     NewOptions="{x:Bind ViewModel.EnemyNewOptions, Mode=OneWay}"
                                     CopyCommand="{x:Bind ViewModel.CopyEnemyCommand}"
                                     PasteCommand="{x:Bind ViewModel.PasteEnemyCommand}"
                                     DeleteCommand="{x:Bind ViewModel.DeleteEnemyCommand}"
                                     CopiedModel="{x:Bind ViewModel.CopiedTroopEnemy, Mode=OneWay}"
                                     MinHeight="200"
                                     Height="{x:Bind EnemiesPanel.ScrollerViewportHeight, Mode=OneWay}"
                                     ToolTipService.ToolTip="Right-click and choose Add to pick an enemy for this troop. Select an enemy, then left-click the battle arena to place it. Right-click an enemy in the arena to select it.">
        <engineListView:EngineListView.ItemTemplate>
          <DataTemplate x:DataType="troopsPageModels:TroopEnemyModel">
            <Grid ColumnSpacing="10" Padding="0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{x:Bind Name}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{x:Bind PositionText, Mode=OneWay}"
                         Foreground="{StaticResource LightGreyBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </engineListView:EngineListView.ItemTemplate>
      </engineListView:EngineListView>
    </enginePanel:EnginePanel>

    <!-- Battle Arena -->
    <enginePanel:EnginePanel Grid.Row="0"
                             Grid.RowSpan="2"
                             Grid.Column="2"
                             Title="Battle Arena"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Spacing="15">
        <StackPanel Orientation="Horizontal" Spacing="15">
          <engineTextBox:EngineTextBox Header="Arena Tiles"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.ArenaTiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="How many 48x48 tiles wide and tall the arena is." />
          <engineTextBox:EngineTextBox Header="Block Size"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.BlockSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="Placement snapping in pixels. Smaller blocks allow finer placement." />
          <ComboBox Header="Background"
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.BackgroundFiles, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedBackground, Mode=TwoWay}"
                    ToolTipService.ToolTip="A ground image from Graphics\Maps\Ground to place the enemies against." />
          <CheckBox Content="Show Grid"
                    VerticalAlignment="Bottom"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}" />
        </StackPanel>

        <troopArena:TroopArena Enemies="{x:Bind ViewModel.TroopEnemies}"
                               BackgroundSource="{x:Bind ViewModel.BackgroundImage, Mode=OneWay}"
                               ArenaSize="{x:Bind ViewModel.ArenaSize, Mode=OneWay}"
                               BlockSize="{x:Bind ViewModel.BlockSize, Mode=OneWay}"
                               ShowGrid="{x:Bind ViewModel.ShowGrid, Mode=OneWay}"
                               PlaceCommand="{x:Bind ViewModel.PlaceEnemyCommand}"
                               SelectCommand="{x:Bind ViewModel.SelectArenaEnemyCommand}" />
      </StackPanel>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
