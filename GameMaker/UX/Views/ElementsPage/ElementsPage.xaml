<Page x:Class="GameMaker.UX.Views.ElementsPage.ElementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:elementsPage="using:GameMaker.UX.ViewModels.ElementsPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:iconView="using:GameMaker.UX.Components.IconView"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance elementsPage:ElementsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.GameDataService.Elements}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Element"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="Element Details"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Orientation="Vertical" Spacing="40">
        <StackPanel Orientation="Horizontal" Spacing="40">
          <TextBox Header="Name"
                   Text="{x:Bind ViewModel.SelectedEntity.Name,
                 Mode=TwoWay,
                 FallbackValue='',
                 UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Bottom" />
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
            <iconView:IconView IconIndex="{x:Bind ViewModel.SelectedEntity.Icon, Mode=TwoWay, FallbackValue=0}" HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <CheckBox IsChecked="{x:Bind ViewModel.SelectedEntity.IsMagicBased, Mode=TwoWay, FallbackValue=False}">Is Magic Based?</CheckBox>
      </StackPanel>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
