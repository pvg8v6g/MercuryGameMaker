<Page x:Class="GameMaker.UX.Views.PropsPage.PropsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:propsPage="using:GameMaker.UX.ViewModels.PropsPage"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:hitboxPreview="using:GameMaker.UX.Components.HitboxPreview"
      xmlns:imageChooser="using:GameMaker.UX.Components.ImageChooser"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance propsPage:PropsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10"
        RowSpacing="10"
        Padding="5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView Grid.Column="0"
                                   ItemsSource="{x:Bind ViewModel.GameDataService.Props}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Prop"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="Prop"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Orientation="Horizontal"
                  Spacing="40">
        <StackPanel Spacing="15"
                    MinWidth="260">
          <TextBox Header="Name"
                   Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />

          <StackPanel Spacing="5">
            <TextBlock Text="Prop Graphic" />
            <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.PropsFolderPath, Mode=OneWay}"
                                       FileName="{x:Bind ViewModel.ImageName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                                       ShowGrid="False"
                                       ChooserWidth="148"
                                       ChooserHeight="148"
                                       ToolTipService.ToolTip="The picture placed on the map, from the game's Graphics\Props folder." />
            <TextBlock Text="{x:Bind ViewModel.ImageSizeText, Mode=OneWay}"
                       Opacity="0.7" />
          </StackPanel>

          <engineTextBox:EngineTextBox Header="Sort Offset Y (px)"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.SortOffset, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="Characters are drawn in front of the prop once their feet are below the bottom of its picture. Negative moves that line up (for long roots or a wide base), positive moves it down." />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <NumberBox Header="Bury (px)"
                       Width="120"
                       Minimum="0"
                       SpinButtonPlacementMode="Inline"
                       Value="{x:Bind ViewModel.BuryDepth, Mode=TwoWay}"
                       ToolTipService.ToolTip="How much of the bottom of the picture is in the ground (roots, the base of a rock). 0 shows all of it." />
            <NumberBox Header="Feather (px)"
                       Width="120"
                       Minimum="0"
                       SpinButtonPlacementMode="Inline"
                       Value="{x:Bind ViewModel.BuryFeather, Mode=TwoWay}"
                       ToolTipService.ToolTip="How far above the ground line the picture fades in, so it blends into the grass" />
          </StackPanel>

          <CheckBox Content="Flat (always under characters)"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.Flat, Mode=TwoWay, FallbackValue=False}"
                    ToolTipService.ToolTip="Rugs, puddles, floor stones: drawn under everyone and never sorted." />
        </StackPanel>

        <StackPanel Spacing="5">
          <TextBlock Text="Footprint (what blocks movement)" />
          <hitboxPreview:HitboxPreview Hitboxes="{x:Bind ViewModel.Footprint, Mode=OneWay}"
                                       CharacterImage="{x:Bind ViewModel.PropImage, Mode=OneWay}"
                                       PreviewsHitboxes="{x:Bind ViewModel.PreviewFootprint, Mode=OneWay}"
                                       PreviewScale="{x:Bind ViewModel.PreviewScale, Mode=OneWay}"
                                       PreviewOffsetX="{x:Bind ViewModel.PreviewOffsetX, Mode=OneWay}"
                                       PreviewOffsetY="{x:Bind ViewModel.PreviewOffsetY, Mode=OneWay}"
                                       ToolTipService.ToolTip="Click to draw the footprint over the picture" />
          <Button Content="Add base footprint"
                  Command="{x:Bind ViewModel.AddBaseFootprintCommand}"
                  ToolTipService.ToolTip="Adds a box across the bottom middle of the picture (a trunk or a rock's base) to start from"
                  behaviors:PointerCursorBehavior.CursorType="Hand" />
        </StackPanel>
      </StackPanel>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
