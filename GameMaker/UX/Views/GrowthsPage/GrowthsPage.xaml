<Page x:Class="GameMaker.UX.Views.GrowthsPage.GrowthsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:growthsPage="using:GameMaker.UX.ViewModels.GrowthsPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
      xmlns:growthsPage1="using:GameMaker.UX.Models.GrowthsPage"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance growthsPage:GrowthsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.GameDataService.Growths}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Growth"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="Growth Details"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid RowSpacing="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="20">
          <TextBox Header="Name"
                   Text="{x:Bind ViewModel.SelectedEntity.Name,Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   Width="200" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Bottom">
          <TextBox Header="Lower"
                   Text="{x:Bind ViewModel.GrowthLower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Width="80" />
          <TextBox Header="Upper"
                   Text="{x:Bind ViewModel.GrowthUpper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Width="80" />
          <Slider Header="Variance"
                  Value="{x:Bind ViewModel.Variance, Mode=TwoWay}"
                  Minimum="-1" Maximum="1" StepFrequency="0.1"
                  Width="150" />
          <Button Content="Render"
                  Command="{x:Bind ViewModel.RenderCommand}"
                  VerticalAlignment="Bottom" />
        </StackPanel>

        <lvc:CartesianChart Grid.Row="2"
                            Series="{Binding Series, Mode=OneWay}"
                            XAxes="{Binding XAxes, Mode=OneWay}"
                            YAxes="{Binding YAxes, Mode=OneWay}"
                            Height="400" />
      </Grid>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="2"
                             Title="Growth Data"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.GrowthDataList, Mode=OneWay}"
                    Margin="0,20,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VariableSizedWrapGrid Orientation="Vertical" MaximumRowsOrColumns="50" ItemWidth="150" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="growthsPage1:GrowthDataEntry">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Bind Level}" FontSize="12" />
              <TextBlock Text=" => " FontSize="12" />
              <TextBlock Text="{x:Bind Value}" Foreground="{StaticResource MediumPinkColor}" FontSize="12" />
              <TextBlock Text=";" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
