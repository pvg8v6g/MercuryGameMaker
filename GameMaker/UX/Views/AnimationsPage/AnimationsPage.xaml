<Page x:Class="GameMaker.UX.Views.AnimationsPage.AnimationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:animationsPage="using:GameMaker.UX.ViewModels.AnimationsPage"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance animationsPage:AnimationsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.GameDataService.Animations}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Animation"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="Animation Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <TextBox Header="Name"
               Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
               VerticalAlignment="Bottom" />
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel x:Name="AnimationFramesPanel"
                             Grid.Column="2"
                             Title="Animation Frames"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid ColumnSpacing="10"
            RowSpacing="10"
            MaxHeight="{x:Bind AnimationFramesPanel.ScrollerViewportHeight, Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="350" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <NumberBox Grid.Column="0"
                   Grid.Row="0"
                   Header="Frame"
                   Value="{x:Bind ViewModel.SelectedFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Minimum="1"
                   SmallChange="1"
                   LargeChange="10"
                   SpinButtonPlacementMode="Compact" />
        <engineListView:EngineReadOnlyListView Grid.Column="0"
                                               Grid.Row="1"
                                               ItemsSource="{x:Bind ViewModel.AnimationImageFiles, Mode=OneWay}"
                                               SelectedIndex="{x:Bind ViewModel.SelectedAnimationImageFilesIndex, Mode=TwoWay}" />
        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="15">
          <Button>
            Frame Effects
          </Button>
          <Button>
            Frame Spanning
          </Button>
        </StackPanel>
        <Canvas Grid.Column="1"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="{StaticResource MediumGreyBrush}"
                behaviors:SizeChangedBehavior.SizeChangedCommand="{x:Bind ViewModel.CanvasSizeChangedCommand}">
          <Rectangle Width="{x:Bind ViewModel.AnchorSize, Mode=OneWay}"
                     Height="{x:Bind ViewModel.AnchorSize, Mode=OneWay}"
                     Canvas.Top="{x:Bind ViewModel.AnchorY, FallbackValue='0', Mode=OneWay}"
                     Canvas.Left="{x:Bind ViewModel.AnchorX, FallbackValue='0', Mode=OneWay}"
                     Fill="{StaticResource RedBrush}" />
        </Canvas>
      </Grid>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
