<Page x:Class="GameMaker.UX.Views.AnimationsPage.AnimationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:animationsPage="using:GameMaker.UX.ViewModels.AnimationsPage"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:mercury="using:MercuryLibrary.CanvasComponents"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance animationsPage:AnimationsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Space"
                         behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.PlayCommand}" />
    <KeyboardAccelerator Key="Delete"
                         behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.DeleteCellCommand}" />
    <KeyboardAccelerator Key="Escape"
                         behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.DeselectCellCommand}" />
    <KeyboardAccelerator Key="Left"
                         behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.PreviousFrameCommand}" />
    <KeyboardAccelerator Key="Right"
                         behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NextFrameCommand}" />
    <KeyboardAccelerator Key="D"
                         Modifiers="Control"
                         behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.DuplicateCellCommand}" />
  </Page.KeyboardAccelerators>
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.GameDataService.Animations}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Animation"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="Animation Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <TextBox Header="Name"
               Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
               VerticalAlignment="Bottom" />
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel x:Name="AnimationFramesPanel"
                             Grid.Column="2"
                             Title="Animation Frames"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid ColumnSpacing="10"
            RowSpacing="10"
            MaxHeight="{x:Bind AnimationFramesPanel.ScrollerViewportHeight, Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="350" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <NumberBox Grid.Column="0"
                   Grid.Row="0"
                   Header="Frame"
                   Value="{x:Bind ViewModel.SelectedFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Minimum="1"
                   SmallChange="1"
                   LargeChange="10"
                   SpinButtonPlacementMode="Inline" />
        <engineListView:EngineReadOnlyListView Grid.Column="0"
                                               Grid.Row="1"
                                               ItemsSource="{x:Bind ViewModel.AnimationImageFiles, Mode=OneWay}"
                                               SelectedIndex="{x:Bind ViewModel.SelectedAnimationImageFilesIndex, Mode=TwoWay}" />
        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Spacing="15">
          <Button Command="{x:Bind ViewModel.FrameEffectsCommand}"
                  IsEnabled="{x:Bind ViewModel.IsCellSelected, Mode=OneWay}">
            Frame Effects
          </Button>
          <Button Command="{x:Bind ViewModel.FrameSpanningCommand}">
            Frame Spanning
          </Button>
          <Button Command="{x:Bind ViewModel.PlayCommand}"
                  Content="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}" />
        </StackPanel>
        <mercury:GameCanvasView Grid.Column="1"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                UpdateRate="16.66666667"
                                ClearColor="{StaticResource MediumGreyColor}"
                                AnchorColor="{StaticResource RedColor}"
                                AnchorRect="{x:Bind ViewModel.AnchorRect, Mode=OneWay}"
                                SelectionColor="{StaticResource RedColor}"
                                SelectionThickness="4"
                                SelectionRect="{x:Bind ViewModel.SelectionRect, Mode=OneWay}"
                                Sprites="{x:Bind ViewModel.Sprites, Mode=OneWay}"
                                behaviors:SizeChangedBehavior.SizeChangedCommand="{x:Bind ViewModel.CanvasSizeChangedCommand}"
                                behaviors:PointerCommandBehavior.CapturePointerOnPressed="True"
                                behaviors:PointerCommandBehavior.PointerPressedCommand="{x:Bind ViewModel.CanvasPointerPressedCommand}"
                                behaviors:PointerCommandBehavior.PointerMovedCommand="{x:Bind ViewModel.CanvasPointerMovedCommand}"
                                behaviors:PointerCommandBehavior.PointerReleasedCommand="{x:Bind ViewModel.CanvasPointerReleasedCommand}" />
        <ItemsControl Grid.Column="1"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      IsHitTestVisible="False"
                      ItemsSource="{x:Bind ViewModel.CellOutlines, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Rectangle Width="{Binding Width}"
                         Height="{Binding Height}"
                         Stroke="{StaticResource LightBlueBrush}"
                         StrokeThickness="2">
                <Rectangle.RenderTransform>
                  <TranslateTransform X="{Binding X}"
                                      Y="{Binding Y}" />
                </Rectangle.RenderTransform>
              </Rectangle>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Column="1"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8"
                Padding="6,3"
                CornerRadius="4"
                IsHitTestVisible="False"
                Background="#AA000000"
                Visibility="{x:Bind ViewModel.IsDragging, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="{x:Bind ViewModel.DragPositionText, Mode=OneWay}"
                     Foreground="White"
                     FontSize="12" />
        </Border>
      </Grid>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
