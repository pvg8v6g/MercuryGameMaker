<Page x:Class="GameMaker.UX.Views.DisciplinesPage.DisciplinesPage"
      x:Name="DisciplinesPageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:iconView="using:GameMaker.UX.Components.IconView"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:disciplinesPage="using:GameMaker.UX.ViewModels.DisciplinesPage"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance disciplinesPage:DisciplinesPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.GameDataService.Disciplines}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1" Title="Discipline Details"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid ColumnSpacing="15"
            RowSpacing="15">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 Grid.Row="0"
                 Header="Name"
                 Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Bottom" />

        <StackPanel Grid.Column="1"
                    Grid.Row="0">
          <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
          <iconView:IconView IconIndex="{x:Bind ViewModel.SelectedEntity.Icon, Mode=TwoWay, FallbackValue=0}"
                             HorizontalAlignment="Center" />
        </StackPanel>

        <TextBox Grid.Column="0"
                 Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Header="Description"
                 Text="{x:Bind ViewModel.SelectedEntity.Description, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="100"
                 VerticalAlignment="Top" />
      </Grid>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="2"
                             Title="Attribute Data"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.AttributeSettings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="disciplinesPage:AttributeGrowthSetting">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>

              <iconView:IconView IconIndex="{x:Bind Icon, Mode=TwoWay, FallbackValue=0}"
                                 HorizontalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding DataContext.GameDataService.Growths, ElementName=DisciplinesPageRoot}"
                        SelectedValue="{x:Bind GrowthGuid, Mode=TwoWay}"
                        SelectedValuePath="Guid"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Stretch" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
