<Page x:Class="GameMaker.UX.Views.EnemiesPage.EnemiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:enemiesPage="using:GameMaker.UX.ViewModels.EnemiesPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:dropListView="using:GameMaker.UX.Components.DropListView"
      xmlns:imageChooser="using:GameMaker.UX.Components.ImageChooser"
      xmlns:engineIcon="using:GameMaker.UX.Components.EngineIcon"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:actorsPage1="using:GameMaker.UX.Models.ActorsPage"
      xmlns:enemiesPageModels="using:GameMaker.UX.Models.EnemiesPage"
      xmlns:markup="using:GameLibrary.MarkupExtensions"
      xmlns:enums="using:GameLibrary.Enumerations"
      xmlns:hitboxPreview="using:GameMaker.UX.Components.HitboxPreview"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance enemiesPage:EnemiesPageViewModel}">
  <Grid ColumnSpacing="10" RowSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="1.5*" />
      <RowDefinition Height="1.5*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="1.3*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <engineListView:EngineListView Grid.RowSpan="2" ItemsSource="{x:Bind ViewModel.GameDataService.Enemies}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Enemy"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />

    <enginePanel:EnginePanel Grid.Row="0"
                             Grid.RowSpan="2"
                             Grid.Column="1"
                             Title="Fighter Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Orientation="Vertical"
                  Spacing="20">
        <StackPanel Spacing="20" Orientation="Horizontal">
          <StackPanel Spacing="5" VerticalAlignment="Bottom">
            <TextBlock Text="Enemy Graphic" />
            <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.EnemyFolderPath, Mode=OneWay}"
                                       FileName="{x:Bind ViewModel.SelectedEntity.FaceName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                                       ShowGrid="False"
                                       ChooserWidth="148"
                                       ChooserHeight="148" />
          </StackPanel>

          <StackPanel Spacing="5" VerticalAlignment="Bottom">
            <TextBlock Text="Character Image" />
            <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.CharacterFolderPath, Mode=OneWay}"
                                       FileName="{x:Bind ViewModel.CharacterName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                                       Index="{x:Bind ViewModel.CharacterIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       OnImageChangedCommand="{x:Bind ViewModel.SelectSpriteCommand}"
                                       ChooserWidth="148"
                                       ChooserHeight="148" />
          </StackPanel>

          <StackPanel Spacing="5" VerticalAlignment="Bottom">
            <TextBlock Text="Character Hitboxes" />
            <ComboBox ItemsSource="{markup:EnumValues EnumType=enums:Direction}"
                      SelectedItem="{x:Bind ViewModel.SelectedDirection, Mode=TwoWay}"
                      MinWidth="148" />
            <hitboxPreview:HitboxPreview Hitboxes="{x:Bind ViewModel.SelectedDirectionHitboxes, Mode=TwoWay}"
                                         CharacterImage="{x:Bind ViewModel.AnchorImage, Mode=OneWay}"
                                         PreviewsHitboxes="{x:Bind ViewModel.PreviewsHitboxes, Mode=OneWay}"
                                         PreviewScale="{x:Bind ViewModel.HitboxPreviewScale, Mode=OneWay}"
                                         PreviewOffsetX="{x:Bind ViewModel.HitboxPreviewOffsetX, Mode=OneWay}"
                                         PreviewOffsetY="{x:Bind ViewModel.HitboxPreviewOffsetY, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>

        <Grid ColumnSpacing="40"
              RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0"
                   Grid.Row="0"
                   Header="Name"
                   Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   ToolTipService.ToolTip="What is this enemy's name?"
                   VerticalAlignment="Bottom" />

          <engineTextBox:EngineTextBox Grid.Column="0"
                                       Grid.Row="1"
                                       Header="Level"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.Level, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="What is this enemy's level?" />

          <CheckBox Grid.Column="1"
                    Grid.Row="1"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.StaticStats, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Should this enemy's stats stay the same regardless of level?"
                    VerticalAlignment="Bottom">
            Static Stats
          </CheckBox>

          <engineTextBox:EngineTextBox Grid.Column="0"
                                       Grid.Row="2"
                                       Header="Experience"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.Experience, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="How much experience does this enemy give when defeated?" />

          <engineTextBox:EngineTextBox Grid.Column="1"
                                       Grid.Row="2"
                                       Header="Money"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.MonetaryValue, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="How much money does this enemy give when defeated?" />

          <CheckBox Grid.Column="0"
                    Grid.Row="3"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.Medic, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Medic healing items heal for twice the amount."
                    VerticalAlignment="Bottom">
            Medic
          </CheckBox>

          <CheckBox Grid.Column="1"
                    Grid.Row="3"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.Boss, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Is this enemy a boss? Do we show the health bar?"
                    VerticalAlignment="Bottom">
            Boss
          </CheckBox>

          <engineTextBox:EngineTextBox Grid.Column="0"
                                       Grid.Row="4"
                                       Grid.ColumnSpan="2"
                                       Header="Description"
                                       Text="{x:Bind ViewModel.SelectedEntity.Description, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                                       AcceptsReturn="True"
                                       TextWrapping="Wrap"
                                       MinHeight="100"
                                       ToolTipService.ToolTip="Tell me a little bit about this enemy."
                                       VerticalAlignment="Top" />
        </Grid>
      </StackPanel>
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel Grid.Row="0"
                             Grid.Column="2"
                             Title="Attributes"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Orientation="Vertical" Spacing="20">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <engineTextBox:EngineTextBox Header="Life"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.MaxLife, Mode=TwoWay, FallbackValue='100', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="The maximum life for this enemy." />
          <engineTextBox:EngineTextBox Header="Mana"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.MaxMana, Mode=TwoWay, FallbackValue='50', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="The maximum mana for this enemy." />
        </StackPanel>

        <ItemsControl ItemsSource="{x:Bind ViewModel.AttributeStats, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="15" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="enemiesPage:EnemyAttributeViewModel">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <engineIcon:EngineIcon Grid.Column="0"
                                       IconIndex="{x:Bind Icon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind Name}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />

                <engineTextBox:EngineTextBox Grid.Column="2"
                                             InputType="Integer"
                                             Text="{x:Bind AttributeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tooltip="The base value of this attribute for the enemy."
                                             VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel Grid.Row="1"
                             Grid.Column="2"
                             Title="Fighter Elements"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.ElementResistanceStats, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="actorsPage1:ActorElementModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     IconIndex="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <StackPanel Grid.Column="2"
                          Orientation="Horizontal">
                <engineTextBox:EngineTextBox InputType="Integer"
                                             Text="{x:Bind ElementValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tooltip="The percentage of damage this element does to this enemy. Negative values heal."
                                             VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center">%</TextBlock>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel x:Name="DropsPanel"
                             Grid.Row="0"
                             Grid.Column="3"
                             Title="Drops"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <dropListView:DropListView DropsSource="{x:Bind ViewModel.SelectedEntity.Drops, Mode=OneWay}"
                                 AllItems="{x:Bind ViewModel.AllItems, Mode=OneWay}"
                                 MinHeight="300"
                                 Height="{x:Bind DropsPanel.ScrollerViewportHeight, Mode=OneWay}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel x:Name="ArtesPanel"
                             Grid.Row="1"
                             Grid.Column="3"
                             Title="Artes"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.EnemyArtes}"
                                     SelectedIndex="{x:Bind ViewModel.SelectedEnemyArteIndex, Mode=TwoWay}"
                                     NewCommand="{x:Bind ViewModel.NewArteCommand}"
                                     EditCommand="{x:Bind ViewModel.EditArteCommand}"
                                     CopyCommand="{x:Bind ViewModel.CopyArteCommand}"
                                     PasteCommand="{x:Bind ViewModel.PasteArteCommand}"
                                     DeleteCommand="{x:Bind ViewModel.DeleteArteCommand}"
                                     CopiedModel="{x:Bind ViewModel.CopiedEnemyArte, Mode=OneWay}"
                                     MinHeight="200"
                                     Height="{x:Bind ArtesPanel.ScrollerViewportHeight, Mode=OneWay}"
                                     ToolTipService.ToolTip="Right-click and choose New to give this enemy an arte. Conditions such as level, switches or variables decide when the enemy gains it.">
        <engineListView:EngineListView.ItemTemplate>
          <DataTemplate x:DataType="enemiesPageModels:EnemyArteModel">
            <StackPanel Padding="0,5">
              <TextBlock Text="{x:Bind Name}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ConditionText}"
                         FontSize="12"
                         Foreground="{StaticResource LightGreyBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </engineListView:EngineListView.ItemTemplate>
      </engineListView:EngineListView>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
