<Page x:Class="GameMaker.UX.Views.StatesPage.StatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:statesPage="using:GameMaker.UX.ViewModels.StatesPage"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineIcon="using:GameMaker.UX.Components.EngineIcon"
      xmlns:iconView="using:GameMaker.UX.Components.IconView"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:engineComboBox="using:GameMaker.UX.Components.EngineComboBox"
      xmlns:animations="using:GameLibrary.Models.Animations"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance statesPage:StatesPageViewModel}">
  <Grid ColumnSpacing="10"
        RowSpacing="10"
        Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView Grid.Column="0"
                                   Grid.RowSpan="2"
                                   ItemsSource="{x:Bind ViewModel.GameDataService.States}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New State"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="State Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid ColumnSpacing="40"
            RowSpacing="15">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 Grid.Row="0"
                 Header="Name"
                 Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Bottom" />

        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    VerticalAlignment="Bottom">
          <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
          <iconView:IconView Icon="{x:Bind ViewModel.SelectedEntity.Icon, Mode=TwoWay}"
                             HorizontalAlignment="Center" />
        </StackPanel>

        <engineTextBox:EngineTextBox Grid.Column="0"
                                     Grid.Row="1"
                                     Header="Duration (Ticks)"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedEntity.Ticks, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="Duration in frames (60 = 1 second). Zero causes a permanent effect." />

        <StackPanel Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Bottom">
          <engineComboBox:EngineComboBox Header="Tick Animation"
                                         IsClearable="True"
                                         PlaceholderText="None"
                                         ItemsSource="{x:Bind ViewModel.GameDataService.Animations, Mode=OneWay}"
                                         SelectedValue="{x:Bind ViewModel.SelectedTickAnimation, Mode=TwoWay}"
                                         SelectedValuePath="Guid"
                                         MinWidth="180"
                                         MinHeight="48"
                                         ToolTipService.ToolTip="This animation plays every time this state affects the fighter.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="animations:Animation">
                <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="36">
                  <engineIcon:EngineIcon Icon="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </engineComboBox:EngineComboBox>
        </StackPanel>
      </Grid>
    </enginePanel:EnginePanel>
    <StackPanel Grid.Column="1"
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Top">
      <enginePanel:EnginePanel Title="Attribute Changes"
                               Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.AttributeChanges, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="15" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="statesPage:StateChangeViewModel">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <engineIcon:EngineIcon Grid.Column="0"
                                       Icon="{x:Bind Icon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Name}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <engineTextBox:EngineTextBox Grid.Column="2"
                                             InputType="Integer"
                                             Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             Tooltip="Added to this attribute while the state lasts, for each stack. Negative lowers it. 0 is no change." />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </enginePanel:EnginePanel>
      <enginePanel:EnginePanel Title="Element Changes"
                               Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.ElementChanges, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="15" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="statesPage:StateChangeViewModel">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <engineIcon:EngineIcon Grid.Column="0"
                                       Icon="{x:Bind Icon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Name}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                  <engineTextBox:EngineTextBox InputType="Integer"
                                               Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               VerticalAlignment="Center"
                                               Tooltip="The rate this state sets for this element, added to the fighter's other rates the way equipment is, for each stack. 100% is no change, 50% takes 50 points off (halving a normal fighter's), below 0% heals. " />
                  <TextBlock VerticalAlignment="Center">%</TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </enginePanel:EnginePanel>
    </StackPanel>
    <StackPanel Grid.Column="2"
                Grid.RowSpan="2"
                Orientation="Horizontal"
                Spacing="10">
      <enginePanel:EnginePanel Title="Behavior"
                               Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
        <StackPanel Spacing="10">
          <CheckBox Content="Stackable"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.Stackable, Mode=TwoWay, FallbackValue=False}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="More than one of it can be on a fighter, up to Max Stacks. Applied again while it's there, a state that isn't stackable does nothing. All the stacks share one timer." />
          <engineTextBox:EngineTextBox Header="Max Stacks"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.MaxStacks, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="The most stacks of it a fighter can have. Only used when the state is stackable." />
          <CheckBox Content="Remains After Battle"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.RemainsAfterBattle, Mode=TwoWay, FallbackValue=False}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Every state is removed when a battle ends unless it says it lasts." />
          <CheckBox Content="Ends When Source Falls"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.EndsWhenSourceFalls, Mode=TwoWay, FallbackValue=False}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="For taunts, Feared and links: it ends when whoever applied it falls. Poisons and burns keep going." />
          <CheckBox Content="Stun-Lock"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.StunLock, Mode=TwoWay, FallbackValue=False}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Stun, frozen, sealed, rooted and the like. A fighter holding one can do nothing: no walking, turning or artes, and a cast is broken. Bosses are immune to these." />
          <CheckBox Content="Can Still Use Artes"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.CanUseArtes, Mode=TwoWay, FallbackValue=False}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="A stun-lock fighter can still use artes where it stands (it can't walk or turn). Off by default." />
          <CheckBox Content="Hidden"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.Hidden, Mode=TwoWay, FallbackValue=False}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Never shows on the HUD." />
          <engineTextBox:EngineTextBox Header="Tick Interval"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.TickInterval, Mode=TwoWay, FallbackValue='60', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="Frames between each Tick Arte (60 = 1 second)." />
          <engineComboBox:EngineComboBox Header="Tick Arte"
                                         IsClearable="True"
                                         PlaceholderText="None"
                                         ItemsSource="{x:Bind ViewModel.GameDataService.Artes, Mode=OneWay}"
                                         DisplayMemberPath="Name"
                                         SelectedValue="{x:Bind ViewModel.SelectedTickArte, Mode=TwoWay}"
                                         SelectedValuePath="Guid"
                                         MinWidth="180"
                                         ToolTipService.ToolTip="This arte is activated on the fighter holding the state every Tick Interval, owned by whoever applied the state, so it uses their Power. It costs nothing and has no cast or cooldown. The state's damage element comes from this arte's Element Type on the Artes page, so weaknesses and resistances apply to it." />
          <TextBlock Foreground="{StaticResource LightYellowBrush}"
                     TextWrapping="Wrap"
                     MaxWidth="260"
                     Text="The element of a state's damage is set on its Tick Arte (Element Type on the Artes page)." />
        </StackPanel>
      </enginePanel:EnginePanel>
    </StackPanel>
  </Grid>
</Page>
