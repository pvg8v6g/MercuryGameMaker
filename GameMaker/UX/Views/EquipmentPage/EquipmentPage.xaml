<Page x:Class="GameMaker.UX.Views.EquipmentPage.EquipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:equipmentPage="using:GameMaker.UX.ViewModels.EquipmentPage"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineIcon="using:GameMaker.UX.Components.EngineIcon"
      xmlns:iconView="using:GameMaker.UX.Components.IconView"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:artes="using:GameLibrary.Models.Artes"
      xmlns:enums="using:GameLibrary.Enumerations"
      xmlns:extensions="using:GameLibrary.MarkupExtensions"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance equipmentPage:EquipmentPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10"
        RowSpacing="10"
        Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="{StaticResource DescriptionColumnWidth}" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView Grid.Column="0"
                                   Grid.Row="0"
                                   Grid.RowSpan="2"
                                   ItemsSource="{x:Bind ViewModel.GameDataService.Equipment}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Equipment"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Grid.Row="0"
                             Title="Item Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid ColumnSpacing="40"
            RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 Grid.Row="0"
                 Header="Name"
                 Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Bottom" />

        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    HorizontalAlignment="Left">
          <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
          <iconView:IconView Icon="{x:Bind ViewModel.SelectedEntity.Icon, Mode=TwoWay}"
                             HorizontalAlignment="Center" />
        </StackPanel>

        <engineTextBox:EngineTextBox Grid.Column="0"
                                     Grid.Row="1"
                                     Header="Cost"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedEntity.Cost, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="This is the monetary cost of this equipment item." />

        <!-- the description stretches up to DescriptionMaxWidth, anchored left: a stretched box with a MaxWidth centres itself -->
        <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="{StaticResource DescriptionMaxWidth}" />
          </Grid.ColumnDefinitions>
          <TextBox Header="Description"
                   Text="{x:Bind ViewModel.SelectedEntity.Description, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   Height="120"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VerticalAlignment="Top" />
        </Grid>
      </Grid>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="1"
                             Grid.Row="1"
                             Title="Equipment Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid RowSpacing="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Bottom">
          <ComboBox Header="Location"
                    PlaceholderText="Location"
                    ItemsSource="{extensions:EnumValues EnumType=enums:EquipmentLocation}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntity.EquipmentLocation, Mode=TwoWay}"
                    MinWidth="140"
                    VerticalAlignment="Bottom" />
          <StackPanel Spacing="8"
                      VerticalAlignment="Bottom">
            <TextBlock Text="Equippable By" />
            <DropDownButton Content="{x:Bind ViewModel.EquippableByText, Mode=OneWay}"
                            MinWidth="160"
                            MaxWidth="320"
                            behaviors:PointerCursorBehavior.CursorType="Hand"
                            ToolTipService.ToolTip="The disciplines that can equip this. All means anyone can.">
              <DropDownButton.Flyout>
                <Flyout Placement="Bottom">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.DisciplineToggles, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="equipmentPage:DisciplineToggleViewModel">
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                  behaviors:PointerCursorBehavior.CursorType="Hand">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <engineIcon:EngineIcon Icon="{x:Bind Icon}"
                                                   Visibility="{x:Bind HasIcon}"
                                                   VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="0"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Bottom">
          <ComboBox Header="Arte"
                    PlaceholderText="None"
                    ItemsSource="{x:Bind ViewModel.GameDataService.Artes, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.SelectedEntity.Arte, Mode=TwoWay, FallbackValue={x:Null}}"
                    SelectedValuePath="Guid"
                    MinWidth="180"
                    MinHeight="48"
                    ToolTipService.ToolTip="The arte this equipment grants while equipped."
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="artes:Arte">
                <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="36">
                  <engineIcon:EngineIcon Icon="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Clear"
                  Command="{x:Bind ViewModel.ClearArteCommand}"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  ToolTipService.ToolTip="Remove the arte from this equipment."
                  VerticalAlignment="Bottom" />
        </StackPanel>

        <CheckBox Grid.Column="0"
                  Grid.Row="2"
                  IsChecked="{x:Bind ViewModel.SelectedEntity.ResistAllStates, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  ToolTipService.ToolTip="Does wearing this prevent all good and bad states from being applied?"
                  VerticalAlignment="Bottom">
          Resist All States
        </CheckBox>
      </Grid>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="2"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Title="Attribute Stat Changes"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.AttributeStats, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="equipmentPage:AttributeStatViewModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     Icon="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <engineTextBox:EngineTextBox Grid.Column="2"
                                           InputType="Integer"
                                           Text="{x:Bind AttributeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="3"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Title="Element Resistance"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.ElementResistanceStats, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="equipmentPage:AttributeStatViewModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     Icon="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <StackPanel Grid.Column="2"
                          Orientation="Horizontal">
                <engineTextBox:EngineTextBox InputType="Integer"
                                             Text="{x:Bind ElementValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             Tooltip="The percentage of damage this element does while wearing this equipment. Negative values heal." />
                <TextBlock VerticalAlignment="Center">%</TextBlock>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="4"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Title="Resist States"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.StateResistanceStats, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="equipmentPage:StateResistViewModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     Icon="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <CheckBox Grid.Column="2"
                        IsChecked="{x:Bind IsResisted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        behaviors:PointerCursorBehavior.CursorType="Hand"
                        VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
