<Page x:Class="GameMaker.UX.Views.ArtesPage.ArtesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:artesPage="using:GameMaker.UX.ViewModels.ArtesPage"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineIcon="using:GameMaker.UX.Components.EngineIcon"
      xmlns:iconView="using:GameMaker.UX.Components.IconView"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:gridArea="using:GameMaker.UX.Components.GridArea"
      xmlns:hitboxPreview="using:GameMaker.UX.Components.HitboxPreview"
      xmlns:animations="using:GameLibrary.Models.Animations"
      xmlns:areas="using:GameLibrary.Models.Areas"
      xmlns:enums="using:GameLibrary.Enumerations"
      xmlns:extensions="using:GameLibrary.MarkupExtensions"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance artesPage:ArtesPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10"
        RowSpacing="10"
        Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <engineListView:EngineListView Grid.Column="0"
                                   Grid.Row="0"
                                   Grid.RowSpan="2"
                                   ItemsSource="{x:Bind ViewModel.GameDataService.Artes}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Arte"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />

    <enginePanel:EnginePanel Grid.Column="1"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Title="Arte Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid ColumnSpacing="20"
              RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0"
                   Grid.Row="0"
                   Header="Name"
                   Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Bottom" />

          <StackPanel Grid.Column="1"
                      Grid.Row="0"
                      HorizontalAlignment="Left">
            <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
            <iconView:IconView IconIndex="{x:Bind ViewModel.SelectedEntity.Icon, Mode=TwoWay, FallbackValue=0}"
                               HorizontalAlignment="Center" />
          </StackPanel>

          <TextBox Grid.Column="0"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Header="Description"
                   Text="{x:Bind ViewModel.SelectedEntity.Description, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="80"
                   VerticalAlignment="Top" />

          <engineTextBox:EngineTextBox Grid.Column="0"
                                       Grid.Row="2"
                                       Header="Mana Cost"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.Cost, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="How much mana does casting this arte cost?" />

          <engineTextBox:EngineTextBox Grid.Column="1"
                                       Grid.Row="2"
                                       Header="Cast Time (60 = 1sec)"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.CastTime, Mode=TwoWay, FallbackValue='60', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="How long does this arte take to cast? 60 equals one second." />

          <ComboBox Grid.Column="0"
                    Grid.Row="3"
                    Header="Use"
                    ItemsSource="{extensions:EnumValues EnumType=enums:ItemUse}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntity.ArteUse, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

          <ComboBox Grid.Column="1"
                    Grid.Row="3"
                    Header="Scope"
                    ItemsSource="{extensions:EnumValues EnumType=enums:EffectScope}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntity.EffectScope, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

          <ComboBox Grid.Column="0"
                    Grid.Row="4"
                    Header="Caster Animation"
                    PlaceholderText="None"
                    ItemsSource="{x:Bind ViewModel.GameDataService.Animations, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.SelectedEntity.CasterAnimation, Mode=TwoWay, FallbackValue={x:Null}}"
                    SelectedValuePath="Guid"
                    MinHeight="48"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="animations:Animation">
                <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="36">
                  <engineIcon:EngineIcon IconIndex="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Grid.Column="1"
                    Grid.Row="4"
                    Header="Target Animation"
                    PlaceholderText="None"
                    ItemsSource="{x:Bind ViewModel.GameDataService.Animations, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.SelectedEntity.TargetAnimation, Mode=TwoWay, FallbackValue={x:Null}}"
                    SelectedValuePath="Guid"
                    MinHeight="48"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="animations:Animation">
                <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="36">
                  <engineIcon:EngineIcon IconIndex="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Grid.Column="0"
                      Grid.Row="5"
                      Spacing="5">
            <TextBlock Text="Arte Hitboxes" />
            <hitboxPreview:HitboxPreview Hitboxes="{x:Bind ViewModel.SelectedEntity.Hitboxes, Mode=OneWay}"
                                         PreviewsHitboxes="{x:Bind ViewModel.PreviewsHitboxes, Mode=OneWay}"
                                         PreviewGridLines="{x:Bind ViewModel.PreviewGridLines, Mode=OneWay}"
                                         PreviewScale="{x:Bind ViewModel.HitboxPreviewScale, Mode=OneWay}"
                                         PreviewOffsetX="{x:Bind ViewModel.HitboxPreviewOffsetX, Mode=OneWay}"
                                         PreviewOffsetY="{x:Bind ViewModel.HitboxPreviewOffsetY, Mode=OneWay}"
                                         ShowAnchor="True"
                                         ShowGrid="True" />
          </StackPanel>

          <CheckBox Grid.Column="1"
                    Grid.Row="5"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.DirectionRotate, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Should the arte rotate to match the character's facing direction?"
                    VerticalAlignment="Bottom">
            Rotate Arte With Character Direction
          </CheckBox>
        </Grid>
      </ScrollViewer>
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel Grid.Column="2"
                             Grid.Row="0"
                             Title="Arte Damage"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <engineTextBox:EngineTextBox Grid.Column="0"
                                     Header="Life Damage"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedEntity.HpDamage, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="How much life damage does this arte deal? Negative values heal." />

        <engineTextBox:EngineTextBox Grid.Column="1"
                                     Header="Mana Damage"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedEntity.ManaDamage, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="How much mana damage does this arte deal? Negative values restore mana." />

        <engineTextBox:EngineTextBox Grid.Column="2"
                                     Header="Damage Variance %"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedEntity.Variance, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                     Tooltip="This is a percent variance of the damage dealt. For instance if the damage dealt happens to be 100, and you give it a variance of 10 it could cause anywhere from 90 to 110." />
      </Grid>
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel Grid.Column="4"
                             Grid.Row="0"
                             Title="Add States"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.AddStates, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="artesPage:ArteToggleViewModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     IconIndex="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <CheckBox Grid.Column="2"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        behaviors:PointerCursorBehavior.CursorType="Hand"
                        VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel Grid.Column="4"
                             Grid.Row="1"
                             Title="Remove States"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.RemoveStates, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="artesPage:ArteToggleViewModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     IconIndex="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <CheckBox Grid.Column="2"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        behaviors:PointerCursorBehavior.CursorType="Hand"
                        VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>

    <enginePanel:EnginePanel Grid.Column="3"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Title="Element Type"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.Elements, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="artesPage:ArteToggleViewModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     IconIndex="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <CheckBox Grid.Column="2"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        behaviors:PointerCursorBehavior.CursorType="Hand"
                        VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
