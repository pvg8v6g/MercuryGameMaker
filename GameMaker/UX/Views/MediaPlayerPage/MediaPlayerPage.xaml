<Page x:Class="GameMaker.UX.Views.MediaPlayerPage.MediaPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mediaPlayerPage="using:GameMaker.UX.ViewModels.MediaPlayerPage"
      xmlns:media="using:GameLibrary.Models.Media"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance mediaPlayerPage:MediaPlayerPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="20"
        Padding="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TreeView Grid.Column="0"
              SelectionMode="Single"
              Background="{StaticResource MediumGreyBrush}"
              ItemsSource="{x:Bind ViewModel.TreeRoot, Mode=OneWay}"
              behaviors:TreeViewBehaviors.SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
              behaviors:TreeViewBehaviors.DoubleTapCommand="{x:Bind ViewModel.PlaySelectedCommand}">
      <TreeView.ItemTemplate>
        <DataTemplate x:DataType="media:MediaSelectionModel">
          <TreeViewItem ItemsSource="{x:Bind Children}"
                        Content="{x:Bind Name}" />
        </DataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <StackPanel Grid.Column="1"
                Spacing="20"
                VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal"
                  Spacing="20">
        <Button Command="{x:Bind ViewModel.PlayCommand}"
                IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                ToolTipService.ToolTip="Play Sound">
          <SymbolIcon Symbol="Play" />
        </Button>
        <Button Command="{x:Bind ViewModel.StopCommand}"
                ToolTipService.ToolTip="Stop Sound">
          <SymbolIcon Symbol="Stop" />
        </Button>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Volume" />
        <Slider Width="500"
                Minimum="0.0"
                Maximum="1.0"
                StepFrequency="0.1"
                TickFrequency="0.1"
                TickPlacement="Outside"
                IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Pitch" />
        <Slider Width="500"
                Minimum="0.0"
                Maximum="2.0"
                StepFrequency="0.1"
                TickFrequency="0.1"
                TickPlacement="Outside"
                IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                Value="{x:Bind ViewModel.Pitch, Mode=TwoWay}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Page>
