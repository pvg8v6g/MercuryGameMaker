<UserControl x:Class="GameMaker.UX.Views.Popups.MovementEditor.MovementEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:movementEditor="using:GameMaker.UX.Views.Popups.MovementEditor"
             xmlns:movements="using:GameLibrary.Models.Movements"
             xmlns:artes="using:GameLibrary.Models.Artes"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:engineIcon="using:GameMaker.UX.Components.EngineIcon"
             xmlns:enums="using:GameLibrary.Enumerations"
             xmlns:mercuryEnums="using:MercuryLibrary.Enumerations"
             xmlns:extensions="using:GameLibrary.MarkupExtensions"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             x:Name="Root"
             mc:Ignorable="d">
  <UserControl.Resources>
    <!-- picked in the popup itself, so the template has nothing of its own -->
    <DataTemplate x:Key="MoveTemplate">
      <Grid />
    </DataTemplate>

    <DataTemplate x:Key="MoveTowardTemplate" x:DataType="movements:MoveTowardMovement">
      <StackPanel Spacing="10">
        <ComboBox Header="Target"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{extensions:EnumValues EnumType=enums:MovementTarget}"
                  SelectedItem="{x:Bind TargetType, Mode=TwoWay}" />
        <engineTextBox:EngineTextBox Header="Target X" InputType="Integer"
                                     Visibility="{x:Bind TargetType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Location}"
                                     Text="{x:Bind TargetX, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Header="Target Y" InputType="Integer"
                                     Visibility="{x:Bind TargetType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Location}"
                                     Text="{x:Bind TargetY, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MoveAwayTemplate" x:DataType="movements:MoveAwayMovement">
      <StackPanel Spacing="10">
        <ComboBox Header="Target"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{extensions:EnumValues EnumType=enums:MovementTarget}"
                  SelectedItem="{x:Bind TargetType, Mode=TwoWay}" />
        <engineTextBox:EngineTextBox Header="Target X" InputType="Integer"
                                     Visibility="{x:Bind TargetType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Location}"
                                     Text="{x:Bind TargetX, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Header="Target Y" InputType="Integer"
                                     Visibility="{x:Bind TargetType, Mode=OneWay, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Location}"
                                     Text="{x:Bind TargetY, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Header="Distance (tiles)" InputType="Integer"
                                     Text="{x:Bind Distance, Mode=TwoWay, FallbackValue='5', UpdateSourceTrigger=PropertyChanged}"
                                     ToolTipService.ToolTip="How far to get from the target. Stops sooner when it can't get any farther." />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SpeedTemplate" x:DataType="movements:SpeedMovement">
      <engineTextBox:EngineTextBox Header="Speed" InputType="Integer"
                                   Text="{x:Bind Speed, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

    <DataTemplate x:Key="OpacityTemplate" x:DataType="movements:OpacityMovement">
      <StackPanel Spacing="10">
        <engineTextBox:EngineTextBox Header="Opacity (0 - 1)" InputType="Double"
                                     Text="{x:Bind Opacity, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Header="Transition Time (ms)" InputType="Integer"
                                     Text="{x:Bind TranslateTime, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WaitTemplate" x:DataType="movements:WaitMovement">
      <engineTextBox:EngineTextBox Header="Wait Time (ms)" InputType="Integer"
                                   Text="{x:Bind Wait, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

    <!-- picked in the popup itself, so the template has nothing of its own -->
    <DataTemplate x:Key="TurnTemplate">
      <Grid />
    </DataTemplate>

    <DataTemplate x:Key="BlendTemplate" x:DataType="movements:BlendModeMovement">
      <StackPanel Spacing="10">
        <ComboBox Header="Blend Mode"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{extensions:EnumValues EnumType=mercuryEnums:BlendMode}"
                  SelectedItem="{x:Bind BlendMode, Mode=TwoWay}" />
        <engineTextBox:EngineTextBox Header="Transition Time (ms)" InputType="Integer"
                                     Text="{x:Bind BlendTime, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CharacterImageTemplate" x:DataType="movements:CharacterImageMovement">
      <StackPanel Spacing="10">
        <TextBox Header="Character Name"
                 Text="{x:Bind CharacterName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Header="Character Index" InputType="Integer"
                                     Text="{x:Bind CharacterIndex, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
        <ComboBox Header="Direction"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{extensions:EnumValues EnumType=enums:Direction}"
                  SelectedItem="{x:Bind Direction, Mode=TwoWay}" />
      </StackPanel>
    </DataTemplate>

    <!-- picked in the popup itself, so the template has nothing of its own -->
    <DataTemplate x:Key="ActivateArteTemplate">
      <Grid />
    </DataTemplate>

    <DataTemplate x:Key="BalloonTemplate" x:DataType="movements:BalloonMovement">
      <CheckBox Content="Wait For Completion"
                IsChecked="{x:Bind WaitForCompletion, Mode=TwoWay}"
                ToolTipService.ToolTip="The route waits until the balloon has played through and gone" />
    </DataTemplate>

    <!-- picked in the popup itself, so the template has nothing of its own -->
    <DataTemplate x:Key="TurnTargetTemplate">
      <Grid />
    </DataTemplate>

    <DataTemplate x:Key="EmptyTemplate">
      <TextBlock Text="Nothing else to set for this command." TextWrapping="Wrap" Opacity="0.8" />
    </DataTemplate>

    <movementEditor:MovementEditorTemplateSelector x:Key="MovementEditorTemplateSelector"
                                                    Move="{StaticResource MoveTemplate}"
                                                    MoveToward="{StaticResource MoveTowardTemplate}"
                                                    MoveAway="{StaticResource MoveAwayTemplate}"
                                                    Speed="{StaticResource SpeedTemplate}"
                                                    Opacity="{StaticResource OpacityTemplate}"
                                                    Wait="{StaticResource WaitTemplate}"
                                                    Turn="{StaticResource TurnTemplate}"
                                                    Blend="{StaticResource BlendTemplate}"
                                                    CharacterImage="{StaticResource CharacterImageTemplate}"
                                                    ActivateArte="{StaticResource ActivateArteTemplate}"
                                                    Balloon="{StaticResource BalloonTemplate}"
                                                    TurnTarget="{StaticResource TurnTargetTemplate}"
                                                    Empty="{StaticResource EmptyTemplate}" />
  </UserControl.Resources>

  <popup:PopupShell Title="Edit Command"
                    PrimaryButtonText="Done"
                    SecondaryButtonText="Cancel">
    <Grid Width="420"
          MinHeight="160">
      <StackPanel Spacing="10">
        <!-- who the step acts on: the route's own entity, the player or another entity on the map -->
        <ComboBox Header="Entity"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.TargetChoices}"
                  SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Visibility="{x:Bind ViewModel.ShowsTarget, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <!-- the choices that come from the editor (directions, the map's entities, balloons, artes) live here, not in
             the templates: a template only sees its own step -->
        <ComboBox Header="Direction"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.DirectionChoices}"
                  SelectedItem="{x:Bind ViewModel.SelectedDirection, Mode=TwoWay}"
                  Visibility="{x:Bind ViewModel.ShowsDirection, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTipService.ToolTip="Random picks one of the four ways each time the step runs" />
        <!-- move, step forward and step backward: how many walking steps, and how far that is on the grid -->
        <StackPanel Spacing="4"
                    Visibility="{x:Bind ViewModel.ShowsSteps, Converter={StaticResource BooleanToVisibilityConverter}}">
          <engineTextBox:EngineTextBox Header="Steps" InputType="Integer"
                                       Text="{x:Bind ViewModel.Steps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTipService.ToolTip="Walking steps, the same small steps a character takes when walked with the keys" />
          <TextBlock Text="{x:Bind ViewModel.TilesText, Mode=OneWay}" Opacity="0.8" />
        </StackPanel>
        <ComboBox Header="Target"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Pick the player or an entity"
                  ItemsSource="{x:Bind ViewModel.TurnTargets}"
                  SelectedItem="{x:Bind ViewModel.SelectedTurnTarget, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Visibility="{x:Bind ViewModel.ShowsTurnTarget, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ComboBox Header="Balloon"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.BalloonChoices}"
                  SelectedItem="{x:Bind ViewModel.SelectedBalloon, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Visibility="{x:Bind ViewModel.ShowsBalloon, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTipService.ToolTip="Balloons are made in Settings, Balloon Icons" />
        <ComboBox Header="Arte"
                  PlaceholderText="None"
                  HorizontalAlignment="Stretch"
                  MinHeight="48"
                  ItemsSource="{x:Bind ViewModel.Artes}"
                  SelectedItem="{x:Bind ViewModel.SelectedArte, Mode=TwoWay}"
                  Visibility="{x:Bind ViewModel.ShowsArte, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="artes:Arte">
              <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="36">
                <engineIcon:EngineIcon Icon="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ContentControl HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        Content="{x:Bind ViewModel.Movement, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource MovementEditorTemplateSelector}" />
        <ComboBox Header="Target Entity"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Pick an entity"
                  ItemsSource="{x:Bind ViewModel.OtherEntities}"
                  SelectedItem="{x:Bind ViewModel.SelectedOtherEntity, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Visibility="{x:Bind ViewModel.ShowsOtherEntity, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </Grid>
  </popup:PopupShell>
</UserControl>
