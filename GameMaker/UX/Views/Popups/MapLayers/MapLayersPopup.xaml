<UserControl x:Class="GameMaker.UX.Views.Popups.MapLayers.MapLayersPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainPageModels="using:GameMaker.UX.Models.MainPage"
             xmlns:behaviors="using:GameLibrary.Behaviors"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             mc:Ignorable="d">
  <popup:PopupShell Title="Layers"
                    PrimaryButtonText="Done">
    <ScrollViewer MaxHeight="640" Padding="0,0,16,0">
      <StackPanel Width="440" Spacing="15">
        <TextBlock Text="Layers" FontWeight="Bold" />
        <TextBlock Foreground="{StaticResource LightGreyBrush}"
                   TextWrapping="Wrap"
                   Text="Images load from Graphics\Maps by map id. Everything is drawn lowest Z first, entities included." />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mainPageModels:MapLayerModel">
              <Border BorderBrush="{StaticResource LightGreyBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8"
                      ToolTipService.ToolTip="{x:Bind ToolTip}">
                <StackPanel Spacing="8">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="Bold"
                               Text="{x:Bind Name}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource LightGreyBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Bind ImageText}" />
                    <Button Grid.Column="2"
                            Padding="6,2"
                            Content="Reset"
                            Command="{x:Bind ResetCommand}"
                            ToolTipService.ToolTip="Go back to the default z, opacity and blend." />
                  </Grid>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="Z"
                               SmallChange="1"
                               SpinButtonPlacementMode="Compact"
                               Value="{x:Bind Z, Mode=TwoWay}"
                               ToolTipService.ToolTip="Draw order. Entities are drawn at their own z." />
                    <NumberBox Grid.Column="1"
                               Header="Opacity"
                               Minimum="0"
                               Maximum="1"
                               SmallChange="0.1"
                               SpinButtonPlacementMode="Compact"
                               Value="{x:Bind Opacity, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2"
                              Header="Blend"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind BlendOptions}"
                              SelectedItem="{x:Bind Blend, Mode=TwoWay}" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Environment" FontWeight="Bold" />
        <TextBlock Foreground="{StaticResource LightGreyBrush}"
                   TextWrapping="Wrap"
                   Text="Animated images from Graphics\Maps\Environment, shared by every map and tiled over the whole map." />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Environments, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mainPageModels:MapEnvironmentModel">
              <Border BorderBrush="{StaticResource LightGreyBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8"
                      ToolTipService.ToolTip="{x:Bind ToolTip}">
                <StackPanel Spacing="8">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox MinWidth="0"
                              FontWeight="Bold"
                              Content="{x:Bind Name}"
                              behaviors:PointerCursorBehavior.CursorType="Hand"
                              IsChecked="{x:Bind IsOn, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource LightGreyBrush}"
                               Text="{x:Bind ImageText}" />
                    <Button Grid.Column="2"
                            Padding="6,2"
                            Content="Reset"
                            Command="{x:Bind ResetCommand}"
                            Visibility="{x:Bind IsOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTipService.ToolTip="Go back to the default z, opacity and blend." />
                  </Grid>
                  <Grid ColumnSpacing="8"
                        Visibility="{x:Bind IsOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="Z"
                               SmallChange="1"
                               SpinButtonPlacementMode="Compact"
                               Value="{x:Bind Z, Mode=TwoWay}"
                               ToolTipService.ToolTip="Draw order. Below the ground's -1 it only shows through the ground's see-through parts." />
                    <NumberBox Grid.Column="1"
                               Header="Opacity"
                               Minimum="0"
                               Maximum="1"
                               SmallChange="0.1"
                               SpinButtonPlacementMode="Compact"
                               Value="{x:Bind Opacity, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2"
                              Header="Blend"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind BlendOptions}"
                              SelectedItem="{x:Bind Blend, Mode=TwoWay}" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </popup:PopupShell>
</UserControl>
