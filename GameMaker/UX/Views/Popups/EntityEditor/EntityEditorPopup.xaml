<UserControl x:Class="GameMaker.UX.Views.Popups.EntityEditor.EntityEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
             xmlns:entityEditor="using:GameMaker.UX.ViewModels.Popups.EntityEditor"
             xmlns:conditions="using:GameLibrary.Models.Conditions"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             xmlns:imageChooser="using:GameMaker.UX.Components.ImageChooser"
             xmlns:hitboxPreview="using:GameMaker.UX.Components.HitboxPreview"
             xmlns:markup="using:GameLibrary.MarkupExtensions"
             xmlns:enums="using:GameLibrary.Enumerations"
             mc:Ignorable="d">
  <popup:PopupShell Title="{x:Bind ViewModel.Title}"
                    PrimaryButtonText="Done">
    <Grid Width="1320"
          Height="560"
          RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>
        <TextBox Header="{x:Bind ViewModel.NameHeader}"
                 Text="{x:Bind ViewModel.EntityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <NumberBox Grid.Column="1"
                   Header="Z"
                   SmallChange="1"
                   SpinButtonPlacementMode="Compact"
                   Value="{x:Bind ViewModel.EntityZ, Mode=TwoWay}"
                   ToolTipService.ToolTip="Draw order against the map layers and other entities. The layers button shows each layer's z." />
      </Grid>

      <Grid Grid.Row="1"
            ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pages list -->
        <Grid Grid.Column="0"
              RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Pages" />
          <engineListView:EngineListView Grid.Row="1"
                                         ItemsSource="{x:Bind ViewModel.Entity.Pages, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                         NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                         NewCommandParameter="New Page"
                                         CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
        </Grid>

        <!-- Page metadata -->
        <StackPanel Grid.Column="1"
                    Width="240"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <TextBox Header="Page Name"
                   Text="{x:Bind ViewModel.SelectedPage.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Header="Trigger"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Triggers}"
                    SelectedItem="{x:Bind ViewModel.SelectedPage.PageTrigger, Mode=TwoWay}" />

          <TextBlock Text="Conditions" />
          <engineListView:EngineListView Height="200"
                                         ItemsSource="{x:Bind ViewModel.SelectedConditions, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedConditionIndex, Mode=TwoWay}"
                                         NewOptions="{x:Bind ViewModel.ConditionNewOptions}"
                                         EditCommand="{x:Bind ViewModel.EditConditionCommand}"
                                         CopyCommand="{x:Bind ViewModel.CopyConditionCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteConditionCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteConditionCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedCondition, Mode=OneWay}">
            <engineListView:EngineListView.ItemTemplate>
              <DataTemplate x:DataType="conditions:Condition">
                <TextBlock Text="{x:Bind ToString()}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </engineListView:EngineListView.ItemTemplate>
          </engineListView:EngineListView>
        </StackPanel>

        <!-- Page look: works like the face, character and hitboxes on the actors page -->
        <StackPanel Grid.Column="2"
                    Width="300"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Face Image" />
              <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.FaceFolderPath}"
                                         FileName="{x:Bind ViewModel.FaceName, Mode=TwoWay, FallbackValue=''}"
                                         Index="{x:Bind ViewModel.FaceIndex, Mode=TwoWay, FallbackValue={x:Null}}"
                                         ChooserWidth="144"
                                         ChooserHeight="144" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Text="Character Image" />
              <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.CharacterFolderPath}"
                                         FileName="{x:Bind ViewModel.CharacterName, Mode=TwoWay, FallbackValue=''}"
                                         Index="{x:Bind ViewModel.CharacterIndex, Mode=TwoWay}"
                                         OnImageChangedCommand="{x:Bind ViewModel.SelectCharacterCommand}"
                                         ChooserWidth="144"
                                         ChooserHeight="144" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="Hitboxes" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="144" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hitboxPreview:HitboxPreview Hitboxes="{x:Bind ViewModel.Hitboxes.SelectedDirectionHitboxes, Mode=TwoWay}"
                                         CharacterImage="{x:Bind ViewModel.Hitboxes.AnchorImage, Mode=OneWay}"
                                         PreviewsHitboxes="{x:Bind ViewModel.Hitboxes.PreviewsHitboxes, Mode=OneWay}"
                                         PreviewScale="{x:Bind ViewModel.Hitboxes.PreviewScale, Mode=OneWay}"
                                         PreviewOffsetX="{x:Bind ViewModel.Hitboxes.PreviewOffsetX, Mode=OneWay}"
                                         PreviewOffsetY="{x:Bind ViewModel.Hitboxes.PreviewOffsetY, Mode=OneWay}"
                                         ToolTipService.ToolTip="Pick a character image first, the hitboxes are drawn against it." />
            <StackPanel Grid.Column="1" Spacing="10">
              <ComboBox Header="Direction"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{markup:EnumValues EnumType=enums:Direction}"
                        SelectedItem="{x:Bind ViewModel.Hitboxes.SelectedDirection, Mode=TwoWay}"
                        ToolTipService.ToolTip="None hitboxes count for every direction, the others only while facing that way." />
              <CheckBox Content="Solid"
                        MinWidth="0"
                        IsChecked="{x:Bind ViewModel.Collide, Mode=TwoWay}"
                        ToolTipService.ToolTip="The player and other entities bump into this page's hitboxes." />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Action list -->
        <Grid Grid.Column="3"
              RowSpacing="6"
              Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Event Commands" VerticalAlignment="Center" />
          <engineListView:EngineListView Grid.Row="1"
                                         ItemsSource="{x:Bind ViewModel.ActionRows, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedActionRowIndex, Mode=TwoWay}"
                                         NewOptions="{x:Bind ViewModel.ActionNewOptions}"
                                         DoubleTapCommand="{x:Bind ViewModel.DoubleTapActionCommand}"
                                         EditCommand="{x:Bind ViewModel.EditActionCommand}"
                                         CopyCommand="{x:Bind ViewModel.CopyActionCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteActionCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteActionCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedAction, Mode=OneWay}">
            <engineListView:EngineListView.ItemTemplate>
              <DataTemplate x:DataType="entityEditor:ActionRow">
                <TextBlock Text="{x:Bind DisplayText}"
                           Margin="{x:Bind IndentMargin}"
                           Foreground="{x:Bind Foreground}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </engineListView:EngineListView.ItemTemplate>
          </engineListView:EngineListView>
        </Grid>
      </Grid>
    </Grid>
  </popup:PopupShell>
</UserControl>
