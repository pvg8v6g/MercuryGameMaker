<UserControl x:Class="GameMaker.UX.Views.Popups.EntityEditor.EntityEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
             xmlns:entityEditor="using:GameMaker.UX.ViewModels.Popups.EntityEditor"
             xmlns:conditions="using:GameLibrary.Models.Conditions"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             xmlns:imageChooser="using:GameMaker.UX.Components.ImageChooser"
             xmlns:hitboxPreview="using:GameMaker.UX.Components.HitboxPreview"
             xmlns:markup="using:GameLibrary.MarkupExtensions"
             xmlns:enums="using:GameLibrary.Enumerations"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:engineGlyphButton="using:GameMaker.UX.Components.EngineGlyphButton"
             mc:Ignorable="d">
  <popup:PopupShell Title="{x:Bind ViewModel.Title}"
                    PrimaryButtonText="Done">
    <Grid Width="1320"
          Height="560"
          RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Bottom"
                   Margin="0,0,0,6"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{x:Bind ViewModel.EntityIdText}"
                   ToolTipService.ToolTip="The entity's id on this map, how move routes and pages pick it. Set by the map." />
        <TextBox Grid.Column="1"
                 Header="{x:Bind ViewModel.NameHeader}"
                 Text="{x:Bind ViewModel.EntityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <NumberBox Grid.Column="2"
                   Header="Z"
                   SmallChange="1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind ViewModel.EntityZ, Mode=TwoWay}"
                   ToolTipService.ToolTip="Draw order against the map layers and other entities. The layers button shows each layer's z." />
      </Grid>

      <Grid Grid.Row="1"
            ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pages list -->
        <Grid Grid.Column="0"
              RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Pages" />
          <engineListView:EngineListView Grid.Row="1"
                                         ItemsSource="{x:Bind ViewModel.Entity.Pages, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                         NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                         NewCommandParameter="New Page"
                                         CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
        </Grid>

        <!-- Page metadata -->
        <StackPanel Grid.Column="1"
                    Width="240"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <TextBox Header="Page Name"
                   Text="{x:Bind ViewModel.SelectedPage.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Header="Trigger"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Triggers}"
                    SelectedItem="{x:Bind ViewModel.SelectedPage.PageTrigger, Mode=TwoWay}" />
          <CheckBox Content="Remembers Position"
                    IsChecked="{x:Bind ViewModel.SelectedPage.RemembersPosition, Mode=TwoWay, FallbackValue=True}"
                    ToolTipService.ToolTip="Leaving the map and coming back finds the entity where it was, facing the same way. Off: it's back where it was placed." />
          <!-- the page's modules, one icon button each with its settings in a flyout -->
          <StackPanel Orientation="Horizontal"
                      Spacing="6">
            <!-- movement: a module on the page, without it the entity never walks -->
            <engineGlyphButton:EngineGlyphButton Glyph="&#xE805;"
                                                 ToolTipService.ToolTip="Movement: lets this page's entity walk (move routes, patrols) and sets how it walks.">
            <Button.Flyout>
              <Flyout Placement="Right">
                <StackPanel Width="320"
                            Spacing="10">
                  <CheckBox Content="Moves"
                            IsChecked="{x:Bind ViewModel.Moves, Mode=TwoWay}"
                            ToolTipService.ToolTip="This page can walk. Off: move routes and patrols never move it." />
                  <StackPanel Spacing="10"
                              Visibility="{x:Bind ViewModel.Moves, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <engineTextBox:EngineTextBox Header="Speed"
                                                 InputType="Integer"
                                                 Text="{x:Bind ViewModel.Movement.Speed, Mode=TwoWay, FallbackValue='4', UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTipService.ToolTip="Walking speed, the player walks at 8. Patrols and the Set Speed route step change it while they run." />
                    <CheckBox Content="Steps While Walking"
                              IsChecked="{x:Bind ViewModel.Movement.Stepping, Mode=TwoWay, FallbackValue=True}"
                              ToolTipService.ToolTip="Its feet animate as it walks. Off: it slides." />
                    <CheckBox Content="Steps In Place"
                              IsChecked="{x:Bind ViewModel.Movement.AutoStepping, Mode=TwoWay, FallbackValue=False}"
                              ToolTipService.ToolTip="Its feet animate even standing still, like a flame or a bird flapping." />
                    <CheckBox Content="Fix Direction"
                              IsChecked="{x:Bind ViewModel.Movement.FixDirection, Mode=TwoWay, FallbackValue=False}"
                              ToolTipService.ToolTip="It keeps facing the same way however it moves or is spoken to." />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            </engineGlyphButton:EngineGlyphButton>

          <!-- patrol and chase: a module on the page, its settings in a panel so the editor stays the same size -->
            <engineGlyphButton:EngineGlyphButton Glyph="&#xEA18;"
                                                 ToolTipService.ToolTip="Patrol &amp; Chase: walk a patrol path or wander a zone, chase the player on sight. Walking into the player runs this page's event touch.">
            <Button.Flyout>
              <Flyout Placement="Right">
                <StackPanel Width="320"
                            Spacing="10">
                  <CheckBox Content="Patrols"
                            IsChecked="{x:Bind ViewModel.Patrols, Mode=TwoWay}"
                            ToolTipService.ToolTip="This page patrols. Off removes the patrol from the page." />
                  <StackPanel Spacing="10"
                              Visibility="{x:Bind ViewModel.Patrols, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox Header="Patrol Path"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.PathNames}"
                              SelectedItem="{x:Bind ViewModel.PatrolPathName, Mode=TwoWay}"
                              ToolTipService.ToolTip="A patrol path on this map, drawn with the Paths tool" />
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ComboBox Header="Or Zone (area)"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.ZoneNames}"
                                SelectedItem="{x:Bind ViewModel.PatrolZoneName, Mode=TwoWay}"
                                ToolTipService.ToolTip="With no path: wander between random spots inside this named area. With neither it stands guard." />
                      <Grid Grid.Column="1">
                <engineTextBox:EngineTextBox Header="Start Point"
                                             InputType="Integer"
                                             Text="{x:Bind ViewModel.Patrol.StartPoint, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}"
                                             ToolTipService.ToolTip="The path point it starts from, 1 is the first" />
                      </Grid>
                    </Grid>
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                <engineTextBox:EngineTextBox Header="Patrol Speed"
                                             InputType="Integer"
                                             Text="{x:Bind ViewModel.Patrol.PatrolSpeed, Mode=TwoWay, FallbackValue='4', UpdateSourceTrigger=PropertyChanged}"
                                             ToolTipService.ToolTip="Walking speed on patrol, the player walks at 8" />
                      <Grid Grid.Column="1">
                <engineTextBox:EngineTextBox Header="Chase Speed"
                                             InputType="Integer"
                                             Text="{x:Bind ViewModel.Patrol.ChaseSpeed, Mode=TwoWay, FallbackValue='8', UpdateSourceTrigger=PropertyChanged}"
                                             ToolTipService.ToolTip="Speed while chasing" />
                      </Grid>
                    </Grid>
                    <CheckBox Content="Chases The Player"
                              IsChecked="{x:Bind ViewModel.Patrol.Chases, Mode=TwoWay, FallbackValue=False}" />
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                <engineTextBox:EngineTextBox Header="Sight (tiles)"
                                             InputType="Integer"
                                             Text="{x:Bind ViewModel.Patrol.SightRange, Mode=TwoWay, FallbackValue='5', UpdateSourceTrigger=PropertyChanged}"
                                             ToolTipService.ToolTip="How far it sees. Walls and props block its view." />
                      <CheckBox Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Content="Sees All Around"
                                IsChecked="{x:Bind ViewModel.Patrol.SeesAllAround, Mode=TwoWay, FallbackValue=False}"
                                ToolTipService.ToolTip="Off: it only sees what's in front of it" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                <engineTextBox:EngineTextBox Header="Lose Sight (ms)"
                                             InputType="Integer"
                                             Text="{x:Bind ViewModel.Patrol.LoseSightTime, Mode=TwoWay, FallbackValue='3000', UpdateSourceTrigger=PropertyChanged}"
                                             ToolTipService.ToolTip="How long without seeing the player before it gives up" />
                      <Grid Grid.Column="1">
                <engineTextBox:EngineTextBox Header="Chase Limit (ms)"
                                             InputType="Integer"
                                             Text="{x:Bind ViewModel.Patrol.ChaseTimeLimit, Mode=TwoWay, FallbackValue='15000', UpdateSourceTrigger=PropertyChanged}"
                                             ToolTipService.ToolTip="Longest a chase lasts before it gives up, 0 is no limit" />
                      </Grid>
                    </Grid>
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ComboBox Header="Spot Balloon"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.BalloonChoices}"
                                SelectedItem="{x:Bind ViewModel.SpotBalloon, Mode=TwoWay}"
                                DisplayMemberPath="Name"
                                ToolTipService.ToolTip="The balloon played over its head when it spots the player. Balloons are made in Settings, Balloon Icons." />
                      <Grid Grid.Column="1">
                <engineTextBox:EngineTextBox Header="Spot Pause (ms)"
                                             InputType="Integer"
                                             Text="{x:Bind ViewModel.Patrol.SpotPause, Mode=TwoWay, FallbackValue='500', UpdateSourceTrigger=PropertyChanged}"
                                             ToolTipService.ToolTip="How long it stands still after spotting the player" />
                      </Grid>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            </engineGlyphButton:EngineGlyphButton>
          </StackPanel>

          <TextBlock Text="Conditions" />
          <engineListView:EngineListView Height="200"
                                         ItemsSource="{x:Bind ViewModel.SelectedConditions, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedConditionIndex, Mode=TwoWay}"
                                         NewOptions="{x:Bind ViewModel.ConditionNewOptions}"
                                         EditCommand="{x:Bind ViewModel.EditConditionCommand}"
                                         CopyCommand="{x:Bind ViewModel.CopyConditionCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteConditionCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteConditionCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedCondition, Mode=OneWay}">
            <engineListView:EngineListView.ItemTemplate>
              <DataTemplate x:DataType="conditions:Condition">
                <TextBlock Text="{x:Bind ToString()}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </engineListView:EngineListView.ItemTemplate>
          </engineListView:EngineListView>
        </StackPanel>

        <!-- Page look: works like the face, character and hitboxes on the actors page -->
        <StackPanel Grid.Column="2"
                    Width="300"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Face Image" />
              <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.FaceFolderPath}"
                                         FileName="{x:Bind ViewModel.FaceName, Mode=TwoWay, FallbackValue=''}"
                                         Index="{x:Bind ViewModel.FaceIndex, Mode=TwoWay, FallbackValue={x:Null}}"
                                         ChooserWidth="144"
                                         ChooserHeight="144" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Text="Character Image" />
              <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.CharacterFolderPath}"
                                         FileName="{x:Bind ViewModel.CharacterName, Mode=TwoWay, FallbackValue=''}"
                                         Index="{x:Bind ViewModel.CharacterIndex, Mode=TwoWay}"
                                         OnImageChangedCommand="{x:Bind ViewModel.SelectCharacterCommand}"
                                         ChooserWidth="144"
                                         ChooserHeight="144" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="Hitboxes" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="144" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hitboxPreview:HitboxPreview Hitboxes="{x:Bind ViewModel.Hitboxes.SelectedDirectionHitboxes, Mode=TwoWay}"
                                         CharacterImage="{x:Bind ViewModel.Hitboxes.AnchorImage, Mode=OneWay}"
                                         PreviewsHitboxes="{x:Bind ViewModel.Hitboxes.PreviewsHitboxes, Mode=OneWay}"
                                         PreviewScale="{x:Bind ViewModel.Hitboxes.PreviewScale, Mode=OneWay}"
                                         PreviewOffsetX="{x:Bind ViewModel.Hitboxes.PreviewOffsetX, Mode=OneWay}"
                                         PreviewOffsetY="{x:Bind ViewModel.Hitboxes.PreviewOffsetY, Mode=OneWay}"
                                         ToolTipService.ToolTip="Pick a character image first, the hitboxes are drawn against it." />
            <StackPanel Grid.Column="1" Spacing="10">
              <ComboBox Header="Direction"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{markup:EnumValues EnumType=enums:Direction}"
                        SelectedItem="{x:Bind ViewModel.Hitboxes.SelectedDirection, Mode=TwoWay}"
                        ToolTipService.ToolTip="None hitboxes count for every direction, the others only while facing that way." />
              <CheckBox Content="Solid"
                        MinWidth="0"
                        IsChecked="{x:Bind ViewModel.Collide, Mode=TwoWay}"
                        ToolTipService.ToolTip="The player and other entities bump into this page's hitboxes." />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Action list -->
        <Grid Grid.Column="3"
              RowSpacing="6"
              Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Event Commands" VerticalAlignment="Center" />
          <engineListView:EngineListView Grid.Row="1"
                                         ItemsSource="{x:Bind ViewModel.ActionRows, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedActionRowIndex, Mode=TwoWay}"
                                         NewOptions="{x:Bind ViewModel.ActionNewOptions}"
                                         DoubleTapCommand="{x:Bind ViewModel.DoubleTapActionCommand}"
                                         EditCommand="{x:Bind ViewModel.EditActionCommand}"
                                         CopyCommand="{x:Bind ViewModel.CopyActionCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteActionCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteActionCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedAction, Mode=OneWay}">
            <engineListView:EngineListView.ItemTemplate>
              <DataTemplate x:DataType="entityEditor:ActionRow">
                <TextBlock Text="{x:Bind DisplayText}"
                           Margin="{x:Bind IndentMargin}"
                           Foreground="{x:Bind Foreground}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </engineListView:EngineListView.ItemTemplate>
          </engineListView:EngineListView>
        </Grid>
      </Grid>
    </Grid>
  </popup:PopupShell>
</UserControl>
