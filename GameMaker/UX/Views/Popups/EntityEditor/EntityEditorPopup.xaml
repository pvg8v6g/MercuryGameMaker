<UserControl x:Class="GameMaker.UX.Views.Popups.EntityEditor.EntityEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
             xmlns:entityEditor="using:GameMaker.UX.ViewModels.Popups.EntityEditor"
             xmlns:conditions="using:GameLibrary.Models.Conditions"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             mc:Ignorable="d">
  <popup:PopupShell Title="Projectile Editor"
                    PrimaryButtonText="Done">
    <Grid Width="1000"
          Height="560"
          RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBox Grid.Row="0"
               Header="Projectile Name"
               Text="{x:Bind ViewModel.EntityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <Grid Grid.Row="1"
            ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pages list -->
        <Grid Grid.Column="0"
              RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Pages" />
          <engineListView:EngineListView Grid.Row="1"
                                         ItemsSource="{x:Bind ViewModel.Entity.Pages, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                         NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                         NewCommandParameter="New Page"
                                         CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
        </Grid>

        <!-- Page metadata -->
        <StackPanel Grid.Column="1"
                    Width="240"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <TextBox Header="Page Name"
                   Text="{x:Bind ViewModel.SelectedPage.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Header="Trigger"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Triggers}"
                    SelectedItem="{x:Bind ViewModel.SelectedPage.PageTrigger, Mode=TwoWay}" />

          <TextBlock Text="Conditions" />
          <engineListView:EngineListView Height="200"
                                         ItemsSource="{x:Bind ViewModel.SelectedConditions, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedConditionIndex, Mode=TwoWay}"
                                         NewOptions="{x:Bind ViewModel.ConditionNewOptions}"
                                         EditCommand="{x:Bind ViewModel.EditConditionCommand}"
                                         CopyCommand="{x:Bind ViewModel.CopyConditionCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteConditionCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteConditionCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedCondition, Mode=OneWay}">
            <engineListView:EngineListView.ItemTemplate>
              <DataTemplate x:DataType="conditions:Condition">
                <TextBlock Text="{x:Bind ToString()}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </engineListView:EngineListView.ItemTemplate>
          </engineListView:EngineListView>
        </StackPanel>

        <!-- Action list -->
        <Grid Grid.Column="2"
              RowSpacing="6"
              Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Event Commands" VerticalAlignment="Center" />
          <engineListView:EngineListView Grid.Row="1"
                                         ItemsSource="{x:Bind ViewModel.ActionRows, Mode=OneWay}"
                                         SelectedIndex="{x:Bind ViewModel.SelectedActionRowIndex, Mode=TwoWay}"
                                         NewOptions="{x:Bind ViewModel.ActionNewOptions}"
                                         DoubleTapCommand="{x:Bind ViewModel.DoubleTapActionCommand}"
                                         EditCommand="{x:Bind ViewModel.EditActionCommand}"
                                         CopyCommand="{x:Bind ViewModel.CopyActionCommand}"
                                         PasteCommand="{x:Bind ViewModel.PasteActionCommand}"
                                         DeleteCommand="{x:Bind ViewModel.DeleteActionCommand}"
                                         CopiedModel="{x:Bind ViewModel.CopiedAction, Mode=OneWay}">
            <engineListView:EngineListView.ItemTemplate>
              <DataTemplate x:DataType="entityEditor:ActionRow">
                <TextBlock Text="{x:Bind DisplayText}"
                           Margin="{x:Bind IndentMargin}"
                           Foreground="{x:Bind Foreground}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </engineListView:EngineListView.ItemTemplate>
          </engineListView:EngineListView>
        </Grid>
      </Grid>
    </Grid>
  </popup:PopupShell>
</UserControl>
