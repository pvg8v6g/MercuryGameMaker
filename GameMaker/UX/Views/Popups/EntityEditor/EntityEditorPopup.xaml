<ContentDialog x:Class="GameMaker.UX.Views.Popups.EntityEditor.EntityEditorPopup"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
               xmlns:actions="using:GameLibrary.Models.Actions"
               xmlns:conditions="using:GameLibrary.Models.Conditions"
               xmlns:modules="using:GameLibrary.Models.Modules"
               mc:Ignorable="d"
               Title="Projectile Editor"
               Background="{StaticResource PrimaryBrush}"
               PrimaryButtonText="Done"
               DefaultButton="Primary">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
  </ContentDialog.Resources>
  <Grid Width="1000"
        Height="560"
        RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBox Grid.Row="0"
             Header="Projectile Name"
             Text="{x:Bind ViewModel.EntityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    <Grid Grid.Row="1"
          ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Pages list -->
      <Grid Grid.Column="0"
            RowSpacing="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Pages" />
        <engineListView:EngineListView Grid.Row="1"
                                       ItemsSource="{x:Bind ViewModel.Entity.Pages, Mode=OneWay}"
                                       SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                       NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                       NewCommandParameter="New Page"
                                       CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                       PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                       DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                       CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
      </Grid>

      <!-- Page metadata -->
      <StackPanel Grid.Column="1"
                  Width="240"
                  Spacing="10"
                  Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
        <TextBox Header="Page Name"
                 Text="{x:Bind ViewModel.SelectedPage.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
        <ComboBox Header="Trigger"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.Triggers}"
                  SelectedItem="{x:Bind ViewModel.SelectedPage.PageTrigger, Mode=TwoWay}" />

        <TextBlock Text="Conditions" />
        <ListView x:Name="ConditionsList"
                  Height="160"
                  Background="{StaticResource MediumGreyBrush}"
                  ItemsSource="{x:Bind ViewModel.SelectedConditions, Mode=OneWay}"
                  SelectedIndex="{x:Bind ViewModel.SelectedConditionIndex, Mode=TwoWay}"
                  SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="conditions:Condition">
              <TextBlock Text="{x:Bind ToString()}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <Button Content="Delete Condition"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.DeleteConditionCommand}" />

        <TextBlock Text="Modules" />
        <ListView Height="120"
                  Background="{StaticResource MediumGreyBrush}"
                  ItemsSource="{x:Bind ViewModel.SelectedModules, Mode=OneWay}"
                  SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="modules:Module">
              <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>

      <!-- Action list -->
      <Grid Grid.Column="2"
            RowSpacing="6"
            Visibility="{x:Bind ViewModel.SelectedPage, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Event Commands" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Add Command">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Set Movement Route" Command="{x:Bind ViewModel.AddMovementRouteCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Content="Edit" Command="{x:Bind ViewModel.EditActionCommand}" />
          </StackPanel>
        </Grid>
        <ListView Grid.Row="1"
                  Background="{StaticResource MediumGreyBrush}"
                  ItemsSource="{x:Bind ViewModel.SelectedActions, Mode=OneWay}"
                  SelectedIndex="{x:Bind ViewModel.SelectedActionIndex, Mode=TwoWay}"
                  SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="actions:PageAction">
              <TextBlock Text="{x:Bind ToString()}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Row="2"
                Content="Delete Command"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.DeleteActionCommand}" />
      </Grid>
    </Grid>
  </Grid>
</ContentDialog>
