<ContentDialog x:Class="GameMaker.UX.Views.Popups.AnimationEffects.AnimationEffectsPopup"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:mercury="using:MercuryLibrary.CanvasComponents"
               mc:Ignorable="d"
               Title="Frame Effects"
               Background="{StaticResource PrimaryBrush}"
               PrimaryButtonText="Done"
               DefaultButton="Primary">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
  </ContentDialog.Resources>
  <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="480" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Width="{x:Bind ViewModel.PreviewSize}"
            Height="{x:Bind ViewModel.PreviewSize}"
            VerticalAlignment="Top"
            Background="{StaticResource MediumGreyBrush}">
      <mercury:GameCanvasView UpdateRate="16.66666667"
                              Sprites="{x:Bind ViewModel.Sprites, Mode=OneWay}" />
    </Border>

    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  Padding="0 0 16 0">
      <StackPanel Spacing="10">
        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox Grid.Column="0"
                     Header="X"
                     Width="160"
                     Value="{x:Bind ViewModel.Effect.X, Mode=TwoWay}"
                     SmallChange="1"
                     SpinButtonPlacementMode="Inline" />
          <NumberBox Grid.Column="1"
                     Header="Y"
                     Width="160"
                     Value="{x:Bind ViewModel.Effect.Y, Mode=TwoWay}"
                     SmallChange="1"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox Grid.Column="0"
                     Header="Scale X"
                     Width="160"
                     Value="{x:Bind ViewModel.Effect.ScaleX, Mode=TwoWay}"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline" />
          <NumberBox Grid.Column="1"
                     Header="Scale Y"
                     Width="160"
                     Value="{x:Bind ViewModel.Effect.ScaleY, Mode=TwoWay}"
                     SmallChange="0.1"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <TextBlock Text="Rotate" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Minimum="-360"
                  Maximum="360"
                  StepFrequency="1"
                  TickFrequency="45"
                  Value="{x:Bind ViewModel.RotateValue, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Width="160"
                     Minimum="-360"
                     Maximum="360"
                     SmallChange="1"
                     Value="{x:Bind ViewModel.RotateValue, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <TextBlock Text="Opacity" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Minimum="0"
                  Maximum="1"
                  StepFrequency="0.01"
                  Value="{x:Bind ViewModel.Effect.Opacity, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Width="160"
                     Minimum="0"
                     Maximum="1"
                     SmallChange="0.01"
                     Value="{x:Bind ViewModel.Effect.Opacity, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <TextBlock Text="Hue" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Minimum="-1"
                  Maximum="1"
                  StepFrequency="0.01"
                  Value="{x:Bind ViewModel.Effect.Hue, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Width="160"
                     Minimum="-1"
                     Maximum="1"
                     SmallChange="0.01"
                     Value="{x:Bind ViewModel.Effect.Hue, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <TextBlock Text="Saturation" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Minimum="-1"
                  Maximum="1"
                  StepFrequency="0.01"
                  Value="{x:Bind ViewModel.Effect.Saturation, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Width="160"
                     Minimum="-1"
                     Maximum="1"
                     SmallChange="0.01"
                     Value="{x:Bind ViewModel.Effect.Saturation, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <TextBlock Text="Contrast" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Minimum="-1"
                  Maximum="1"
                  StepFrequency="0.01"
                  Value="{x:Bind ViewModel.Effect.Contrast, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Width="160"
                     Minimum="-1"
                     Maximum="1"
                     SmallChange="0.01"
                     Value="{x:Bind ViewModel.Effect.Contrast, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <TextBlock Text="Brightness" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Slider Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Minimum="-1"
                  Maximum="1"
                  StepFrequency="0.01"
                  Value="{x:Bind ViewModel.Effect.Brightness, Mode=TwoWay}" />
          <NumberBox Grid.Column="1"
                     Width="160"
                     Minimum="-1"
                     Maximum="1"
                     SmallChange="0.01"
                     Value="{x:Bind ViewModel.Effect.Brightness, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <ComboBox Header="Blend Mode"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.BlendModes}"
                  SelectedItem="{x:Bind ViewModel.Effect.BlendMode, Mode=TwoWay}" />

        <ComboBox Header="Sound Effect"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.SfxFiles}"
                  SelectedItem="{x:Bind ViewModel.SelectedSfx, Mode=TwoWay}" />

        <Grid ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox Grid.Column="0"
                     Header="SFX Volume"
                     Minimum="0"
                     SmallChange="0.1"
                     IsEnabled="{x:Bind ViewModel.IsSfxSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.SfxVolume, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
          <NumberBox Grid.Column="1"
                     Header="SFX Pitch"
                     Minimum="0"
                     SmallChange="0.1"
                     IsEnabled="{x:Bind ViewModel.IsSfxSelected, Mode=OneWay}"
                     Value="{x:Bind ViewModel.SfxPitch, Mode=TwoWay}"
                     SpinButtonPlacementMode="Inline" />
        </Grid>

        <Button Content="Preview Sound"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.PreviewSfxCommand}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ContentDialog>
