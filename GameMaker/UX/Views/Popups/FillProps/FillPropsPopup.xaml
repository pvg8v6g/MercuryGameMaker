<UserControl x:Class="GameMaker.UX.Views.Popups.FillProps.FillPropsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fill="using:GameMaker.UX.ViewModels.Popups.FillProps"
             xmlns:props="using:GameLibrary.Models.Props"
             xmlns:behaviors="using:GameLibrary.Behaviors"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             mc:Ignorable="d">
  <popup:PopupShell Title="Fill Props"
                    PrimaryButtonText="Fill"
                    SecondaryButtonText="Cancel">
    <Grid Width="980" Height="600" ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- the fill sets: Forest, Desert, Snow... -->
      <Grid RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Fill Sets" FontWeight="Bold" />
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.FillSets}"
                  SelectedItem="{x:Bind ViewModel.SelectedFillSet, Mode=TwoWay}"
                  DisplayMemberPath="Name" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <Button Content="New"
                  Command="{x:Bind ViewModel.NewFillSetCommand}"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  ToolTipService.ToolTip="A new fill set, for a kind of place (forest, desert, snow, farm)" />
          <Button Content="Delete"
                  Command="{x:Bind ViewModel.DeleteFillSetCommand}"
                  IsEnabled="{x:Bind ViewModel.HasFillSet, Mode=OneWay}"
                  behaviors:PointerCursorBehavior.CursorType="Hand" />
        </StackPanel>
      </Grid>

      <!-- the selected set's rules -->
      <Grid Grid.Column="1"
            RowSpacing="10"
            Visibility="{x:Bind ViewModel.HasFillSet, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBox Header="Name"
                   Width="260"
                   Text="{x:Bind ViewModel.SelectedFillSet.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="Add Rule"
                  VerticalAlignment="Bottom"
                  Command="{x:Bind ViewModel.AddRuleCommand}"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  ToolTipService.ToolTip="Rules run top to bottom, each keeps clear of what is already placed" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{x:Bind ViewModel.Rules}">
            <ItemsControl.ItemContainerTransitions>
              <TransitionCollection />
            </ItemsControl.ItemContainerTransitions>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="fill:FillRuleModel">
                <Border Margin="0,0,12,12"
                        Padding="12"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{StaticResource LightGreyBrush}">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBox Header="Rule"
                               Width="170"
                               Text="{x:Bind Rule.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <ComboBox Header="Where"
                                Width="170"
                                ItemsSource="{x:Bind Places}"
                                SelectedItem="{x:Bind Place, Mode=TwoWay}"
                                ToolTipService.ToolTip="Unpassable: inside collision areas. Open: walkable ground. NearUnpassable: walkable ground next to collision. InsideArea: inside the map areas with the name below." />
                      <ComboBox Header="Area"
                                Width="150"
                                ItemsSource="{x:Bind AreaNames}"
                                SelectedItem="{x:Bind Rule.AreaName, Mode=TwoWay}"
                                Visibility="{x:Bind IsInsideArea, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTipService.ToolTip="The named areas on this map (Areas mode, type Area)" />
                      <StackPanel Spacing="4">
                        <TextBlock Text="Ground colour" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBox Width="100"
                                   PlaceholderText="any"
                                   Text="{x:Bind GroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTipService.ToolTip="Only where the ground image is close to this colour, like #D8C08A for sand. Empty: any ground." />
                          <Border Width="28"
                                  Height="28"
                                  CornerRadius="4"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource LightGreyBrush}"
                                  Background="{x:Bind Swatch, Mode=OneWay}" />
                        </StackPanel>
                      </StackPanel>
                      <NumberBox Header="Tolerance"
                                 Width="90"
                                 Minimum="0"
                                 Maximum="255"
                                 Value="{x:Bind ColorTolerance, Mode=TwoWay}"
                                 ToolTipService.ToolTip="How far from the ground colour still counts" />
                      <Button Content="Remove"
                              VerticalAlignment="Bottom"
                              Command="{x:Bind RemoveCommand}"
                              behaviors:PointerCursorBehavior.CursorType="Hand" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Slider Header="Density"
                              Width="240"
                              Minimum="0"
                              Maximum="100"
                              Value="{x:Bind Density, Mode=TwoWay}"
                              ToolTipService.ToolTip="How full the place gets, 100 packs it as tight as the spacing allows" />
                      <NumberBox Header="Spacing (px)"
                                 Width="110"
                                 Minimum="4"
                                 Maximum="1000"
                                 SpinButtonPlacementMode="Inline"
                                 Value="{x:Bind Spacing, Mode=TwoWay}"
                                 ToolTipService.ToolTip="How close two of these props stand" />
                      <NumberBox Header="Clump"
                                 Width="90"
                                 Minimum="1"
                                 Maximum="20"
                                 SpinButtonPlacementMode="Inline"
                                 Value="{x:Bind ClumpSize, Mode=TwoWay}"
                                 ToolTipService.ToolTip="Props placed together in a group (flowers), 1 for single props" />
                    </StackPanel>

                    <TextBlock Text="Picks at random from:" />
                    <ItemsControl ItemsSource="{x:Bind Pool}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fill:PoolItemModel">
                          <ToggleButton Width="84"
                                        Height="84"
                                        Margin="0,0,6,6"
                                        Padding="4"
                                        IsChecked="{x:Bind IsInPool, Mode=TwoWay}"
                                        ToolTipService.ToolTip="{x:Bind Choice.Name}"
                                        behaviors:PointerCursorBehavior.CursorType="Hand">
                            <StackPanel>
                              <Image Source="{x:Bind Choice.Image}"
                                     Height="56"
                                     Stretch="Uniform" />
                              <TextBlock Text="{x:Bind Choice.Name}"
                                         FontSize="10"
                                         TextTrimming="CharacterEllipsis"
                                         HorizontalAlignment="Center" />
                            </StackPanel>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
          <NumberBox Header="Seed"
                     Width="140"
                     Minimum="1"
                     Value="{x:Bind ViewModel.Seed, Mode=TwoWay}"
                     ToolTipService.ToolTip="The same seed always gives the same layout" />
          <Button Content="Shuffle"
                  VerticalAlignment="Bottom"
                  Command="{x:Bind ViewModel.ShuffleCommand}"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  ToolTipService.ToolTip="A new random seed" />
          <CheckBox Content="Clear the map's props first"
                    VerticalAlignment="Bottom"
                    IsChecked="{x:Bind ViewModel.ClearFirst, Mode=TwoWay}" />
          <TextBlock VerticalAlignment="Bottom"
                     Margin="0,0,0,6"
                     Foreground="{StaticResource LightGreyBrush}">
            <Run Text="Fills" />
            <Run Text="{x:Bind ViewModel.MapName}" FontWeight="Bold" />
          </TextBlock>
        </StackPanel>
      </Grid>
    </Grid>
  </popup:PopupShell>
</UserControl>
