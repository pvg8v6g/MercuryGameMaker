<UserControl x:Class="GameMaker.UX.Views.Popups.MapIdConflict.MapIdConflictPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainPageModels="using:GameMaker.UX.Models.MainPage"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             mc:Ignorable="d">
  <popup:PopupShell Title="Map Id Taken"
                    PrimaryButtonText="Done"
                    SecondaryButtonText="Cancel">
    <StackPanel Width="400" Spacing="15">
      <TextBlock TextWrapping="Wrap"
                 Foreground="{StaticResource LightGreyBrush}"
                 Text="{x:Bind ViewModel.Message, Mode=OneWay}" />

      <ItemsControl ItemsSource="{x:Bind ViewModel.Maps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="mainPageModels:MapIdModel">
            <Border BorderBrush="{StaticResource LightGreyBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind Name}" />
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <engineTextBox:EngineTextBox Header="Id"
                                               InputType="Integer"
                                               UpdateTrigger="LostFocus"
                                               Text="{x:Bind Id, Mode=TwoWay}"
                                               Tooltip="Press enter or click away to apply." />
                  <Button Grid.Column="1"
                          VerticalAlignment="Bottom"
                          Content="Next Free"
                          Command="{x:Bind NextIdCommand}"
                          ToolTipService.ToolTip="Use the lowest id no other map has." />
                </Grid>
                <TextBlock Foreground="{StaticResource RedBrush}"
                           Text="Another map already has this id."
                           Visibility="{x:Bind IsTaken, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </popup:PopupShell>
</UserControl>
