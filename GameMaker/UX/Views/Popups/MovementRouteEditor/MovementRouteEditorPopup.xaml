<ContentDialog x:Class="GameMaker.UX.Views.Popups.MovementRouteEditor.MovementRouteEditorPopup"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:movements="using:GameLibrary.Models.Movements"
               mc:Ignorable="d"
               Title="Movement Route"
               Background="{StaticResource PrimaryBrush}"
               PrimaryButtonText="Done"
               DefaultButton="Primary">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
  </ContentDialog.Resources>
  <Grid Width="620"
        Height="520"
        RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="20">
      <CheckBox Content="Wait For Completion" IsChecked="{x:Bind ViewModel.WaitForCompletion, Mode=TwoWay}" />
      <CheckBox Content="Skip If Cannot Move" IsChecked="{x:Bind ViewModel.SkipIfInterrupted, Mode=TwoWay}" />
      <CheckBox Content="Repeat" IsChecked="{x:Bind ViewModel.Repeat, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
      <Button Content="Add Movement">
        <Button.Flyout>
          <MenuFlyout>
            <MenuFlyoutSubItem Text="Move">
              <MenuFlyoutItem Text="Move Once" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Move" />
              <MenuFlyoutItem Text="Move Random" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="MoveRandom" />
              <MenuFlyoutItem Text="Move Toward" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="MoveToward" />
              <MenuFlyoutItem Text="Move Away" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="MoveAway" />
              <MenuFlyoutItem Text="1 Step Forward" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="StepForward" />
              <MenuFlyoutItem Text="1 Step Backward" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="StepAway" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="Turn">
              <MenuFlyoutItem Text="Turn" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Turn" />
              <MenuFlyoutItem Text="Turn Random" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="TurnRandom" />
              <MenuFlyoutItem Text="Turn 180" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Turn180" />
              <MenuFlyoutItem Text="Turn Toward" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="TurnToward" />
              <MenuFlyoutItem Text="Turn Away" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="TurnAway" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="Appearance">
              <MenuFlyoutItem Text="Set Speed" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Speed" />
              <MenuFlyoutItem Text="Set Opacity" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Opacity" />
              <MenuFlyoutItem Text="Set Blend Mode" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Blend" />
              <MenuFlyoutItem Text="Set Character Image" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="CharacterImage" />
              <MenuFlyoutItem Text="Stepping Animation" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Stepping" />
              <MenuFlyoutItem Text="Direction Fix" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="DirectionFix" />
              <MenuFlyoutItem Text="Through" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Through" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Wait" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Wait" />
            <MenuFlyoutItem Text="Detonate" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="Detonate" />
            <MenuFlyoutItem Text="Activate Arte" Command="{x:Bind ViewModel.AddMovementCommand}" CommandParameter="ActivateArte" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button Content="Edit" Command="{x:Bind ViewModel.EditMovementCommand}" />
      <Button Content="Copy" Command="{x:Bind ViewModel.CopyMovementCommand}" />
      <Button Content="Paste" Command="{x:Bind ViewModel.PasteMovementCommand}" />
      <Button Content="Delete" Command="{x:Bind ViewModel.DeleteMovementCommand}" />
    </StackPanel>

    <ListView Grid.Row="2"
              Background="{StaticResource MediumGreyBrush}"
              ItemsSource="{x:Bind ViewModel.Route, Mode=OneWay}"
              SelectedIndex="{x:Bind ViewModel.SelectedMovementIndex, Mode=TwoWay}"
              SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="movements:Movement">
          <TextBlock Text="{x:Bind ToString()}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</ContentDialog>
