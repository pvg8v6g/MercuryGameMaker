<UserControl x:Class="GameMaker.UX.Views.Popups.MovementRouteEditor.MovementRouteEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:movements="using:GameLibrary.Models.Movements"
             xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             mc:Ignorable="d">
  <popup:PopupShell Title="Movement Route"
                    PrimaryButtonText="Done">
  <Grid Width="620"
        Height="520"
        RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="20">
      <CheckBox Content="Wait For Completion" IsChecked="{x:Bind ViewModel.WaitForCompletion, Mode=TwoWay}" />
      <CheckBox Content="Skip If Cannot Move" IsChecked="{x:Bind ViewModel.SkipIfInterrupted, Mode=TwoWay}" />
      <CheckBox Content="Repeat" IsChecked="{x:Bind ViewModel.Repeat, Mode=TwoWay}" />
    </StackPanel>

    <engineListView:EngineListView Grid.Row="1"
                                   ItemsSource="{x:Bind ViewModel.Route, Mode=OneWay}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedMovementIndex, Mode=TwoWay}"
                                   NewOptions="{x:Bind ViewModel.MovementNewOptions}"
                                   EditCommand="{x:Bind ViewModel.EditMovementCommand}"
                                   CopyCommand="{x:Bind ViewModel.CopyMovementCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteMovementCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteMovementCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedMovement, Mode=OneWay}">
      <engineListView:EngineListView.ItemTemplate>
        <DataTemplate x:DataType="movements:Movement">
          <TextBlock Text="{x:Bind ToString()}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </engineListView:EngineListView.ItemTemplate>
    </engineListView:EngineListView>
  </Grid>
  </popup:PopupShell>
</UserControl>
