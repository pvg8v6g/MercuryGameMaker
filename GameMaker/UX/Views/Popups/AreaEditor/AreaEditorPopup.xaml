<UserControl x:Class="GameMaker.UX.Views.Popups.AreaEditor.AreaEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainPageModels="using:GameMaker.UX.Models.MainPage"
             xmlns:behaviors="using:GameLibrary.Behaviors"
             xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
             xmlns:popup="using:GameMaker.UX.Components.Popup"
             mc:Ignorable="d">
  <popup:PopupShell Title="Area"
                    PrimaryButtonText="Done">
    <StackPanel Width="380" Spacing="15">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBox Header="Area Name"
                 Text="{x:Bind ViewModel.SelectedArea.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
        <ComboBox Grid.Column="1"
                  Header="Type"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.AreaTool.AreaTypes}"
                  ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
                  SelectedItem="{x:Bind ViewModel.SelectedArea.AreaType, Mode=TwoWay}" />
      </Grid>
      <ComboBox Header="Color"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.AreaColors}"
                SelectedItem="{x:Bind ViewModel.SelectedArea.ColorOption, Mode=TwoWay, FallbackValue={x:Null}}"
                ToolTipService.ToolTip="The color the area is drawn in, here and in a test. Default is its type's color.">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="mainPageModels:AreaColorOption">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Rectangle Width="16"
                         Height="16"
                         RadiusX="3"
                         RadiusY="3"
                         Fill="{x:Bind Swatch}"
                         Stroke="{StaticResource LightGreyBrush}"
                         StrokeThickness="1" />
              <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <engineTextBox:EngineTextBox Header="Level"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedArea.Level, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                     ToolTipService.ToolTip="The area only affects entities on this level, 0 is the ground. A level change moves whoever steps into it to this level." />
        <!-- moving up onto the area is blocked by its bottom side, the map draws a bar on each blocked side -->
        <StackPanel Grid.Column="1"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.SelectedArea.IsCollision, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
          <TextBlock Text="Blocks Moving" />
          <StackPanel Orientation="Horizontal"
                      Spacing="6">
            <ToggleButton Content="&#x2191;"
                          MinWidth="44"
                          IsChecked="{x:Bind ViewModel.SelectedArea.BlocksUp, Mode=TwoWay, FallbackValue=False}"
                          ToolTipService.ToolTip="Stops moving up onto the area" />
            <ToggleButton Content="&#x2193;"
                          MinWidth="44"
                          IsChecked="{x:Bind ViewModel.SelectedArea.BlocksDown, Mode=TwoWay, FallbackValue=False}"
                          ToolTipService.ToolTip="Stops moving down onto the area" />
            <ToggleButton Content="&#x2190;"
                          MinWidth="44"
                          IsChecked="{x:Bind ViewModel.SelectedArea.BlocksLeft, Mode=TwoWay, FallbackValue=False}"
                          ToolTipService.ToolTip="Stops moving left onto the area" />
            <ToggleButton Content="&#x2192;"
                          MinWidth="44"
                          IsChecked="{x:Bind ViewModel.SelectedArea.BlocksRight, Mode=TwoWay, FallbackValue=False}"
                          ToolTipService.ToolTip="Stops moving right onto the area" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <engineTextBox:EngineTextBox Header="X"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedArea.CellX, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Grid.Column="1"
                                     Header="Y"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedArea.CellY, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Grid.Column="2"
                                     Header="W"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedArea.CellWidth, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}" />
        <engineTextBox:EngineTextBox Grid.Column="3"
                                     Header="H"
                                     InputType="Integer"
                                     Text="{x:Bind ViewModel.SelectedArea.CellHeight, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
      <TextBlock Foreground="{StaticResource LightGreyBrush}"
                 TextWrapping="Wrap">
        <Run Text="X, Y, W and H count cells of" />
        <Run Text="{x:Bind ViewModel.AreaTool.GridSize, Mode=OneWay}" />
        <Run Text="pixels, the area grid picked in the top bar." />
      </TextBlock>
      <ComboBox Header="Footstep Sound"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.FootstepFiles, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedFootstep, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.SelectedArea.IsFootstep, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
      <!-- heat haze: the ground under the area shimmers in the game, props and characters on it stay sharp -->
      <Grid ColumnSpacing="10"
            Visibility="{x:Bind ViewModel.SelectedArea.IsHeatHaze, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <NumberBox Header="Strength"
                   Minimum="0"
                   SmallChange="0.5"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind ViewModel.SelectedArea.Area.HazeStrength, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="How far the heat pulls the ground, in pixels. 2 to 4 is a gentle shimmer." />
        <NumberBox Grid.Column="1"
                   Header="Ripple Size"
                   Minimum="2"
                   SmallChange="1"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind ViewModel.SelectedArea.Area.HazeRippleSize, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="The size of one ripple, in pixels." />
        <NumberBox Grid.Column="2"
                   Header="Rise Speed"
                   Minimum="0"
                   SmallChange="5"
                   SpinButtonPlacementMode="Inline"
                   Value="{x:Bind ViewModel.SelectedArea.Area.HazeSpeed, Mode=TwoWay, FallbackValue=0}"
                   ToolTipService.ToolTip="How fast the shimmer rises, in pixels a second." />
      </Grid>
    </StackPanel>
  </popup:PopupShell>
</UserControl>
