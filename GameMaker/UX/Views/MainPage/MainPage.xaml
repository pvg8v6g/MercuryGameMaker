<Page x:Class="GameMaker.UX.Views.MainPage.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mainPage="using:GameMaker.UX.ViewModels.MainPage"
      xmlns:mainPageModels="using:GameMaker.UX.Models.MainPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineGlyphButton="using:GameMaker.UX.Components.EngineGlyphButton"
      xmlns:gridArea="using:GameMaker.UX.Components.GridArea"
      xmlns:mercury="using:MercuryLibrary.CanvasComponents"
      xmlns:foundation="using:Windows.Foundation"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance mainPage:MainPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="6" Padding="5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Map Tree: folds away completely, the small arrow next to it brings it back -->
    <enginePanel:EnginePanel x:Name="MapsPanel"
                             Title="Maps"
                             Width="280"
                             Visibility="{x:Bind ViewModel.IsMapsPanelExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TreeView SelectionMode="Single"
                CanDragItems="False"
                AllowDrop="False"
                MinHeight="200"
                Height="{x:Bind MapsPanel.ScrollerViewportHeight, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.MapTree}"
                behaviors:TreeViewBehaviors.SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                behaviors:TreeViewBehaviors.SelectOnRightClick="True"
                ToolTipService.ToolTip="Right-click to add maps and folders. Change a map's parent in its settings to move it.">
        <TreeView.ItemTemplate>
          <DataTemplate x:DataType="mainPageModels:MapTreeNode">
            <TreeViewItem ItemsSource="{x:Bind Children}"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="{x:Bind Symbol}" />
                <TextBlock TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center">
                  <Run Foreground="{StaticResource LightGreyBrush}"
                       Text="{x:Bind IdText}" />
                  <Run Text="{x:Bind Map.Name, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </TreeViewItem>
          </DataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="New Map" Command="{x:Bind ViewModel.NewMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Map" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="New Folder" Command="{x:Bind ViewModel.NewFolderCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Folder" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Edit" Command="{x:Bind ViewModel.EditMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Edit" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopyMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Copy" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Paste"
                            Command="{x:Bind ViewModel.PasteMapCommand}"
                            IsEnabled="{x:Bind ViewModel.CopiedMap, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Paste" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Delete" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
          </MenuFlyout>
        </TreeView.ContextFlyout>
      </TreeView>
    </enginePanel:EnginePanel>

    <engineGlyphButton:EngineGlyphButton Grid.Column="1"
                                         Style="{StaticResource PanelFoldButtonStyle}"
                                         Glyph="{x:Bind ViewModel.MapsPanelGlyph, Mode=OneWay}"
                                         GlyphSize="10"
                                         Command="{x:Bind ViewModel.ToggleMapsPanelCommand}"
                                         ToolTipService.ToolTip="Show or hide the maps" />

    <!-- Map Editor: the tool rail on the right (it folds away to its arrow), the current tool's options and the fixed buttons on top, the status bar below -->
    <Grid Grid.Column="2"
          ColumnSpacing="8"
          RowSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Tool rail: one button per tool, a new tool is one more button. The arrow on top folds it away -->
      <StackPanel Grid.Row="1"
                  Grid.Column="1"
                  Spacing="6"
                  Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <engineGlyphButton:EngineGlyphButton HorizontalAlignment="Right"
                                             Style="{StaticResource PanelFoldButtonStyle}"
                                             Glyph="{x:Bind ViewModel.ToolRailGlyph, Mode=OneWay}"
                                             GlyphSize="10"
                                             Command="{x:Bind ViewModel.ToggleToolRailCommand}"
                                             ToolTipService.ToolTip="Show or hide the tools" />
        <StackPanel Spacing="6"
                    Visibility="{x:Bind ViewModel.IsToolRailExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <RadioButton Style="{StaticResource ToolRailButtonStyle}"
                     GroupName="MapEditMode"
                     IsChecked="{x:Bind ViewModel.IsEntityMode, Mode=TwoWay}"
                     ToolTipService.ToolTip="Double-click a tile to add an entity, double-click an entity to edit it, drag to move it.">
          <StackPanel Spacing="2">
            <SymbolIcon Symbol="Contact" />
            <TextBlock Text="Entities"
                       FontSize="10"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource ToolRailButtonStyle}"
                     GroupName="MapEditMode"
                     IsChecked="{x:Bind ViewModel.IsAreaMode, Mode=TwoWay}"
                     ToolTipService.ToolTip="Click or drag on empty tiles to draw an area, drag an area to move it.">
          <StackPanel Spacing="2">
            <SymbolIcon Symbol="ViewAll" />
            <TextBlock Text="Areas"
                       FontSize="10"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource ToolRailButtonStyle}"
                     GroupName="MapEditMode"
                     IsChecked="{x:Bind ViewModel.IsPropMode, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.HasProps, Mode=OneWay}"
                     ToolTipService.ToolTip="Pick a prop, click the map to stamp it (its base goes where you click). Props sit on the character step grid. Click a prop to select it, drag to move. Delete removes, F flips, arrows nudge one character step (Shift: a tile), Ctrl+C / Ctrl+V copy and paste.">
          <StackPanel Spacing="2">
            <SymbolIcon Symbol="Pictures" />
            <TextBlock Text="Props"
                       FontSize="10"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource ToolRailButtonStyle}"
                     GroupName="MapEditMode"
                     IsChecked="{x:Bind ViewModel.IsPathMode, Mode=TwoWay}"
                     ToolTipService.ToolTip="Patrol paths: click a tile to add a point to the picked path (after the picked point), click a point to pick it, drag to move it. Delete removes the picked point.">
          <StackPanel Spacing="2">
            <SymbolIcon Symbol="Directions" />
            <TextBlock Text="Paths"
                       FontSize="10"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        </StackPanel>
      </StackPanel>

      <!-- Tool options: only the current tool's, then layers, view and test on the right -->
      <Grid Grid.ColumnSpan="2"
            ColumnSpacing="15"
            Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    Spacing="15"
                    MinHeight="36">
          <ComboBox MinWidth="200"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.PropTool.Choices}"
                    SelectedItem="{x:Bind ViewModel.PropTool.SelectedChoice, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsPropMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTipService.ToolTip="The prop a click stamps. Props are made on the Props page.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="mainPageModels:PropChoiceModel">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="{x:Bind Image}"
                         Width="32"
                         Height="32"
                         Stretch="Uniform" />
                  <TextBlock Text="{x:Bind Name}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="&#xE72C;"
                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                  VerticalAlignment="Center"
                  Command="{x:Bind ViewModel.PropTool.RefreshChoicesCommand}"
                  Visibility="{x:Bind ViewModel.IsPropMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTipService.ToolTip="Reload the props (after changing them on the Props page)"
                  behaviors:PointerCursorBehavior.CursorType="Hand" />
          <Button Content="Fill..."
                  VerticalAlignment="Center"
                  Command="{x:Bind ViewModel.FillPropsCommand}"
                  Visibility="{x:Bind ViewModel.IsPropMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTipService.ToolTip="Fill the map with props by a fill set (forest, desert, snow...): what goes on unpassable ground, open ground, named areas"
                  behaviors:PointerCursorBehavior.CursorType="Hand" />
          <Button Content="Clear"
                  VerticalAlignment="Center"
                  Command="{x:Bind ViewModel.ClearPropsCommand}"
                  Visibility="{x:Bind ViewModel.IsPropMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTipService.ToolTip="Remove every prop from this map"
                  behaviors:PointerCursorBehavior.CursorType="Hand" />
          <Button Content="Import..."
                  VerticalAlignment="Center"
                  Command="{x:Bind ViewModel.ImportPropsCommand}"
                  Visibility="{x:Bind ViewModel.IsPropMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ToolTipService.ToolTip="Place props from a props file (made by the map composer). Pictures are matched to props on the Props page."
                  behaviors:PointerCursorBehavior.CursorType="Hand" />
          <CheckBox Content="Snap to tile"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.PropTool.SnapToTile, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsPropMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTipService.ToolTip="Put each prop's base on the middle of the bottom of a tile. Off: exactly where you click." />
          <ComboBox MinWidth="140"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.AreaTool.AreaTypes}"
                    ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
                    SelectedItem="{x:Bind ViewModel.AreaTool.NewAreaType, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsAreaMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTipService.ToolTip="The type of area to draw." />
          <ComboBox MinWidth="90"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.AreaTool.GridSizes}"
                    SelectedItem="{x:Bind ViewModel.AreaTool.GridSize, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsAreaMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTipService.ToolTip="Area grid in pixels: what areas snap to while drawing and moving. 48 is a tile, smaller makes finer collisions." />

          <!-- Paths: the path to edit, the rest is in its popup (Edit or double-click a point) -->
          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      Visibility="{x:Bind ViewModel.IsPathMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ComboBox MinWidth="150"
                      VerticalAlignment="Center"
                      PlaceholderText="No paths"
                      DisplayMemberPath="Name"
                      ItemsSource="{x:Bind ViewModel.PathTool.Paths}"
                      SelectedItem="{x:Bind ViewModel.PathTool.SelectedPath, Mode=TwoWay}"
                      ToolTipService.ToolTip="The path clicks add points to." />
            <Button Content="New"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.PathTool.NewPathCommand}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Start a new path, then click tiles to add its points" />
            <Button Content="Edit..."
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.EditSelectionCommand}"
                    Visibility="{x:Bind ViewModel.PathTool.HasSelectedPath, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="The path's name and style, and the picked point's pause and looks (or double-click a point)" />
            <Button Content="Delete Path"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.PathTool.DeletePathCommand}"
                    Visibility="{x:Bind ViewModel.PathTool.HasSelectedPath, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    behaviors:PointerCursorBehavior.CursorType="Hand" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10">
          <engineGlyphButton:EngineGlyphButton Padding="8,4"
                                               VerticalAlignment="Center"
                                               behaviors:PointerCursorBehavior.CursorType="Hand"
                                               Glyph="&#xE81E;"
                                               Command="{x:Bind ViewModel.LayersCommand}"
                                               ToolTipService.ToolTip="Layers: z, opacity and blend of the map images, and which environments are on." />
          <DropDownButton Padding="8,4"
                          VerticalAlignment="Center"
                          behaviors:PointerCursorBehavior.CursorType="Hand"
                          ToolTipService.ToolTip="View: what the editor draws over the map">
            <SymbolIcon Symbol="View" />
            <DropDownButton.Flyout>
              <MenuFlyout Placement="Bottom">
                <ToggleMenuFlyoutItem Text="Grid"
                                      IsChecked="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Areas"
                                      IsChecked="{x:Bind ViewModel.ShowAreas, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Paths"
                                      IsChecked="{x:Bind ViewModel.ShowPaths, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Parallax"
                                      IsChecked="{x:Bind ViewModel.ShowParallax, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Light"
                                      IsChecked="{x:Bind ViewModel.ShowLight, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Environment"
                                      IsChecked="{x:Bind ViewModel.ShowEnvironments, Mode=TwoWay}" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <SplitButton Padding="8,4"
                       VerticalAlignment="Center"
                       behaviors:PointerCursorBehavior.CursorType="Hand"
                       Command="{x:Bind ViewModel.TestMapCommand}"
                       ToolTipService.ToolTip="Test: saves, then plays this map from its test spawn (right-click the map to set one). The arrow picks full screen or a window, and what the test draws over the game.">
            <SymbolIcon Symbol="Play" />
            <SplitButton.Flyout>
              <MenuFlyout Placement="Bottom">
                <ToggleMenuFlyoutItem Text="Full Screen"
                                      IsChecked="{x:Bind ViewModel.TestFullScreen, Mode=TwoWay}" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Show Hitboxes"
                                      IsChecked="{x:Bind ViewModel.TestShowHitboxes, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Show Areas"
                                      IsChecked="{x:Bind ViewModel.TestShowAreas, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Show Collisions"
                                      IsChecked="{x:Bind ViewModel.TestShowCollisions, Mode=TwoWay}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1"
              Grid.Column="0"
              BorderBrush="White"
              BorderThickness="2"
              CornerRadius="8"
              Padding="2">
        <Grid>
          <!-- never collapsed: the canvas stops drawing when it starts out hidden, it just draws nothing while no map is selected -->
          <!-- the shortcuts are kept out of the tooltip, WinUI otherwise pops up "Delete" (the first one) while hovering the map -->
          <Grid IsHitTestVisible="{x:Bind ViewModel.IsMapSelected, Mode=OneWay}"
                KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.Clip>
              <RectangleGeometry Rect="{x:Bind ViewModel.ViewportRect, Mode=OneWay}" />
            </Grid.Clip>
            <!-- the game's renderer: ground, entities, parallax and light with their blend modes -->
            <!-- 96 draws every image at its pixel size, art saved at 72 dpi would otherwise be drawn 1.33x too big -->
            <mercury:GameCanvasView x:Name="MapCanvas"
                                    ImageDpi="96"
                                    UpdateRate="16.66666667"
                                    ClearColor="{StaticResource DarkGreyColor}"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="False"
                                    Sprites="{x:Bind ViewModel.Sprites}"
                                    behaviors:PointerCursorBehavior.CursorType="Hand"
                                    behaviors:SizeChangedBehavior.SizeChangedCommand="{x:Bind ViewModel.CanvasSizeChangedCommand}"
                                    behaviors:PointerCommandBehavior.CapturePointerOnPressed="True"
                                    behaviors:PointerCommandBehavior.FocusOnPressed="True"
                                    behaviors:PointerCommandBehavior.PointerPressedCommand="{x:Bind ViewModel.CanvasPressedCommand}"
                                    behaviors:PointerCommandBehavior.PointerMovedCommand="{x:Bind ViewModel.CanvasMovedCommand}"
                                    behaviors:PointerCommandBehavior.PointerReleasedCommand="{x:Bind ViewModel.CanvasReleasedCommand}"
                                    behaviors:PointerCommandBehavior.PointerWheelChangedCommand="{x:Bind ViewModel.CanvasWheelCommand}"
                                    behaviors:PointerCommandBehavior.DoubleTappedCommand="{x:Bind ViewModel.CanvasDoubleTappedCommand}">
              <mercury:GameCanvasView.KeyboardAccelerators>
                <KeyboardAccelerator Key="Delete"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.DeleteSelectionCommand}" />
                <KeyboardAccelerator Key="Back"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.DeleteSelectionCommand}" />
                <KeyboardAccelerator Key="Escape"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                <KeyboardAccelerator Key="Enter"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.EditSelectionCommand}" />
                <KeyboardAccelerator Key="C"
                                     Modifiers="Control"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.CopySelectionCommand}" />
                <KeyboardAccelerator Key="V"
                                     Modifiers="Control"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.PasteSelectionCommand}" />
                <KeyboardAccelerator Key="F"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.FlipSelectionCommand}" />
                <KeyboardAccelerator Key="Left"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Left" />
                <KeyboardAccelerator Key="Left"
                                     Modifiers="Shift"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Shift+Left" />
                <KeyboardAccelerator Key="Right"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Right" />
                <KeyboardAccelerator Key="Right"
                                     Modifiers="Shift"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Shift+Right" />
                <KeyboardAccelerator Key="Up"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Up" />
                <KeyboardAccelerator Key="Up"
                                     Modifiers="Shift"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Shift+Up" />
                <KeyboardAccelerator Key="Down"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Down" />
                <KeyboardAccelerator Key="Down"
                                     Modifiers="Shift"
                                     behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.NudgeSelectionCommand}"
                                     behaviors:KeyboardAcceleratorBehavior.CommandParameter="Shift+Down" />
              </mercury:GameCanvasView.KeyboardAccelerators>
              <mercury:GameCanvasView.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="New Entity" Command="{x:Bind ViewModel.NewEntityCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Add" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Edit" Command="{x:Bind ViewModel.EditSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Edit" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopySelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Copy" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Paste" Command="{x:Bind ViewModel.PasteSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Paste" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Flip" Command="{x:Bind ViewModel.FlipSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE8AB;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Set Game Start Here" Command="{x:Bind ViewModel.SetGameStartCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Home" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Set Test Spawn Here" Command="{x:Bind ViewModel.SetTestSpawnCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Play" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Delete" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </mercury:GameCanvasView.ContextFlyout>
            </mercury:GameCanvasView>

            <!-- editor overlay, drawn in world space and shifted by the camera -->
            <Canvas IsHitTestVisible="False">
              <Canvas.RenderTransform>
                <TranslateTransform X="{x:Bind ViewModel.OverlayX, Mode=OneWay}"
                                    Y="{x:Bind ViewModel.OverlayY, Mode=OneWay}" />
              </Canvas.RenderTransform>

              <!-- Map Bounds -->
              <Rectangle Width="{x:Bind ViewModel.MapPixelWidth, Mode=OneWay}"
                         Height="{x:Bind ViewModel.MapPixelHeight, Mode=OneWay}"
                         Stroke="{StaticResource LightGreyBrush}"
                         StrokeThickness="1" />

              <!-- Grid -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.GridLines}"
                            Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="gridArea:GridLine">
                    <Line X1="{x:Bind X1}"
                          Y1="{x:Bind Y1}"
                          X2="{x:Bind X2}"
                          Y2="{x:Bind Y2}"
                          Stroke="{StaticResource BlackBrush}"
                          Opacity="0.35"
                          StrokeThickness="1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Areas -->
              <gridArea:CanvasItemsControl ItemsSource="{x:Bind ViewModel.Areas}"
                                           Opacity="{x:Bind ViewModel.AreasOpacity, Mode=OneWay}"
                                           LeftPropertyName="X"
                                           TopPropertyName="Y"
                                           Visibility="{x:Bind ViewModel.ShowAreas, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <gridArea:CanvasItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </gridArea:CanvasItemsControl.ItemsPanel>
                <gridArea:CanvasItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mainPageModels:MapAreaModel">
                    <Grid Width="{x:Bind Width, Mode=OneWay}"
                          Height="{x:Bind Height, Mode=OneWay}"
                          Background="{x:Bind Fill, Mode=OneWay}">
                      <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                 FontSize="10"
                                 Margin="3,1"
                                 TextTrimming="CharacterEllipsis" />
                      <!-- a collision's walled off sides, a side without a bar can be walked onto -->
                      <Rectangle Height="4"
                                 VerticalAlignment="Top"
                                 Fill="#FFE63C3C"
                                 Visibility="{x:Bind ShowTopBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <Rectangle Height="4"
                                 VerticalAlignment="Bottom"
                                 Fill="#FFE63C3C"
                                 Visibility="{x:Bind ShowBottomBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <Rectangle Width="4"
                                 HorizontalAlignment="Left"
                                 Fill="#FFE63C3C"
                                 Visibility="{x:Bind ShowLeftBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <Rectangle Width="4"
                                 HorizontalAlignment="Right"
                                 Fill="#FFE63C3C"
                                 Visibility="{x:Bind ShowRightBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <Rectangle Stroke="{StaticResource LightYellowBrush}"
                                 StrokeThickness="2"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </DataTemplate>
                </gridArea:CanvasItemsControl.ItemTemplate>
              </gridArea:CanvasItemsControl>

              <!-- Prop footprints (what blocks movement), shown with the areas -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.PropTool.Footprints}"
                            Opacity="{x:Bind ViewModel.PropsOverlayOpacity, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowAreas, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="foundation:Rect">
                    <Rectangle Width="{x:Bind Width}"
                               Height="{x:Bind Height}"
                               Fill="#6EE63C3C"
                               Stroke="#FFE63C3C"
                               StrokeThickness="1">
                      <Rectangle.RenderTransform>
                        <TranslateTransform X="{x:Bind X}" Y="{x:Bind Y}" />
                      </Rectangle.RenderTransform>
                    </Rectangle>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Patrol paths: lines in walking order and a numbered dot on each point, the picked path in orange -->
              <Canvas IsHitTestVisible="False"
                      Opacity="{x:Bind ViewModel.PathsOpacity, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.PathsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.PathTool.Segments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mainPageModels:PathSegment">
                      <Line X1="{x:Bind X1}"
                            Y1="{x:Bind Y1}"
                            X2="{x:Bind X2}"
                            Y2="{x:Bind Y2}"
                            Stroke="{x:Bind Stroke}"
                            StrokeThickness="3"
                            StrokeDashArray="3,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{x:Bind ViewModel.PathTool.Markers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mainPageModels:PathMarker">
                      <Canvas>
                        <Grid Canvas.Left="{x:Bind Left}"
                              Canvas.Top="{x:Bind Top}"
                              Width="{x:Bind Diameter}"
                              Height="{x:Bind Diameter}">
                          <Ellipse Fill="{x:Bind Fill}"
                                   Stroke="{x:Bind Ring}"
                                   StrokeThickness="2" />
                          <TextBlock Text="{x:Bind Number}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="Black"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Canvas.Left="{x:Bind Left}"
                                   Canvas.Top="{x:Bind Top}"
                                   Margin="26,2,0,0"
                                   FontSize="11"
                                   Text="{x:Bind Name}"
                                   Visibility="{x:Bind HasName, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </Canvas>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Canvas>

              <!-- Props (the picture is drawn by the canvas): a box round the selected one -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.PropTool.Props}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mainPageModels:MapPropModel">
                    <Canvas>
                      <Rectangle Width="{x:Bind ImageWidth}"
                                 Height="{x:Bind ImageHeight}"
                                 Stroke="{StaticResource LightYellowBrush}"
                                 StrokeThickness="2"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Rectangle.RenderTransform>
                          <TranslateTransform X="{x:Bind X, Mode=OneWay}" Y="{x:Bind Y, Mode=OneWay}" />
                        </Rectangle.RenderTransform>
                      </Rectangle>
                    </Canvas>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Prop stamp preview: the picked prop where a click would put it -->
              <Image Canvas.Left="{x:Bind ViewModel.PropTool.GhostX, Mode=OneWay}"
                     Canvas.Top="{x:Bind ViewModel.PropTool.GhostY, Mode=OneWay}"
                     Source="{x:Bind ViewModel.PropTool.GhostImage, Mode=OneWay}"
                     Stretch="None"
                     Opacity="0.55"
                     Visibility="{x:Bind ViewModel.PropTool.IsGhostShown, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <!-- Entities (the sprite is drawn by the canvas, this is the tile marker) -->
              <gridArea:CanvasItemsControl ItemsSource="{x:Bind ViewModel.Entities}"
                                           LeftPropertyName="X"
                                           TopPropertyName="Y">
                <gridArea:CanvasItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </gridArea:CanvasItemsControl.ItemsPanel>
                <gridArea:CanvasItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mainPageModels:MapEntityModel">
                    <Grid Width="{x:Bind Size}" Height="{x:Bind Size}">
                      <Rectangle Stroke="{StaticResource LightBlueBrush}"
                                 StrokeThickness="1"
                                 StrokeDashArray="2,2"
                                 Opacity="0.6" />
                      <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                 FontSize="10"
                                 Margin="2"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 Visibility="{x:Bind Sprite, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />
                      <Rectangle Stroke="{StaticResource MediumPinkBrush}"
                                 StrokeThickness="2"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </DataTemplate>
                </gridArea:CanvasItemsControl.ItemTemplate>
              </gridArea:CanvasItemsControl>

              <!-- Hover Tile (or area cell) -->
              <Rectangle Canvas.Left="{x:Bind ViewModel.HoverX, Mode=OneWay}"
                         Canvas.Top="{x:Bind ViewModel.HoverY, Mode=OneWay}"
                         Width="{x:Bind ViewModel.SnapSize, Mode=OneWay}"
                         Height="{x:Bind ViewModel.SnapSize, Mode=OneWay}"
                         Fill="{StaticResource LightGreyBrush}"
                         Opacity="0.3"
                         Stroke="{StaticResource LightYellowBrush}"
                         StrokeDashArray="2,2"
                         Visibility="{x:Bind ViewModel.IsHovering, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <!-- Game Start: where a new game begins -->
              <Border Canvas.Left="{x:Bind ViewModel.GameStartX, Mode=OneWay}"
                      Canvas.Top="{x:Bind ViewModel.GameStartY, Mode=OneWay}"
                      Width="{x:Bind ViewModel.TileSize}"
                      Height="{x:Bind ViewModel.TileSize}"
                      BorderBrush="{StaticResource LightYellowBrush}"
                      BorderThickness="2"
                      Visibility="{x:Bind ViewModel.IsGameStartShown, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <SymbolIcon Symbol="Home" Foreground="{StaticResource LightYellowBrush}" />
              </Border>

              <!-- Test Spawn: where the Test button puts the player -->
              <Border Canvas.Left="{x:Bind ViewModel.TestSpawnX, Mode=OneWay}"
                      Canvas.Top="{x:Bind ViewModel.TestSpawnY, Mode=OneWay}"
                      Width="{x:Bind ViewModel.TileSize}"
                      Height="{x:Bind ViewModel.TileSize}"
                      BorderBrush="{StaticResource LightBlueBrush}"
                      BorderThickness="2"
                      Visibility="{x:Bind ViewModel.IsTestSpawnShown, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <SymbolIcon Symbol="Play" Foreground="{StaticResource LightBlueBrush}" />
              </Border>

              <!-- Area Draw Preview -->
              <Rectangle Canvas.Left="{x:Bind ViewModel.AreaTool.DrawPreview.X, Mode=OneWay}"
                         Canvas.Top="{x:Bind ViewModel.AreaTool.DrawPreview.Y, Mode=OneWay}"
                         Width="{x:Bind ViewModel.AreaTool.DrawPreview.Width, Mode=OneWay}"
                         Height="{x:Bind ViewModel.AreaTool.DrawPreview.Height, Mode=OneWay}"
                         Fill="{StaticResource LightYellowBrush}"
                         Opacity="0.35"
                         Stroke="{StaticResource LightYellowBrush}"
                         StrokeThickness="2"
                         Visibility="{x:Bind ViewModel.AreaTool.IsDrawing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Canvas>
          </Grid>

          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource LightGreyBrush}"
                     Text="This is a folder. Right-click it in the tree to add maps inside it."
                     Visibility="{x:Bind ViewModel.IsFolderSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource LightGreyBrush}"
                     Text="Right-click the map tree to create your first map."
                     Visibility="{x:Bind ViewModel.SelectedMap, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />
        </Grid>
      </Border>

      <!-- Status bar: where the cursor is, what's selected and the grid -->
      <StackPanel Grid.Row="2"
                  Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="20"
                  Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock MinWidth="150"
                   Foreground="{StaticResource LightGreyBrush}"
                   Text="{x:Bind ViewModel.CursorText, Mode=OneWay}"
                   ToolTipService.ToolTip="Scroll to pan, shift-scroll to pan sideways, middle-drag to pan freely." />
        <TextBlock Foreground="{StaticResource LightGreyBrush}"
                   Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" />
        <TextBlock Foreground="{StaticResource LightGreyBrush}"
                   Text="{x:Bind ViewModel.SnapText, Mode=OneWay}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
