<Page x:Class="GameMaker.UX.Views.MainPage.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mainPage="using:GameMaker.UX.ViewModels.MainPage"
      xmlns:mainPageModels="using:GameMaker.UX.Models.MainPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:gridArea="using:GameMaker.UX.Components.GridArea"
      xmlns:mercury="using:MercuryLibrary.CanvasComponents"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance mainPage:MainPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>

    <!-- Map Tree -->
    <enginePanel:EnginePanel x:Name="MapsPanel" Title="Maps">
      <TreeView SelectionMode="Single"
                CanDragItems="False"
                AllowDrop="False"
                MinHeight="200"
                Height="{x:Bind MapsPanel.ScrollerViewportHeight, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.MapTree}"
                behaviors:TreeViewBehaviors.SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                behaviors:TreeViewBehaviors.SelectOnRightClick="True"
                ToolTipService.ToolTip="Right-click to add maps and folders. Change a map's parent in its settings to move it.">
        <TreeView.ItemTemplate>
          <DataTemplate x:DataType="mainPageModels:MapTreeNode">
            <TreeViewItem ItemsSource="{x:Bind Children}"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="{x:Bind Symbol}" />
                <TextBlock Text="{x:Bind Map.Name, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
              </StackPanel>
            </TreeViewItem>
          </DataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="New Map" Command="{x:Bind ViewModel.NewMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Map" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="New Folder" Command="{x:Bind ViewModel.NewFolderCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Folder" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopyMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Copy" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Paste"
                            Command="{x:Bind ViewModel.PasteMapCommand}"
                            IsEnabled="{x:Bind ViewModel.CopiedMap, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Paste" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Delete" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
          </MenuFlyout>
        </TreeView.ContextFlyout>
      </TreeView>
    </enginePanel:EnginePanel>

    <!-- Map Editor -->
    <Grid Grid.Column="1" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="20"
            Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="15">
          <RadioButton Content="Entities"
                       GroupName="MapEditMode"
                       MinWidth="0"
                       behaviors:PointerCursorBehavior.CursorType="Hand"
                       IsChecked="{x:Bind ViewModel.IsEntityMode, Mode=TwoWay}"
                       ToolTipService.ToolTip="Double-click a tile to add an entity, double-click an entity to edit it, drag to move it." />
          <RadioButton Content="Areas"
                       GroupName="MapEditMode"
                       MinWidth="0"
                       behaviors:PointerCursorBehavior.CursorType="Hand"
                       IsChecked="{x:Bind ViewModel.IsAreaMode, Mode=TwoWay}"
                       ToolTipService.ToolTip="Click or drag on empty tiles to draw an area, drag an area to move it." />
          <ComboBox MinWidth="140"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.AreaTypes}"
                    SelectedItem="{x:Bind ViewModel.NewAreaType, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsAreaMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTipService.ToolTip="The type of area to draw." />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
          <CheckBox Content="Grid"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}" />
          <CheckBox Content="Areas"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowAreas, Mode=TwoWay}" />
          <CheckBox Content="Parallax"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowParallax, Mode=TwoWay}" />
          <CheckBox Content="Light"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowLight, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource LightGreyBrush}"
                   Text="{x:Bind ViewModel.CursorText, Mode=OneWay}"
                   ToolTipService.ToolTip="Scroll to pan, shift-scroll to pan sideways, middle-drag to pan freely." />
      </Grid>

      <Border Grid.Row="1"
              BorderBrush="White"
              BorderThickness="2"
              CornerRadius="8"
              Padding="2">
        <Grid>
          <Grid Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Clip>
              <RectangleGeometry Rect="{x:Bind ViewModel.ViewportRect, Mode=OneWay}" />
            </Grid.Clip>
            <Grid.KeyboardAccelerators>
              <KeyboardAccelerator Key="Delete"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.DeleteSelectionCommand}" />
              <KeyboardAccelerator Key="Escape"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.ClearSelectionCommand}" />
              <KeyboardAccelerator Key="Enter"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.EditEntityCommand}" />
              <KeyboardAccelerator Key="C"
                                   Modifiers="Control"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.CopySelectionCommand}" />
              <KeyboardAccelerator Key="V"
                                   Modifiers="Control"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.PasteSelectionCommand}" />
            </Grid.KeyboardAccelerators>

            <!-- the game's renderer: ground, entities, parallax and light with their blend modes -->
            <mercury:GameCanvasView x:Name="MapCanvas"
                                    UpdateRate="16.66666667"
                                    ClearColor="{StaticResource DarkGreyColor}"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="False"
                                    Sprites="{x:Bind ViewModel.Sprites}"
                                    behaviors:PointerCursorBehavior.CursorType="Hand"
                                    behaviors:SizeChangedBehavior.SizeChangedCommand="{x:Bind ViewModel.CanvasSizeChangedCommand}"
                                    behaviors:PointerCommandBehavior.CapturePointerOnPressed="True"
                                    behaviors:PointerCommandBehavior.FocusOnPressed="True"
                                    behaviors:PointerCommandBehavior.PointerPressedCommand="{x:Bind ViewModel.CanvasPressedCommand}"
                                    behaviors:PointerCommandBehavior.PointerMovedCommand="{x:Bind ViewModel.CanvasMovedCommand}"
                                    behaviors:PointerCommandBehavior.PointerReleasedCommand="{x:Bind ViewModel.CanvasReleasedCommand}"
                                    behaviors:PointerCommandBehavior.PointerWheelChangedCommand="{x:Bind ViewModel.CanvasWheelCommand}"
                                    behaviors:PointerCommandBehavior.DoubleTappedCommand="{x:Bind ViewModel.CanvasDoubleTappedCommand}">
              <mercury:GameCanvasView.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="New Entity" Command="{x:Bind ViewModel.NewEntityCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Add" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Edit Entity" Command="{x:Bind ViewModel.EditEntityCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Edit" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopySelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Copy" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Paste" Command="{x:Bind ViewModel.PasteSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Paste" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Delete" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </mercury:GameCanvasView.ContextFlyout>
            </mercury:GameCanvasView>

            <!-- editor overlay, drawn in world space and shifted by the camera -->
            <Canvas IsHitTestVisible="False">
              <Canvas.RenderTransform>
                <TranslateTransform X="{x:Bind ViewModel.OverlayX, Mode=OneWay}"
                                    Y="{x:Bind ViewModel.OverlayY, Mode=OneWay}" />
              </Canvas.RenderTransform>

              <!-- Map Bounds -->
              <Rectangle Width="{x:Bind ViewModel.MapPixelWidth, Mode=OneWay}"
                         Height="{x:Bind ViewModel.MapPixelHeight, Mode=OneWay}"
                         Stroke="{StaticResource LightGreyBrush}"
                         StrokeThickness="1" />

              <!-- Grid -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.GridLines}"
                            Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="gridArea:GridLine">
                    <Line X1="{x:Bind X1}"
                          Y1="{x:Bind Y1}"
                          X2="{x:Bind X2}"
                          Y2="{x:Bind Y2}"
                          Stroke="{StaticResource BlackBrush}"
                          Opacity="0.35"
                          StrokeThickness="1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Areas -->
              <gridArea:CanvasItemsControl ItemsSource="{x:Bind ViewModel.Areas}"
                                           LeftPropertyName="X"
                                           TopPropertyName="Y"
                                           Visibility="{x:Bind ViewModel.ShowAreas, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <gridArea:CanvasItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </gridArea:CanvasItemsControl.ItemsPanel>
                <gridArea:CanvasItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mainPageModels:MapAreaModel">
                    <Grid Width="{x:Bind Width, Mode=OneWay}"
                          Height="{x:Bind Height, Mode=OneWay}"
                          Background="{x:Bind Fill, Mode=OneWay}">
                      <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                 FontSize="10"
                                 Margin="3,1"
                                 TextTrimming="CharacterEllipsis" />
                      <Rectangle Stroke="{StaticResource LightYellowBrush}"
                                 StrokeThickness="2"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </DataTemplate>
                </gridArea:CanvasItemsControl.ItemTemplate>
              </gridArea:CanvasItemsControl>

              <!-- Entities (the sprite is drawn by the canvas, this is the tile marker) -->
              <gridArea:CanvasItemsControl ItemsSource="{x:Bind ViewModel.Entities}"
                                           LeftPropertyName="X"
                                           TopPropertyName="Y">
                <gridArea:CanvasItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </gridArea:CanvasItemsControl.ItemsPanel>
                <gridArea:CanvasItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mainPageModels:MapEntityModel">
                    <Grid Width="{x:Bind Size}" Height="{x:Bind Size}">
                      <Rectangle Stroke="{StaticResource LightBlueBrush}"
                                 StrokeThickness="1"
                                 StrokeDashArray="2,2"
                                 Opacity="0.6" />
                      <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                 FontSize="10"
                                 Margin="2"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 Visibility="{x:Bind Sprite, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />
                      <Rectangle Stroke="{StaticResource MediumPinkBrush}"
                                 StrokeThickness="2"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </DataTemplate>
                </gridArea:CanvasItemsControl.ItemTemplate>
              </gridArea:CanvasItemsControl>

              <!-- Hover Tile -->
              <Rectangle Canvas.Left="{x:Bind ViewModel.HoverX, Mode=OneWay}"
                         Canvas.Top="{x:Bind ViewModel.HoverY, Mode=OneWay}"
                         Width="{x:Bind ViewModel.TileSize}"
                         Height="{x:Bind ViewModel.TileSize}"
                         Fill="{StaticResource LightGreyBrush}"
                         Opacity="0.3"
                         Stroke="{StaticResource LightYellowBrush}"
                         StrokeDashArray="2,2"
                         Visibility="{x:Bind ViewModel.IsHovering, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <!-- Area Draw Preview -->
              <Rectangle Canvas.Left="{x:Bind ViewModel.DrawPreview.X, Mode=OneWay}"
                         Canvas.Top="{x:Bind ViewModel.DrawPreview.Y, Mode=OneWay}"
                         Width="{x:Bind ViewModel.DrawPreview.Width, Mode=OneWay}"
                         Height="{x:Bind ViewModel.DrawPreview.Height, Mode=OneWay}"
                         Fill="{StaticResource LightYellowBrush}"
                         Opacity="0.35"
                         Stroke="{StaticResource LightYellowBrush}"
                         StrokeThickness="2"
                         Visibility="{x:Bind ViewModel.IsDrawing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Canvas>
          </Grid>

          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource LightGreyBrush}"
                     Text="This is a folder. Right-click it in the tree to add maps inside it."
                     Visibility="{x:Bind ViewModel.IsFolderSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource LightGreyBrush}"
                     Text="Right-click the map tree to create your first map."
                     Visibility="{x:Bind ViewModel.SelectedMap, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Settings -->
    <Grid Grid.Column="2"
          RowSpacing="10"
          Visibility="{x:Bind ViewModel.SelectedMap, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <enginePanel:EnginePanel Title="Map Settings">
        <StackPanel Spacing="15">
          <TextBox Header="Name"
                   Text="{x:Bind ViewModel.SelectedMap.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   ToolTipService.ToolTip="What is this map called?" />

          <ComboBox Header="Parent"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.ParentOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedParent, Mode=TwoWay}"
                    ToolTipService.ToolTip="Which folder or map this sits under in the map tree." />

          <StackPanel Spacing="15"
                      Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <engineTextBox:EngineTextBox Header="Width"
                                           InputType="Integer"
                                           Text="{x:Bind ViewModel.MapWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Tooltip="How many tiles wide the map is." />
              <engineTextBox:EngineTextBox Grid.Column="1"
                                           Header="Height"
                                           InputType="Integer"
                                           Text="{x:Bind ViewModel.MapHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Tooltip="How many tiles tall the map is." />
              <Button Grid.Column="2"
                      VerticalAlignment="Bottom"
                      Content="Fit"
                      Command="{x:Bind ViewModel.FitToGroundCommand}"
                      ToolTipService.ToolTip="Size the map to its ground image." />
            </Grid>

            <TextBlock Text="Layers" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource LightGreyBrush}"
                       TextWrapping="Wrap"
                       Text="Images load from Graphics\Maps by map id. Everything is drawn lowest Z first, entities included." />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mainPageModels:MapLayerModel">
                  <Border BorderBrush="{StaticResource LightGreyBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="8"
                          ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <StackPanel Spacing="8">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="{x:Bind Name}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource LightGreyBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind ImageText}" />
                        <Button Grid.Column="2"
                                Padding="6,2"
                                Content="Reset"
                                Command="{x:Bind ResetCommand}"
                                ToolTipService.ToolTip="Go back to the default z, opacity and blend." />
                      </Grid>
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Header="Z"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Z, Mode=TwoWay}"
                                   ToolTipService.ToolTip="Draw order. Entities are drawn at their own z." />
                        <NumberBox Grid.Column="1"
                                   Header="Opacity"
                                   Minimum="0"
                                   Maximum="1"
                                   SmallChange="0.1"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Opacity, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2"
                                  Header="Blend"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind BlendOptions}"
                                  SelectedItem="{x:Bind Blend, Mode=TwoWay}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Audio" FontWeight="Bold" />
            <ComboBox Header="Music"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.BgmFiles, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedBgm, Mode=TwoWay}"
                      ToolTipService.ToolTip="Music that plays on this map." />
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <NumberBox Header="Volume"
                         Minimum="0"
                         SmallChange="0.1"
                         SpinButtonPlacementMode="Inline"
                         IsEnabled="{x:Bind ViewModel.SelectedMap.Bgm, Mode=OneWay, Converter={StaticResource NullToFalseConverter}, FallbackValue=False}"
                         Value="{x:Bind ViewModel.SelectedMap.Bgm.Volume, Mode=TwoWay, FallbackValue=1}" />
              <NumberBox Grid.Column="1"
                         Header="Pitch"
                         Minimum="0"
                         SmallChange="0.1"
                         SpinButtonPlacementMode="Inline"
                         IsEnabled="{x:Bind ViewModel.SelectedMap.Bgm, Mode=OneWay, Converter={StaticResource NullToFalseConverter}, FallbackValue=False}"
                         Value="{x:Bind ViewModel.SelectedMap.Bgm.Pitch, Mode=TwoWay, FallbackValue=1}" />
              <Button Grid.Column="2"
                      VerticalAlignment="Bottom"
                      Command="{x:Bind ViewModel.PlayBgmCommand}"
                      ToolTipService.ToolTip="Play Music">
                <SymbolIcon Symbol="Play" />
              </Button>
            </Grid>

            <ComboBox Header="Ambience"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.BgsFiles, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedBgs, Mode=TwoWay}"
                      ToolTipService.ToolTip="Background sound (wind, rain, crowds) that plays on this map." />
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <NumberBox Header="Volume"
                         Minimum="0"
                         SmallChange="0.1"
                         SpinButtonPlacementMode="Inline"
                         IsEnabled="{x:Bind ViewModel.SelectedMap.Bgs, Mode=OneWay, Converter={StaticResource NullToFalseConverter}, FallbackValue=False}"
                         Value="{x:Bind ViewModel.SelectedMap.Bgs.Volume, Mode=TwoWay, FallbackValue=1}" />
              <NumberBox Grid.Column="1"
                         Header="Pitch"
                         Minimum="0"
                         SmallChange="0.1"
                         SpinButtonPlacementMode="Inline"
                         IsEnabled="{x:Bind ViewModel.SelectedMap.Bgs, Mode=OneWay, Converter={StaticResource NullToFalseConverter}, FallbackValue=False}"
                         Value="{x:Bind ViewModel.SelectedMap.Bgs.Pitch, Mode=TwoWay, FallbackValue=1}" />
              <Button Grid.Column="2"
                      VerticalAlignment="Bottom"
                      Command="{x:Bind ViewModel.PlayBgsCommand}"
                      ToolTipService.ToolTip="Play Ambience">
                <SymbolIcon Symbol="Play" />
              </Button>
            </Grid>
            <Button Content="Stop Audio"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.StopAudioCommand}" />

            <TextBlock Text="Options" FontWeight="Bold" />
            <CheckBox IsChecked="{x:Bind ViewModel.SelectedMap.DisableDash, Mode=TwoWay, FallbackValue='False'}"
                      behaviors:PointerCursorBehavior.CursorType="Hand"
                      ToolTipService.ToolTip="Stop the party from running on this map.">
              Disable Dash
            </CheckBox>
            <CheckBox IsChecked="{x:Bind ViewModel.SelectedMap.BattleMap, Mode=TwoWay, FallbackValue='False'}"
                      behaviors:PointerCursorBehavior.CursorType="Hand"
                      ToolTipService.ToolTip="Battles are fought on this map.">
              Battle Map
            </CheckBox>
            <CheckBox IsChecked="{x:Bind ViewModel.SelectedMap.Interior, Mode=TwoWay, FallbackValue='False'}"
                      behaviors:PointerCursorBehavior.CursorType="Hand"
                      ToolTipService.ToolTip="Weather effects do not show up on this map.">
              Interior
            </CheckBox>

            <TextBlock Text="Connections" FontWeight="Bold" />
            <Grid ColumnSpacing="10" RowSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ComboBox Header="North"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ConnectionOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.NorthMap, Mode=TwoWay}"
                        ToolTipService.ToolTip="Walking off the top of the map goes to this map." />
              <ComboBox Grid.Column="1"
                        Header="South"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ConnectionOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SouthMap, Mode=TwoWay}"
                        ToolTipService.ToolTip="Walking off the bottom of the map goes to this map." />
              <ComboBox Grid.Row="1"
                        Header="West"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ConnectionOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.WestMap, Mode=TwoWay}"
                        ToolTipService.ToolTip="Walking off the left of the map goes to this map." />
              <ComboBox Grid.Row="1"
                        Grid.Column="1"
                        Header="East"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ConnectionOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.EastMap, Mode=TwoWay}"
                        ToolTipService.ToolTip="Walking off the right of the map goes to this map." />
            </Grid>
          </StackPanel>
        </StackPanel>
      </enginePanel:EnginePanel>

      <!-- Selection -->
      <Border Grid.Row="1"
              BorderBrush="White"
              BorderThickness="2"
              CornerRadius="8"
              Padding="10"
              Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Spacing="15">
          <TextBlock Text="Selection"
                     FontFamily="{StaticResource TitleFont}"
                     FontSize="{StaticResource TitleFontSize}"
                     FontWeight="Bold" />

          <TextBlock Foreground="{StaticResource LightGreyBrush}"
                     TextWrapping="Wrap"
                     Text="Click an entity or area on the map to select it."
                     Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

          <!-- Entity -->
          <StackPanel Spacing="15"
                      Visibility="{x:Bind ViewModel.SelectedEntity, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBox Header="Entity Name"
                     Text="{x:Bind ViewModel.EntityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Bottom"
                         Margin="0,0,0,6"
                         Foreground="{StaticResource LightGreyBrush}">
                <Run Text="Tile" />
                <Run Text="{x:Bind ViewModel.SelectedEntity.PositionText, Mode=OneWay, FallbackValue=''}" />
              </TextBlock>
              <NumberBox Grid.Column="1"
                         Header="Z"
                         SmallChange="1"
                         SpinButtonPlacementMode="Compact"
                         Value="{x:Bind ViewModel.EntityZ, Mode=TwoWay}"
                         ToolTipService.ToolTip="Draw order against the map layers and other entities. Each layer shows its own z above." />
            </Grid>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Content="Edit"
                      HorizontalAlignment="Stretch"
                      Command="{x:Bind ViewModel.EditEntityCommand}" />
              <Button Grid.Column="1"
                      Content="Delete"
                      HorizontalAlignment="Stretch"
                      Command="{x:Bind ViewModel.DeleteSelectionCommand}" />
            </Grid>
          </StackPanel>

          <!-- Area -->
          <StackPanel Spacing="15"
                      Visibility="{x:Bind ViewModel.SelectedArea, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Header="Area Name"
                       Text="{x:Bind ViewModel.SelectedArea.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
              <ComboBox Grid.Column="1"
                        Header="Type"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.AreaTypes}"
                        SelectedItem="{x:Bind ViewModel.SelectedArea.AreaType, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <engineTextBox:EngineTextBox Header="X"
                                           InputType="Integer"
                                           Text="{x:Bind ViewModel.SelectedArea.TileX, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
              <engineTextBox:EngineTextBox Grid.Column="1"
                                           Header="Y"
                                           InputType="Integer"
                                           Text="{x:Bind ViewModel.SelectedArea.TileY, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}" />
              <engineTextBox:EngineTextBox Grid.Column="2"
                                           Header="W"
                                           InputType="Integer"
                                           Text="{x:Bind ViewModel.SelectedArea.TileWidth, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}" />
              <engineTextBox:EngineTextBox Grid.Column="3"
                                           Header="H"
                                           InputType="Integer"
                                           Text="{x:Bind ViewModel.SelectedArea.TileHeight, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <ComboBox Header="Footstep Sound"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.FootstepFiles, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFootstep, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.SelectedArea.IsFootstep, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
            <Button Content="Delete"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.DeleteSelectionCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
