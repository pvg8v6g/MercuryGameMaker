<Page x:Class="GameMaker.UX.Views.MainPage.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mainPage="using:GameMaker.UX.ViewModels.MainPage"
      xmlns:mainPageModels="using:GameMaker.UX.Models.MainPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:gridArea="using:GameMaker.UX.Components.GridArea"
      xmlns:mercury="using:MercuryLibrary.CanvasComponents"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance mainPage:MainPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Map Tree -->
    <enginePanel:EnginePanel x:Name="MapsPanel" Title="Maps">
      <TreeView SelectionMode="Single"
                CanDragItems="False"
                AllowDrop="False"
                MinHeight="200"
                Height="{x:Bind MapsPanel.ScrollerViewportHeight, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.MapTree}"
                behaviors:TreeViewBehaviors.SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                behaviors:TreeViewBehaviors.SelectOnRightClick="True"
                ToolTipService.ToolTip="Right-click to add maps and folders. Change a map's parent in its settings to move it.">
        <TreeView.ItemTemplate>
          <DataTemplate x:DataType="mainPageModels:MapTreeNode">
            <TreeViewItem ItemsSource="{x:Bind Children}"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="{x:Bind Symbol}" />
                <TextBlock TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center">
                  <Run Foreground="{StaticResource LightGreyBrush}"
                       Text="{x:Bind IdText}" />
                  <Run Text="{x:Bind Map.Name, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </TreeViewItem>
          </DataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="New Map" Command="{x:Bind ViewModel.NewMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Map" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="New Folder" Command="{x:Bind ViewModel.NewFolderCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Folder" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Edit" Command="{x:Bind ViewModel.EditMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Edit" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopyMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Copy" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Paste"
                            Command="{x:Bind ViewModel.PasteMapCommand}"
                            IsEnabled="{x:Bind ViewModel.CopiedMap, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Paste" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteMapCommand}">
              <MenuFlyoutItem.Icon>
                <SymbolIcon Symbol="Delete" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
          </MenuFlyout>
        </TreeView.ContextFlyout>
      </TreeView>
    </enginePanel:EnginePanel>

    <!-- Map Editor -->
    <Grid Grid.Column="1" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="20"
            Visibility="{x:Bind ViewModel.IsMapSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="15">
          <RadioButton Content="Entities"
                       GroupName="MapEditMode"
                       MinWidth="0"
                       behaviors:PointerCursorBehavior.CursorType="Hand"
                       IsChecked="{x:Bind ViewModel.IsEntityMode, Mode=TwoWay}"
                       ToolTipService.ToolTip="Double-click a tile to add an entity, double-click an entity to edit it, drag to move it." />
          <RadioButton Content="Areas"
                       GroupName="MapEditMode"
                       MinWidth="0"
                       behaviors:PointerCursorBehavior.CursorType="Hand"
                       IsChecked="{x:Bind ViewModel.IsAreaMode, Mode=TwoWay}"
                       ToolTipService.ToolTip="Click or drag on empty tiles to draw an area, drag an area to move it." />
          <ComboBox MinWidth="140"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.AreaTypes}"
                    SelectedItem="{x:Bind ViewModel.NewAreaType, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsAreaMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTipService.ToolTip="The type of area to draw." />
          <ComboBox MinWidth="90"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.AreaGridSizes}"
                    SelectedItem="{x:Bind ViewModel.AreaGridSize, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsAreaMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTipService.ToolTip="Area grid in pixels: what areas snap to while drawing and moving. 48 is a tile, smaller makes finer collisions." />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
          <Button Padding="8,4"
                  VerticalAlignment="Center"
                  behaviors:PointerCursorBehavior.CursorType="Hand"
                  Command="{x:Bind ViewModel.LayersCommand}"
                  ToolTipService.ToolTip="Layers: z, opacity and blend of the map images, and which environments are on.">
            <FontIcon Glyph="&#xE81E;" FontSize="16" />
          </Button>
          <SplitButton Padding="8,4"
                       VerticalAlignment="Center"
                       behaviors:PointerCursorBehavior.CursorType="Hand"
                       Command="{x:Bind ViewModel.TestMapCommand}"
                       ToolTipService.ToolTip="Test: saves, then plays this map from its test spawn (right-click the map to set one). The arrow picks full screen or a window, and what the test draws over the game.">
            <SymbolIcon Symbol="Play" />
            <SplitButton.Flyout>
              <MenuFlyout Placement="Bottom">
                <ToggleMenuFlyoutItem Text="Windowed"
                                      IsChecked="{x:Bind ViewModel.TestWindowed, Mode=TwoWay}" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Show Hitboxes"
                                      IsChecked="{x:Bind ViewModel.TestShowHitboxes, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Show Areas"
                                      IsChecked="{x:Bind ViewModel.TestShowAreas, Mode=TwoWay}" />
                <ToggleMenuFlyoutItem Text="Show Collisions"
                                      IsChecked="{x:Bind ViewModel.TestShowCollisions, Mode=TwoWay}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <CheckBox Content="Grid"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}" />
          <CheckBox Content="Areas"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowAreas, Mode=TwoWay}" />
          <CheckBox Content="Parallax"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowParallax, Mode=TwoWay}" />
          <CheckBox Content="Light"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowLight, Mode=TwoWay}" />
          <CheckBox Content="Environment"
                    MinWidth="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    IsChecked="{x:Bind ViewModel.ShowEnvironments, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource LightGreyBrush}"
                   Text="{x:Bind ViewModel.CursorText, Mode=OneWay}"
                   ToolTipService.ToolTip="Scroll to pan, shift-scroll to pan sideways, middle-drag to pan freely." />
      </Grid>

      <Border Grid.Row="1"
              BorderBrush="White"
              BorderThickness="2"
              CornerRadius="8"
              Padding="2">
        <Grid>
          <!-- never collapsed: the canvas stops drawing when it starts out hidden, it just draws nothing while no map is selected -->
          <!-- the shortcuts are kept out of the tooltip, WinUI otherwise pops up "Delete" (the first one) while hovering the map -->
          <Grid IsHitTestVisible="{x:Bind ViewModel.IsMapSelected, Mode=OneWay}"
                KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.Clip>
              <RectangleGeometry Rect="{x:Bind ViewModel.ViewportRect, Mode=OneWay}" />
            </Grid.Clip>
            <Grid.KeyboardAccelerators>
              <KeyboardAccelerator Key="Delete"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.DeleteSelectionCommand}" />
              <KeyboardAccelerator Key="Escape"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.ClearSelectionCommand}" />
              <KeyboardAccelerator Key="Enter"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.EditSelectionCommand}" />
              <KeyboardAccelerator Key="C"
                                   Modifiers="Control"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.CopySelectionCommand}" />
              <KeyboardAccelerator Key="V"
                                   Modifiers="Control"
                                   ScopeOwner="{x:Bind MapCanvas}"
                                   behaviors:KeyboardAcceleratorBehavior.Command="{x:Bind ViewModel.PasteSelectionCommand}" />
            </Grid.KeyboardAccelerators>

            <!-- the game's renderer: ground, entities, parallax and light with their blend modes -->
            <!-- 96 draws every image at its pixel size, art saved at 72 dpi would otherwise be drawn 1.33x too big -->
            <mercury:GameCanvasView x:Name="MapCanvas"
                                    ImageDpi="96"
                                    UpdateRate="16.66666667"
                                    ClearColor="{StaticResource DarkGreyColor}"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="False"
                                    Sprites="{x:Bind ViewModel.Sprites}"
                                    behaviors:PointerCursorBehavior.CursorType="Hand"
                                    behaviors:SizeChangedBehavior.SizeChangedCommand="{x:Bind ViewModel.CanvasSizeChangedCommand}"
                                    behaviors:PointerCommandBehavior.CapturePointerOnPressed="True"
                                    behaviors:PointerCommandBehavior.FocusOnPressed="True"
                                    behaviors:PointerCommandBehavior.PointerPressedCommand="{x:Bind ViewModel.CanvasPressedCommand}"
                                    behaviors:PointerCommandBehavior.PointerMovedCommand="{x:Bind ViewModel.CanvasMovedCommand}"
                                    behaviors:PointerCommandBehavior.PointerReleasedCommand="{x:Bind ViewModel.CanvasReleasedCommand}"
                                    behaviors:PointerCommandBehavior.PointerWheelChangedCommand="{x:Bind ViewModel.CanvasWheelCommand}"
                                    behaviors:PointerCommandBehavior.DoubleTappedCommand="{x:Bind ViewModel.CanvasDoubleTappedCommand}">
              <mercury:GameCanvasView.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="New Entity" Command="{x:Bind ViewModel.NewEntityCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Add" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Edit" Command="{x:Bind ViewModel.EditSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Edit" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopySelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Copy" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Paste" Command="{x:Bind ViewModel.PasteSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Paste" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Set Game Start Here" Command="{x:Bind ViewModel.SetGameStartCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Home" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Set Test Spawn Here" Command="{x:Bind ViewModel.SetTestSpawnCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Play" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Delete" Command="{x:Bind ViewModel.DeleteSelectionCommand}">
                    <MenuFlyoutItem.Icon>
                      <SymbolIcon Symbol="Delete" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </mercury:GameCanvasView.ContextFlyout>
            </mercury:GameCanvasView>

            <!-- editor overlay, drawn in world space and shifted by the camera -->
            <Canvas IsHitTestVisible="False">
              <Canvas.RenderTransform>
                <TranslateTransform X="{x:Bind ViewModel.OverlayX, Mode=OneWay}"
                                    Y="{x:Bind ViewModel.OverlayY, Mode=OneWay}" />
              </Canvas.RenderTransform>

              <!-- Map Bounds -->
              <Rectangle Width="{x:Bind ViewModel.MapPixelWidth, Mode=OneWay}"
                         Height="{x:Bind ViewModel.MapPixelHeight, Mode=OneWay}"
                         Stroke="{StaticResource LightGreyBrush}"
                         StrokeThickness="1" />

              <!-- Grid -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.GridLines}"
                            Visibility="{x:Bind ViewModel.ShowGrid, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="gridArea:GridLine">
                    <Line X1="{x:Bind X1}"
                          Y1="{x:Bind Y1}"
                          X2="{x:Bind X2}"
                          Y2="{x:Bind Y2}"
                          Stroke="{StaticResource BlackBrush}"
                          Opacity="0.35"
                          StrokeThickness="1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Areas -->
              <gridArea:CanvasItemsControl ItemsSource="{x:Bind ViewModel.Areas}"
                                           LeftPropertyName="X"
                                           TopPropertyName="Y"
                                           Visibility="{x:Bind ViewModel.ShowAreas, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <gridArea:CanvasItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </gridArea:CanvasItemsControl.ItemsPanel>
                <gridArea:CanvasItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mainPageModels:MapAreaModel">
                    <Grid Width="{x:Bind Width, Mode=OneWay}"
                          Height="{x:Bind Height, Mode=OneWay}"
                          Background="{x:Bind Fill, Mode=OneWay}">
                      <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                 FontSize="10"
                                 Margin="3,1"
                                 TextTrimming="CharacterEllipsis" />
                      <Rectangle Stroke="{StaticResource LightYellowBrush}"
                                 StrokeThickness="2"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </DataTemplate>
                </gridArea:CanvasItemsControl.ItemTemplate>
              </gridArea:CanvasItemsControl>

              <!-- Entities (the sprite is drawn by the canvas, this is the tile marker) -->
              <gridArea:CanvasItemsControl ItemsSource="{x:Bind ViewModel.Entities}"
                                           LeftPropertyName="X"
                                           TopPropertyName="Y">
                <gridArea:CanvasItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </gridArea:CanvasItemsControl.ItemsPanel>
                <gridArea:CanvasItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mainPageModels:MapEntityModel">
                    <Grid Width="{x:Bind Size}" Height="{x:Bind Size}">
                      <Rectangle Stroke="{StaticResource LightBlueBrush}"
                                 StrokeThickness="1"
                                 StrokeDashArray="2,2"
                                 Opacity="0.6" />
                      <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                 FontSize="10"
                                 Margin="2"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 Visibility="{x:Bind Sprite, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />
                      <Rectangle Stroke="{StaticResource MediumPinkBrush}"
                                 StrokeThickness="2"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </DataTemplate>
                </gridArea:CanvasItemsControl.ItemTemplate>
              </gridArea:CanvasItemsControl>

              <!-- Hover Tile (or area cell) -->
              <Rectangle Canvas.Left="{x:Bind ViewModel.HoverX, Mode=OneWay}"
                         Canvas.Top="{x:Bind ViewModel.HoverY, Mode=OneWay}"
                         Width="{x:Bind ViewModel.SnapSize, Mode=OneWay}"
                         Height="{x:Bind ViewModel.SnapSize, Mode=OneWay}"
                         Fill="{StaticResource LightGreyBrush}"
                         Opacity="0.3"
                         Stroke="{StaticResource LightYellowBrush}"
                         StrokeDashArray="2,2"
                         Visibility="{x:Bind ViewModel.IsHovering, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <!-- Game Start: where a new game begins -->
              <Border Canvas.Left="{x:Bind ViewModel.GameStartX, Mode=OneWay}"
                      Canvas.Top="{x:Bind ViewModel.GameStartY, Mode=OneWay}"
                      Width="{x:Bind ViewModel.TileSize}"
                      Height="{x:Bind ViewModel.TileSize}"
                      BorderBrush="{StaticResource LightYellowBrush}"
                      BorderThickness="2"
                      Visibility="{x:Bind ViewModel.IsGameStartShown, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <SymbolIcon Symbol="Home" Foreground="{StaticResource LightYellowBrush}" />
              </Border>

              <!-- Test Spawn: where the Test button puts the player -->
              <Border Canvas.Left="{x:Bind ViewModel.TestSpawnX, Mode=OneWay}"
                      Canvas.Top="{x:Bind ViewModel.TestSpawnY, Mode=OneWay}"
                      Width="{x:Bind ViewModel.TileSize}"
                      Height="{x:Bind ViewModel.TileSize}"
                      BorderBrush="{StaticResource LightBlueBrush}"
                      BorderThickness="2"
                      Visibility="{x:Bind ViewModel.IsTestSpawnShown, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <SymbolIcon Symbol="Play" Foreground="{StaticResource LightBlueBrush}" />
              </Border>

              <!-- Area Draw Preview -->
              <Rectangle Canvas.Left="{x:Bind ViewModel.DrawPreview.X, Mode=OneWay}"
                         Canvas.Top="{x:Bind ViewModel.DrawPreview.Y, Mode=OneWay}"
                         Width="{x:Bind ViewModel.DrawPreview.Width, Mode=OneWay}"
                         Height="{x:Bind ViewModel.DrawPreview.Height, Mode=OneWay}"
                         Fill="{StaticResource LightYellowBrush}"
                         Opacity="0.35"
                         Stroke="{StaticResource LightYellowBrush}"
                         StrokeThickness="2"
                         Visibility="{x:Bind ViewModel.IsDrawing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Canvas>
          </Grid>

          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource LightGreyBrush}"
                     Text="This is a folder. Right-click it in the tree to add maps inside it."
                     Visibility="{x:Bind ViewModel.IsFolderSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource LightGreyBrush}"
                     Text="Right-click the map tree to create your first map."
                     Visibility="{x:Bind ViewModel.SelectedMap, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
