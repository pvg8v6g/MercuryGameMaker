<Page x:Class="GameMaker.UX.Views.BalloonIconsPage.BalloonIconsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:balloonIconsPage="using:GameMaker.UX.ViewModels.BalloonIconsPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:balloonIconView="using:GameMaker.UX.Components.BalloonIconView"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance balloonIconsPage:BalloonIconsPageViewModel}"
      behaviors:LoadedBehavior.LoadedCommand="{x:Bind ViewModel.LoadedCommand}">
  <Grid ColumnSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.GameDataService.BalloonIcons}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Balloon"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="Balloon Details"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Orientation="Vertical" Spacing="30">
        <StackPanel Orientation="Horizontal" Spacing="40">
          <TextBox Header="Name"
                   Width="220"
                   Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   VerticalAlignment="Bottom" />

          <!-- the picker lists the first frame of every row, the preview plays the picked row -->
          <StackPanel VerticalAlignment="Bottom" Spacing="5">
            <TextBlock HorizontalAlignment="Center">Icon</TextBlock>
            <balloonIconView:BalloonIconView Row="{x:Bind ViewModel.SelectedEntity.Icon, Mode=TwoWay, FallbackValue=0}"
                                             FrameTime="{x:Bind ViewModel.SelectedEntity.FrameTime, Mode=OneWay, FallbackValue=100}"
                                             HoldTime="{x:Bind ViewModel.SelectedEntity.HoldTime, Mode=OneWay, FallbackValue=400}"
                                             HorizontalAlignment="Center"
                                             ToolTipService.ToolTip="Click to pick the balloon's row on the balloon sheet. It plays here the way it plays in the game." />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="20">
          <NumberBox Header="Frame Time (ms)"
                     Width="160"
                     Minimum="1"
                     SmallChange="10"
                     SpinButtonPlacementMode="Inline"
                     Value="{x:Bind ViewModel.SelectedEntity.FrameTime, Mode=TwoWay, FallbackValue=100}"
                     ToolTipService.ToolTip="How long each frame of the row is shown" />
          <NumberBox Header="Hold Last Frame (ms)"
                     Width="180"
                     Minimum="0"
                     SmallChange="50"
                     SpinButtonPlacementMode="Inline"
                     Value="{x:Bind ViewModel.SelectedEntity.HoldTime, Mode=TwoWay, FallbackValue=400}"
                     ToolTipService.ToolTip="How long the last frame stays up before the balloon goes away" />
        </StackPanel>

        <TextBlock MaxWidth="420"
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   Visibility="{x:Bind ViewModel.SheetMissing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Run Text="No balloon sheet yet. It goes here, one balloon per row with its frames left to right, every cell 48 by 48:" />
          <LineBreak />
          <Run Text="{x:Bind ViewModel.SheetPath}" />
        </TextBlock>
      </StackPanel>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
