<Page x:Class="GameMaker.UX.Views.ActorsPage.ActorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:actorsPage="using:GameMaker.UX.ViewModels.ActorsPage"
      xmlns:behaviors="using:GameLibrary.Behaviors"
      xmlns:enginePanel="using:GameMaker.UX.Components.EnginePanel"
      xmlns:engineListView="using:GameMaker.UX.Components.EngineListView"
      xmlns:imageChooser="using:GameMaker.UX.Components.ImageChooser"
      xmlns:engineIcon="using:GameMaker.UX.Components.EngineIcon"
      xmlns:disciplines="using:GameLibrary.Models.Disciplines"
      xmlns:engineTextBox="using:GameMaker.UX.Components.EngineTextBox"
      xmlns:actorsPage1="using:GameMaker.UX.Models.ActorsPage"
      xmlns:areas="using:GameLibrary.Models.Areas"
      xmlns:conv="using:GameLibrary.Converters"
      xmlns:gridArea="using:GameMaker.UX.Components.GridArea"
      xmlns:spriteImage="using:GameMaker.UX.Components.SpriteImage"
      xmlns:markup="using:GameLibrary.MarkupExtensions"
      xmlns:enums="using:GameLibrary.Enumerations"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance actorsPage:ActorsPageViewModel}">
  <Page.Resources>
    <ResourceDictionary>
      <conv:HitboxScaleConverter x:Key="HitboxScaleConverter" />
      <conv:ScaleConverter x:Key="ScaleConverter" />
    </ResourceDictionary>
  </Page.Resources>
  <Grid x:Name="RootPageGrid" ColumnSpacing="10" Padding="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <engineListView:EngineListView ItemsSource="{x:Bind ViewModel.GameDataService.Actors}"
                                   SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                   NewCommand="{x:Bind ViewModel.NewEntityCommand}"
                                   NewCommandParameter="New Actor"
                                   CopyCommand="{x:Bind ViewModel.CopyEntityCommand}"
                                   PasteCommand="{x:Bind ViewModel.PasteEntityCommand}"
                                   DeleteCommand="{x:Bind ViewModel.DeleteEntityCommand}"
                                   CopiedModel="{x:Bind ViewModel.CopiedModel, Mode=OneWay}" />
    <enginePanel:EnginePanel Grid.Column="1"
                             Title="Fighter Metadata"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <StackPanel Orientation="Vertical"
                  Spacing="20">
        <StackPanel Spacing="20" Orientation="Horizontal">
          <StackPanel Spacing="5" VerticalAlignment="Bottom">
            <TextBlock Text="Face Image" />
            <imageChooser:ImageChooser FolderPath="{x:Bind ViewModel.FaceFolderPath, Mode=OneWay}"
                                       FileName="{x:Bind ViewModel.SelectedEntity.FaceName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                                       Index="{x:Bind ViewModel.SelectedEntity.FaceIndex, Mode=TwoWay, FallbackValue='0', UpdateSourceTrigger=PropertyChanged}"
                                       ChooserWidth="148"
                                       ChooserHeight="148" />
          </StackPanel>

          <StackPanel Spacing="5" VerticalAlignment="Bottom">
            <TextBlock Text="Character Image" />
            <imageChooser:ImageChooser x:Name="CharacterImageChooser"
                                       FolderPath="{x:Bind ViewModel.CharacterFolderPath, Mode=OneWay}"
                                       FileName="{x:Bind ViewModel.SelectedEntity.CharacterName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                                       Index="{x:Bind ViewModel.CharacterIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       ChooserWidth="148"
                                       ChooserHeight="148" />
          </StackPanel>

          <StackPanel Spacing="5" VerticalAlignment="Bottom">
            <TextBlock Text="Character Hitboxes" />
            <ComboBox ItemsSource="{markup:EnumValues EnumType=enums:Direction}"
                      SelectedItem="{x:Bind ViewModel.SelectedDirection, Mode=TwoWay}"
                      MinWidth="148" />
            <Button x:Name="RootButton"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    Tapped="OnTapped">
              <FlyoutBase.AttachedFlyout>
                <Flyout Placement="Full">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                MaxWidth="{x:Bind ViewModel.GameDataService.ScreenWidth, Converter={StaticResource ScaleConverter}, ConverterParameter=80, Mode=OneWay}"
                                MaxHeight="{x:Bind ViewModel.GameDataService.ScreenHeight, Converter={StaticResource ScaleConverter}, ConverterParameter=80, Mode=OneWay}">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Character Hitboxes"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <gridArea:AreaCreatorView Hitboxes="{x:Bind ViewModel.EditingHitboxes, Mode=OneWay}"
                                                CharacterImage="{x:Bind CharacterImageChooser.CroppedImage, Mode=OneWay}" />
                    </StackPanel>
                  </ScrollViewer>
                </Flyout>
              </FlyoutBase.AttachedFlyout>
              <Grid Width="148" Height="148">
                <spriteImage:SpriteImage CharacterImage="{x:Bind CharacterImageChooser.CroppedImage, Mode=OneWay}" />
                <Canvas IsHitTestVisible="False">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewHitboxes, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="areas:Hitbox">
                        <Rectangle Fill="Red" Opacity="0.5" Stroke="White" StrokeThickness="1"
                                   Width="{x:Bind Width, Converter={StaticResource HitboxScaleConverter}}"
                                   Height="{x:Bind Height, Converter={StaticResource HitboxScaleConverter}}">
                          <Rectangle.RenderTransform>
                            <TranslateTransform
                              X="{x:Bind X, Converter={StaticResource HitboxScaleConverter}}"
                              Y="{x:Bind Y, Converter={StaticResource HitboxScaleConverter}}" />
                          </Rectangle.RenderTransform>
                        </Rectangle>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Canvas>
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
        <Grid ColumnSpacing="40"
              RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0"
                   Grid.Row="0"
                   Header="Name"
                   Text="{x:Bind ViewModel.SelectedEntity.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   ToolTipService.ToolTip="What is the actor's name? This can be changed in game."
                   VerticalAlignment="Bottom" />

          <ComboBox Grid.Column="1"
                    Grid.Row="0"
                    PlaceholderText="Discipline"
                    ItemsSource="{x:Bind ViewModel.GameDataService.Disciplines, Mode=OneWay}"
                    SelectedValue="{x:Bind ViewModel.SelectedEntity.DisciplineGuid, Mode=TwoWay, FallbackValue={x:Null}}"
                    SelectedValuePath="Guid"
                    MinHeight="48"
                    ToolTipService.ToolTip="What is the actor's discipline? This can be changed in game."
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="disciplines:Discipline">
                <StackPanel behaviors:PointerCursorBehavior.CursorType="Hand" Orientation="Horizontal" Spacing="10" MinHeight="36">
                  <engineIcon:EngineIcon IconIndex="{x:Bind Icon, Mode=OneWay}"
                                         VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <engineTextBox:EngineTextBox Grid.Column="0"
                                       Grid.Row="1"
                                       Header="Level"
                                       InputType="Integer"
                                       Text="{x:Bind ViewModel.SelectedEntity.Level, Mode=TwoWay, FallbackValue='1', UpdateSourceTrigger=PropertyChanged}"
                                       Tooltip="What is this actor's starting level?" />

          <!-- TODO - Add AutoAnimation when able. -->

          <TextBox Grid.Column="0"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Header="Description"
                   Text="{x:Bind ViewModel.SelectedEntity.Description, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="100"
                   ToolTipService.ToolTip="Tell me a little bit about this actor."
                   VerticalAlignment="Top" />

          <CheckBox Grid.Column="0"
                    Grid.Row="3"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.Medic, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Medic healing items heal for twice the amount."
                    VerticalAlignment="Bottom">
            Medic
          </CheckBox>

          <CheckBox Grid.Column="0"
                    Grid.Row="4"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.LockEquipment, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Is the player allowed to change this actor's starting equipment?"
                    VerticalAlignment="Bottom">
            Locked Equipment
          </CheckBox>

          <CheckBox Grid.Column="0"
                    Grid.Row="5"
                    IsChecked="{x:Bind ViewModel.SelectedEntity.LockEquipment, Mode=TwoWay, FallbackValue='False', UpdateSourceTrigger=PropertyChanged}"
                    behaviors:PointerCursorBehavior.CursorType="Hand"
                    ToolTipService.ToolTip="Is this actor an &quot;undead&quot; type?"
                    VerticalAlignment="Bottom">
            Undead
          </CheckBox>
        </Grid>
      </StackPanel>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="2"
                             Title="Fighter Equipment"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>
        <ItemsControl Grid.Column="0" VerticalAlignment="Top" ItemsSource="{x:Bind ViewModel.FighterEquipmentSlots, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="15" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="actorsPage1:EquipmentSlotModel">
              <ComboBox Header="{x:Bind SlotName}"
                        PlaceholderText="{x:Bind SlotName}"
                        ItemsSource="{x:Bind Options, Mode=OneWay}"
                        SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                        MinHeight="76"
                        ToolTipService.ToolTip="{x:Bind ToolTipText}"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="actorsPage1:EquipmentOption">
                    <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="36">
                      <engineIcon:EngineIcon IconIndex="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                      <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </enginePanel:EnginePanel>
    <enginePanel:EnginePanel Grid.Column="3"
                             Grid.Row="0"
                             Title="Element Resistance"
                             Visibility="{x:Bind ViewModel.SelectedEntity, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
      <ItemsControl ItemsSource="{x:Bind ViewModel.ElementResistanceStats, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="15" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="actorsPage1:ActorElementModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <engineIcon:EngineIcon Grid.Column="0"
                                     IconIndex="{x:Bind Icon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Name}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />

              <StackPanel Grid.Column="2"
                          Orientation="Horizontal">
                <engineTextBox:EngineTextBox InputType="Integer"
                                             Text="{x:Bind ElementValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tooltip="The percentage of damage this element does to this actor. Negative values heal."
                                             VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center">%</TextBlock>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </enginePanel:EnginePanel>
  </Grid>
</Page>
