<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>GameMaker</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x86;x64;arm64</Platforms>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <PlatformTarget>x64</PlatformTarget>
        <UseWinUI>true</UseWinUI>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsSdkPackageVersion>10.0.26100.38</WindowsSdkPackageVersion>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <ApplicationIcon>Graphics\ico\app.ico</ApplicationIcon>
        <!-- our own Program.Main (AppMain\Program.cs) runs PriPathGuard before WinUI starts -->
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <!-- picks our Main even if an IDE build drops the define above (otherwise: CS0017 more than one entry point) -->
        <StartupObject>GameMaker.AppMain.Program</StartupObject>
        <EnableDefaultPageItems>false</EnableDefaultPageItems>
        <EnableDefaultApplicationDefinitionItems>false</EnableDefaultApplicationDefinitionItems>
        <!-- keeps the output path short: the Windows App SDK resource loader (MRM, GetDefaultPriFile) overruns its
             buffer when the .pri path is longer than about 128 characters and the app crashes at random on start -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc4.5"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2"/>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001"/>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742"/>
        <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="2.0.9"/>
        <PackageReference Include="MercuryLibrary" Version="1.0.20"/>
        <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameLibrary\GameLibrary.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <ApplicationDefinition Include="AppMain\App.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>WinUI</XamlRuntime>
            <SubType>Designer</SubType>
        </ApplicationDefinition>
        <Page Include="UX\Views\**\*.xaml"/>
        <Page Include="UX\Resources\**\*.xaml"/>
        <Page Include="UX\Components\**\*.xaml"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Graphics\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- the Test button runs the game engine, so it is built and copied next to the editor in Engine\ -->
    <!-- no Properties on the MSBuild call: it shares the editor's global properties, so a solution build builds the engine once -->
    <Target Name="BundleGameEngine" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
        <MSBuild Projects="..\GameEngine\GameEngine.csproj" Targets="Build">
            <Output TaskParameter="TargetOutputs" ItemName="GameEngineOutput"/>
        </MSBuild>
        <PropertyGroup>
            <GameEngineDirectory>@(GameEngineOutput->'%(RootDir)%(Directory)')</GameEngineDirectory>
        </PropertyGroup>
        <ItemGroup>
            <GameEngineFiles Include="$(GameEngineDirectory)**\*"/>
        </ItemGroup>
        <Copy SourceFiles="@(GameEngineFiles)"
              DestinationFiles="@(GameEngineFiles->'$(OutDir)Engine\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
    </Target>

    <!-- the .pri path must stay short (see PriPathGuard in GameLibrary): when this project sits so deep that its output
         would be too long, the build goes to %LOCALAPPDATA%\MercuryGameMaker\bin instead -->
    <PropertyGroup>
        <MaxPriPathLength>120</MaxPriPathLength>
        <DefaultPriPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\Engine\GameEngine.pri</DefaultPriPath>
    </PropertyGroup>
    <PropertyGroup Condition="$(DefaultPriPath.Length) &gt; $(MaxPriPathLength)">
        <OutputPath>$(LOCALAPPDATA)\MercuryGameMaker\bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
        <ShortenedOutput>true</ShortenedOutput>
    </PropertyGroup>
    <Target Name="CheckPriPathLength" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <FinalPriPath>$([System.IO.Path]::GetFullPath('$(OutDir)Engine\GameEngine.pri'))</FinalPriPath>
        </PropertyGroup>
        <Warning Condition="'$(ShortenedOutput)' == 'true'" Text="$(MSBuildProjectName): the project folder is too deep for the Windows App SDK (.pri path would be $(DefaultPriPath.Length) characters), so it builds to $(OutDir) instead."/>
        <Error Condition="$(FinalPriPath.Length) &gt; $(MaxPriPathLength)" Text="$(MSBuildProjectName): $(FinalPriPath) is $(FinalPriPath.Length) characters, the limit is $(MaxPriPathLength). The Windows App SDK crashes at random on start with paths this long. Move the project to a shorter folder."/>
    </Target>

</Project>
