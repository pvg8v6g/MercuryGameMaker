<ContentDialog x:Class="GameMaker.UX.Views.Popups.ConditionEditor.ConditionEditorPopup"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:conditionEditor="using:GameMaker.UX.Views.Popups.ConditionEditor"
               xmlns:conditions="using:GameLibrary.Models.Conditions"
               xmlns:fighter="using:GameLibrary.Models.Fighter"
               xmlns:items="using:GameLibrary.Models.Items"
               x:Name="Root"
               mc:Ignorable="d"
               Title="Edit Condition"
               Background="{StaticResource PrimaryBrush}"
               PrimaryButtonText="Done"
               SecondaryButtonText="Cancel"
               DefaultButton="Primary">
  <ContentDialog.Resources>
    <DataTemplate x:Key="SelfSwitchTemplate" x:DataType="conditions:SelfSwitchCondition">
      <StackPanel Spacing="10">
        <ComboBox Header="Self Switch"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ElementName=Root, Path=ViewModel.SelfSwitches}"
                  SelectedItem="{x:Bind SelfSwitch, Mode=TwoWay}" />
        <CheckBox Content="Is On" IsChecked="{x:Bind Value, Mode=TwoWay}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SwitchTemplate" x:DataType="conditions:SwitchCondition">
      <StackPanel Spacing="10">
        <TextBox Header="Switch Name"
                 Text="{x:Bind SwitchName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="Is On" IsChecked="{x:Bind Value, Mode=TwoWay}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="VariableTemplate" x:DataType="conditions:VariableCondition">
      <StackPanel Spacing="10">
        <TextBox Header="Variable Name"
                 Text="{x:Bind VariableName, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Equals Value"
                 Text="{x:Bind Value, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ItemTemplate" x:DataType="conditions:ItemCondition">
      <StackPanel Spacing="10">
        <ComboBox Header="Owns Item"
                  PlaceholderText="None"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ElementName=Root, Path=ViewModel.Consumables}"
                  SelectedValue="{x:Bind OwnItem, Mode=TwoWay, FallbackValue={x:Null}}"
                  SelectedValuePath="Guid">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="items:Consumable">
              <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Header="Does Not Own Item"
                  PlaceholderText="None"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ElementName=Root, Path=ViewModel.Consumables}"
                  SelectedValue="{x:Bind DoNotOwnItem, Mode=TwoWay, FallbackValue={x:Null}}"
                  SelectedValuePath="Guid">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="items:Consumable">
              <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ActorTemplate" x:DataType="conditions:ActorCondition">
      <StackPanel Spacing="10">
        <ComboBox Header="Actor In Party"
                  PlaceholderText="None"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ElementName=Root, Path=ViewModel.Actors}"
                  SelectedValue="{x:Bind OwnActor, Mode=TwoWay, FallbackValue={x:Null}}"
                  SelectedValuePath="Guid">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="fighter:Fighter">
              <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Header="Actor Not In Party"
                  PlaceholderText="None"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding ElementName=Root, Path=ViewModel.Actors}"
                  SelectedValue="{x:Bind DoNotOwnActor, Mode=TwoWay, FallbackValue={x:Null}}"
                  SelectedValuePath="Guid">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="fighter:Fighter">
              <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="EmptyTemplate">
      <TextBlock Text="This condition has no options to configure." TextWrapping="Wrap" />
    </DataTemplate>

    <conditionEditor:ConditionEditorTemplateSelector x:Key="ConditionEditorTemplateSelector"
                                                     SelfSwitch="{StaticResource SelfSwitchTemplate}"
                                                     Switch="{StaticResource SwitchTemplate}"
                                                     Variable="{StaticResource VariableTemplate}"
                                                     Item="{StaticResource ItemTemplate}"
                                                     Actor="{StaticResource ActorTemplate}"
                                                     Empty="{StaticResource EmptyTemplate}" />
  </ContentDialog.Resources>

  <Grid Width="420"
        MinHeight="160">
    <ContentControl HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    Content="{x:Bind ViewModel.Condition, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource ConditionEditorTemplateSelector}" />
  </Grid>
</ContentDialog>
