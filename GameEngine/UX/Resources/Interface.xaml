<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- the game's interface look, shared by every screen layer (the battle HUD, the menus) so they all feel like one
       interface. Change a colour here and every screen follows -->

  <!-- panels: a dark, slightly see-through box with a warm gold edge -->
  <SolidColorBrush x:Key="InterfacePanelBrush" Color="#D9141820" />
  <SolidColorBrush x:Key="InterfacePanelEdgeBrush" Color="#FFB8975A" />
  <SolidColorBrush x:Key="InterfaceHighlightEdgeBrush" Color="#FFF2D58A" />

  <!-- text -->
  <SolidColorBrush x:Key="InterfaceTextBrush" Color="#FFF3EEE2" />
  <SolidColorBrush x:Key="InterfaceSubtleTextBrush" Color="#FFB9B2A3" />

  <!-- bars: Life, Mana, a boss's Life, and the empty part behind them -->
  <SolidColorBrush x:Key="InterfaceLifeBrush" Color="#FF5FC46A" />
  <SolidColorBrush x:Key="InterfaceManaBrush" Color="#FF4C8BE0" />
  <SolidColorBrush x:Key="InterfaceBossLifeBrush" Color="#FFD2443A" />
  <SolidColorBrush x:Key="InterfaceBarBackBrush" Color="#FF2A2E36" />

  <Style x:Key="InterfacePanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource InterfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InterfacePanelEdgeBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style x:Key="InterfaceNameStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InterfaceTextBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="InterfaceSmallTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InterfaceSubtleTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</ResourceDictionary>
